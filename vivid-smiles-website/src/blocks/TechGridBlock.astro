---
/**
 * TechGridBlock — the `tech_grid` layout: the numbered technology cards, with
 * the optional Digital Smile Design panel closing the same band.
 *
 * Extracted from two live bands, not designed anew:
 *
 *   src/pages/implant-dentistry/index.astro:420-441   `#technology`, charcoal
 *       (`class="section alt"`), six cards, NO panel, plain `.eyebrow`.
 *   src/pages/cosmetic-dentistry/index.astro:322-368  `#technology`, sage-pale
 *       (`class="section dark"`), six cards, `.dsd` panel, `.eyebrow.light`.
 *
 * The two markups are the same shape to the character apart from the panel and
 * the eyebrow modifier, which is why one layout absorbs both. What they do NOT
 * agree on is their card SKIN, and that is the whole reason this file is longer
 * than the markup it draws — see the <style> header.
 *
 * ── The numerals are position, never storage ─────────────────────────────
 * `01`–`06` are derived here from the row's index with padStart(2, "0") and
 * are not a field. This is block_list_field()'s marker rule
 * (vs-content-model.php) and it is not fussiness: a stored numeral is a numeral
 * an editor has to renumber by hand after every drag, and the first miss reads
 * 01, 02, 02 with nothing in the build log. The index used is the index in the
 * FILTERED list, so a blank row dropped below does not leave a hole in the
 * count.
 *
 * ── `techCards[].body` is html-bearing ───────────────────────────────────
 * The cosmetic hub's card 05 carries an inline `<a class="vs-link">` into the
 * implant hub mid-sentence (the PHP field says so in its instructions), so the
 * paragraph is rendered `set:html`. The implant hub's six bodies are plain
 * prose with no `&`, `<` or `>` in them, so they render byte-identically either
 * way — `set:html` is the shape the CMS field actually has, not a widening.
 *
 * NO `.vs-link` RULE LIVES HERE, deliberately, and for the reason
 * ComparisonCardsBlock.astro:922 records: a link arriving through `set:html` is
 * already styled by global.css:31-58, and the two bands this ships on both
 * carry a page-sheet rule that tints it for their ground
 * (cosmetic-dentistry.css:227-234, implant-dentistry.css:356-366). A local rule
 * would be a compound this block authors — it would outrank both of those and
 * take the site's own link treatment away from a band that had it right.
 *
 * ── The panel switch ─────────────────────────────────────────────────────
 * `calloutHeading` is the switch, per the manifest and the PHP: blank — which
 * is what the implant hub stores and what every future grid-only band stores —
 * draws NO panel, not an empty one. That is also what makes this block additive
 * against a row saved before the panel fields existed: every one of those
 * fields comes back null, `calloutHeading` is blank, and the band is the grid
 * alone.
 *
 * Spec: docs/PAGE-BLOCKS.md Phase 4, Wave A. Contract: assignment table rows
 * implant #7 and cosmetic #3.
 */
import { Image } from "astro:assets";

/** The layout's image sub-field, as wpgraphql-acf returns an ACF image.
    Same shape as MediaSplitBlock.astro:125-132 and for the same reason: the
    manifest selects `image { node { sourceUrl altText mediaDetails { … } } }`. */
export interface TechGridImage {
  node?: {
    sourceUrl?: string | null;
    altText?: string | null;
    mediaDetails?: { width?: number | null; height?: number | null } | null;
  } | null;
}

/**
 * One row of the layout's `tech_cards` repeater — GraphQL type
 * `PageFieldsBlocksTechCards`. Every sub-field is optional at the schema level
 * because ACF returns null for anything an editor never filled in; typing them
 * as plain strings here would lie to the filter below.
 */
export interface TechGridCard {
  title?: string | null;
  /** May carry an inline `<a class="vs-link">` — see the header. */
  body?: string | null;
  /** The small label at the card's foot: "Imaging", "Scanning", "Continuity". */
  foot?: string | null;
}

interface Props {
  /** DOM id, already deduplicated by PageBlocks.astro. Absent when blank. */
  id?: string;
  /** The same value as `id`. Accepted so the spread in PageBlocks is lossless. */
  anchor?: string | null;
  /** Rail label. Read by the page that builds the rail, not by this band. */
  navLabel?: string | null;
  band?: string | null;
  eyebrow?: string | null;
  /** May contain `<em>`, and nothing else (docs/PAGE-BLOCKS.md, Fact 3). */
  heading?: string | null;
  body?: string | null;
  techCards?: TechGridCard[] | null;
  /** The four panel fields plus its image pair. `calloutHeading` is the switch. */
  calloutEyebrow?: string | null;
  /** May contain `<em>…</em>` for the accent styling — hence `set:html`. */
  calloutHeading?: string | null;
  calloutBody?: string | null;
  image?: TechGridImage | null;
  imageAlt?: string | null;
  /** The small plate on the photo — "Approve before we begin". */
  imageTag?: string | null;
}

/**
 * band value -> the modifier class the page's markup already uses.
 *
 * Read this map, not an ancestor class. `.section.alt` is charcoal green on
 * both hub sheets but cream on teeth-whitening.css:237 (Fact 4), so a block
 * that inherited its band would be wrong on some page the moment a section is
 * dragged. `paper` maps to nothing because a paper band is a bare
 * `class="section"` in every template.
 */
const BAND_CLASS: Record<string, string | undefined> = {
  paper: undefined,
  cream: "cream",
  "sage-pale": "dark",
  sage: "sage",
  charcoal: "alt",
};

const {
  id,
  /* `paper` and not one of the two live bands: it is what the PHP field stores
     as its own default_value (vs-content-model.php, block_preamble()), so a row
     an editor has never opened renders the band wp-admin is showing them. The
     branch is unreachable for any saved row — ACF returns the stored choice —
     which is exactly why it must not invent a different one. */
  band = "paper",
  eyebrow,
  heading,
  body,
  techCards,
  calloutEyebrow,
  calloutHeading,
  calloutBody,
  image,
  imageAlt,
  imageTag,
} = Astro.props;

const bandKey = typeof band === "string" && band !== "" ? band : "paper";
const bandClass = BAND_CLASS[bandKey];

const text = (input: unknown): string =>
  typeof input === "string" ? input.trim() : "";

/**
 * The eyebrow carries `light` on the two bands the templates spell
 * `.section.dark` / `.section.sage`, which is exactly where the cosmetic hub's
 * band sits — so the class is in the HTML there and has to be in the HTML here.
 * It is INERT under the current cascade (`.section.dark .eyebrow` at (0,3,0)
 * already beats `.eyebrow.light` at (0,2,0)); it is reproduced because this
 * phase is verified by an HTML diff, not by a rendering. Same rule and same
 * wording as ProcessStepsBlock.astro:143-152.
 */
const eyebrowLight = bandKey === "sage-pale" || bandKey === "sage";

const eyebrowText = text(eyebrow);
const headingHtml = text(heading);
const bodyText = text(body);
const hasHead = eyebrowText !== "" || headingHtml !== "" || bodyText !== "";

/**
 * Rows with nothing in them are dropped rather than drawn.
 *
 * ACF returns a repeater row an editor opened and abandoned as a row of empty
 * strings, and an empty `.tech-card` is a visible 220px-tall bordered rectangle
 * with nothing in it. Filtering here is also what keeps the numerals honest:
 * the position below is the position in THIS list, so a blank row between 02
 * and 03 does not print 01, 02, 04.
 *
 * A repeater of nothing but blank rows leaves `.tech-grid` unemitted entirely,
 * so such a band is byte-identical to one whose repeater was never touched.
 */
const cards = (Array.isArray(techCards) ? techCards : []).filter(
  (c) =>
    text(c?.title) !== "" || text(c?.body) !== "" || text(c?.foot) !== "",
);

/* The panel. `calloutHeading` alone is the switch — an editor who fills in the
   body and forgets the heading gets no panel and a warning, rather than a
   half-drawn plate nobody notices until a client does. */
const calloutHeadingHtml = text(calloutHeading);
const calloutEyebrowText = text(calloutEyebrow);
const calloutBodyText = text(calloutBody);
const imageTagText = text(imageTag);
const hasPanel = calloutHeadingHtml !== "";

if (!hasPanel && (calloutEyebrowText !== "" || calloutBodyText !== "")) {
  console.warn(
    `[blocks] tech_grid on ${Astro.url.pathname}${id ? `#${id}` : ""} has panel copy but no panel heading — ` +
      "the heading is the switch, so the panel is not drawn. Fill in Panel heading in wp-admin.",
  );
}

/**
 * The panel picture, or nothing.
 *
 * `<Image>` refuses a remote source without explicit intrinsic dimensions, so a
 * media item WordPress recorded no size for cannot be rendered at all — an SVG,
 * or an upload that did not finish. That degrades to a copy-only panel rather
 * than failing a build an editor triggered (the rule MediaSplitBlock.astro:485-506
 * and UnknownBlock.astro both run on), and the omission is reported to the
 * build log where an engineer will see it. Neither live row takes this path.
 */
const node = image?.node ?? null;
const src = typeof node?.sourceUrl === "string" ? node.sourceUrl : "";
const width = node?.mediaDetails?.width ?? 0;
const height = node?.mediaDetails?.height ?? 0;
const hasVisual = hasPanel && src !== "" && width > 0 && height > 0;

if (hasPanel && !hasVisual) {
  console.warn(
    `[blocks] tech_grid panel on ${Astro.url.pathname}${id ? `#${id}` : ""} has no usable picture — ` +
      "drawing the copy across the full panel",
  );
}

/** Editor override first, then the alt text stored on the file itself. */
const alt = text(imageAlt) || text(node?.altText) || "";
---

{/* `data-vs-reveal-batch` on the section, exactly as both templates carry it.
    animations.js:531 animates the section's DIRECT children, which is the one
    `.wrap` — so this is a single fade of the whole band, not a per-card
    stagger. Moving it to `.tech-grid` would be a different animation. */}
<section class:list={["section", bandClass]} id={id} data-vs-reveal-batch>
  <div class="wrap">
    {
      hasHead && (
        <div class="section-head">
          {eyebrowText && (
            <span class:list={["eyebrow", eyebrowLight && "light"]}>{eyebrowText}</span>
          )}
          {headingHtml && (
            <h2>
              <Fragment set:html={headingHtml} />
            </h2>
          )}
          {bodyText && <p>{bodyText}</p>}
        </div>
      )
    }

    {
      cards.length > 0 && (
        <div class="tech-grid">
          {/* padStart(2, "0") — 01…06 today, and a tenth card keeps two
              digits rather than becoming "010". The comment sits OUTSIDE the
              card: inside it, Astro emits the surrounding newlines as a
              whitespace text node the two templates do not have, in a flex
              container whose children are its cards. */}
          {cards.map((c, i) => (
            <div class="tech-card">
              <div class="tech-num">{String(i + 1).padStart(2, "0")}</div>
              {text(c.title) && <h4>{c.title}</h4>}
              {text(c.body) && <p set:html={text(c.body)} />}
              {text(c.foot) && <span class="tech-foot">{c.foot}</span>}
            </div>
          ))}
        </div>
      )
    }

    {
      hasPanel && (
        <div class:list={["dsd", !hasVisual && "copy-only"]}>
          <div class="dsd-copy">
            {calloutEyebrowText && (
              <span class:list={["eyebrow", eyebrowLight && "light"]}>{calloutEyebrowText}</span>
            )}
            <h3>
              <Fragment set:html={calloutHeadingHtml} />
            </h3>
            {calloutBodyText && <p>{calloutBodyText}</p>}
          </div>{
            /* Flushed `}{` so a panel with no usable picture adds no text node
               between the two columns of the grid. */
            hasVisual && (
              <div class="dsd-visual" data-vs-parallax data-parallax="-30">
                {imageTagText && <span class="dsd-tag">{imageTagText}</span>}
                <Image
                  src={src}
                  width={width}
                  height={height}
                  alt={alt}
                  widths={[500, 800, 1100]}
                  sizes="(max-width: 991px) 100vw, 50vw"
                />
              </div>
            )
          }
        </div>
      )
    }
  </div>
</section>

<style>
  /* ══ WHERE THESE RULES COME FROM ═══════════════════════════════════════════
     Two source sheets, because this block draws two live bands:

       src/styles/pages/implant-dentistry.css   `.impd` — the CHARCOAL band
       src/styles/pages/cosmetic-dentistry.css  `.cdent` — the SAGE-PALE band

     Each page's local `--sage` / `--ink` / `--line` / `--r-md` aliases are
     resolved back to the `--vs-*` tokens they alias one-for-one
     (implant-dentistry.css:25-44, cosmetic-dentistry.css:30-49 — cosmetic's
     sheet writes some of them already resolved). Rendered values are unchanged.

     ── THE ONE THING TO UNDERSTAND BEFORE EDITING THIS FILE ────────────────
     The card SKIN is not the same on the two pages, and the difference is not
     cosmetic drift — it is the two grounds:

       charcoal band → an opaque PAPER card with a `--vs-line` hairline, a
                       `--vs-sage-soft` numeral and a `--vs-sage` foot rule,
                       and it LIFTS 2px on hover (implant-dentistry.css:886-951).
       sage-pale band → a TRANSLUCENT white card (50% over the pale green) with a
                       70%-white border, a full `--vs-sage` numeral and an
                       ink-soft foot rule, and it does NOT move on hover
                       (cosmetic-dentistry.css:389-428).

     So the skin is written against the band VALUE, the way ProcessStepsBlock
     writes its pre-cards: the paper card is the base and `.section.dark` is the
     override. A single shared skin would be wrong on one hub the day it landed.

     ── AND WHY EVERY CARD RULE IS QUALIFIED WITH `.section` ────────────────
     Astro's attribute scoping compiles `.tech-card` to `.tech-card[cid]` —
     specificity (0,2,0), which TIES with the page sheets' own `.impd .tech-card`
     and `.cdent .tech-card`, and a tie is decided by bundle order. The house
     rule is never to build on that tie, so the base is written
     `.section .tech-card` → `.section[cid] .tech-card[cid]` at (0,4,0), which
     clears both page rules outright, and the band override
     `.section.dark .tech-card` sits above it at (0,5,0). Nothing here depends on
     which stylesheet a bundler happens to emit first. */

  /* ---------- band shell ----------
     `.section` owns its padding and has no margin at all, so this band cannot
     collapse into whichever band an editor drags above or below it. Same rule
     as FinalBand.astro and every sibling block.
     padding: implant-dentistry.css:306-308 = cosmetic-dentistry.css:199.
     `cream` and `sage` are not in either hub sheet — neither page places those
     bands — so their values come from tokens.css via the block family's shell
     (FaqBlock.astro:239-250), which is the contract the band select promises. */
  .section {
    margin: 0;
    padding: 110px 0;
    background: var(--vs-paper);
  }
  .section.cream {
    background: var(--vs-cream);
  }
  /* cosmetic-dentistry.css:216 / implant-dentistry.css:333-335 */
  .section.dark {
    background: var(--vs-sage-pale);
  }
  .section.sage {
    background: var(--vs-sage);
  }
  /* cosmetic-dentistry.css:200 / implant-dentistry.css:310-312 */
  .section.alt {
    background: var(--vs-charcoal-green);
  }

  /* Keep the heading clear of the stacked global Nav + sticky TOC when a rail
     chip is clicked. implant-dentistry.css:300-303 (written there as
     `section[id]`); cosmetic-dentistry.css:195. Both custom properties are set
     on the page wrapper and inherit down; the fallbacks are the desktop
     measurements those sheets declare (implant-dentistry.css:26-27). */
  .section[id] {
    scroll-margin-top: calc(var(--nav-h, 77px) + var(--toc-h, 68px) + 12px);
  }

  /* implant-dentistry.css:48-52 = cosmetic-dentistry.css:58 */
  .wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* implant-dentistry.css:54-61 = cosmetic-dentistry.css:60-64 */
  .eyebrow {
    font-family: var(--vs-font-body);
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--vs-sage);
    font-weight: 500;
  }
  /* implant-dentistry.css:62-64 = cosmetic-dentistry.css:65 */
  .eyebrow.light {
    color: var(--vs-eyebrow-on-sage);
  }

  /* h2 resolves to ink. Both page sheets reach that colour only through a
     trailing override whose own comment says it works because of its file
     position (implant-dentistry.css:1543-1549, cosmetic-dentistry.css tail); a
     block that owns its cascade states the outcome once.
     Sizing: implant-dentistry.css:87-91 = cosmetic-dentistry.css:73. */
  h2 {
    font-family: var(--vs-font-display);
    font-weight: 400;
    color: var(--vs-ink);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.022em;
    font-size: clamp(32px, 4.2vw, 54px);
  }
  /* `:global()` because the `<em>` arrives through `set:html` and carries no
     scope attribute — a plain `h2 em` compiles to `em[cid]`, misses it, and
     drops the accent colour. Value: implant-dentistry.css:84-86 /
     cosmetic-dentistry.css:77 (`em` → `--sage-soft`). */
  h2 :global(em) {
    font-style: italic;
    color: var(--vs-sage-soft);
    font-weight: 300;
  }

  /* implant-dentistry.css / cosmetic-dentistry.css:78 (`p` base) */
  p {
    margin: 0;
    color: var(--vs-ink-soft);
  }

  /* implant-dentistry.css:368-400 = cosmetic-dentistry.css:238-260 */
  .section-head {
    max-width: 760px;
    margin: 0 auto 64px;
    text-align: center;
  }
  .section-head .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .section-head .eyebrow::before,
  .section-head .eyebrow::after {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--vs-sage);
  }
  .section-head h2 {
    margin: 22px 0 22px;
  }
  .section-head p {
    font-size: 17px;
    line-height: 1.7;
    max-width: 60ch;
    margin: 0 auto;
  }

  /* ---------- band inversions ----------
     Scoped to `.section-head`, not band-wide. The tech cards and the panel are
     both surfaces of their own with colours of their own, so a band-wide
     `p { color: rgba(255,255,255,.85) }` would fight the card rules below —
     which is exactly the white-on-white regression global.css:195-212 exists to
     patch and general-dentistry.css:1128 exists to undo. Scoping the inversion
     removes the fight rather than winning it.
     Values: implant-dentistry.css:314-331 (alt) and :336-353 (dark);
     cosmetic-dentistry.css:201-207 (alt) and :216-223 (dark), plus each sheet's
     trailing source-order repeat of the same declarations. */
  .section.alt .section-head h2,
  .section.sage .section-head h2 {
    color: #fff;
  }
  .section.alt .section-head h2 :global(em),
  .section.sage .section-head h2 :global(em) {
    color: var(--vs-eyebrow-on-sage);
  }
  .section.alt .section-head p,
  .section.sage .section-head p {
    color: rgba(255, 255, 255, 0.85);
  }
  .section.alt .section-head .eyebrow,
  .section.sage .section-head .eyebrow {
    color: var(--vs-eyebrow-on-sage);
  }
  .section.alt .section-head .eyebrow::before,
  .section.alt .section-head .eyebrow::after,
  .section.sage .section-head .eyebrow::before,
  .section.sage .section-head .eyebrow::after {
    background: rgba(255, 255, 255, 0.6);
  }

  .section.dark .section-head h2 {
    color: var(--vs-ink);
  }
  .section.dark .section-head h2 :global(em) {
    color: var(--vs-sage);
  }
  .section.dark .section-head p,
  .section.dark .section-head .eyebrow {
    color: var(--vs-ink-soft);
  }
  .section.dark .section-head .eyebrow::before,
  .section.dark .section-head .eyebrow::after {
    background: var(--vs-ink-soft);
  }

  /* ---------- the grid ----------
     implant-dentistry.css:886-890 = cosmetic-dentistry.css:389-393, EXCEPT the
     top margin: the cosmetic band opens 56px below its head and the implant
     band opens flush against the head's own 64px. That 56px is a real,
     measured difference between the two live pages, not drift, so it has to
     survive here — and the only signal a block row carries that separates the
     two bands is the band value. It rides `.section.dark`.

     THE FAILURE MODE, named: a future tech_grid placed on a paper or cream band
     gets the implant spacing, and one placed on sage-pale gets the cosmetic
     spacing, whether or not that is what its designer meant. If a band ever
     needs the other pairing, the fix is a spacing field on the layout — not a
     second copy of this block, and not deleting one of the two page rules. */
  .section .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  /* cosmetic-dentistry.css:392 */
  .section.dark .tech-grid {
    margin-top: 56px;
  }

  /* ---------- the card, paper skin (base) ----------
     implant-dentistry.css:891-951, which is also the skin that reads correctly
     on paper, cream and the deep-sage band: an opaque card with a hairline. */
  .section .tech-card {
    background: var(--vs-paper);
    border: 1px solid var(--vs-line);
    border-radius: var(--vs-r-md);
    padding: 28px 26px 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 220px;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }
  /* implant-dentistry.css:905-909 */
  .section .tech-card:hover {
    background: #fff;
    border-color: color-mix(in srgb, var(--vs-sage) 25%, var(--vs-line));
    transform: translateY(-2px);
  }
  /* implant-dentistry.css:910-917 */
  .section .tech-card .tech-num {
    font-family: var(--vs-font-display);
    font-weight: 300;
    font-style: italic;
    font-size: 28px;
    line-height: 1;
    color: var(--vs-sage-soft);
  }
  /* implant-dentistry.css:918-926 = cosmetic-dentistry.css:412-416.
     The colour is stated here rather than left to global.css:195-212's
     white-card rescue — that rescue declares the same `--vs-ink`, so the
     rendering is identical, but a card whose own sheet says what colour it is
     does not depend on a shared list somewhere else being kept in step. */
  .section .tech-card h4 {
    font-family: var(--vs-font-display);
    font-weight: 500;
    font-size: 19px;
    color: var(--vs-ink);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.005em;
  }
  /* implant-dentistry.css:927-932 = cosmetic-dentistry.css:417-420 */
  .section .tech-card p {
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--vs-ink-soft);
    margin: 0;
  }
  /* implant-dentistry.css:933-944 = cosmetic-dentistry.css:421-426 */
  .section .tech-card .tech-foot {
    margin-top: auto;
    padding-top: 14px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--vs-muted);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  /* implant-dentistry.css:945-950 */
  .section .tech-card .tech-foot::before {
    content: "";
    width: 18px;
    height: 1px;
    background: var(--vs-sage);
  }

  /* ---------- the card, translucent skin on the sage-pale band ----------
     cosmetic-dentistry.css:394-428. The card is 50% white over the pale green,
     which is a different object from the opaque plate above — an opaque paper
     card on this ground reads as a cut-out, which is why the page never used
     one. `transform: none` is not decoration: the base skin lifts on hover and
     the cosmetic band does not, and an unreverted lift would be a live visual
     change on a page this phase must leave byte-for-byte alone. */
  .section.dark .tech-card {
    background: rgba(255, 255, 255, 0.5);
    border-color: rgba(255, 255, 255, 0.7);
  }
  .section.dark .tech-card:hover {
    background: rgba(255, 255, 255, 0.75);
    border-color: #fff;
    transform: none;
  }
  .section.dark .tech-card .tech-num {
    color: var(--vs-sage);
  }
  .section.dark .tech-card .tech-foot::before {
