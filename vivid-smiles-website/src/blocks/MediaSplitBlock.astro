  .section.alt .what-sub .config-card h4,
  .section.sage .what-sub .config-card h4 {
    color: var(--vs-ink);
  }
  .section.alt .what-sub .config-card p,
  .section.sage .what-sub .config-card p {
    color: var(--vs-ink-soft);
  }

