---
/**
 * CodeSectionBlock — the `code_section` layout: a row that holds a POSITION in
 * the ordered list for a band this build draws in code.
 *
 * ── The regression this exists to fix ─────────────────────────────────────
 * "Stays in code" and "cannot be positioned by an editor" are different facts.
 * Conflating them moved a band on a live page. The pilot's LocalTrust band sits
 * between `lasting` and `gallery` (clear-aligners.astro:505-510), and the
 * template renders it OUTSIDE the migration switch — so the moment PageBlocks
 * started drawing the eight blocks, the bespoke band fell to wherever the
 * template happens to put it:
 *
 *   before   why what process compare natural lasting LOCAL gallery faq
 *   after    why what process compare natural lasting gallery faq LOCAL
 *
 * A `code_section` row at position 7 puts it back, and puts it back under the
 * same editor control every other band has. An editor can move this row and
 * delete it; there is nothing in it to author, and that is the whole design
 * (docs/PAGE-BLOCKS.md 1.3 "The escape hatch", 7 "What not to do").
 *
 * ── What it emits ─────────────────────────────────────────────────────────
 * The named component and NOTHING ELSE. No <section>, no wrapper div, no
 * marker element. Every band registered below already owns its own <section>,
 * its own band background and its own padding — LocalTrust.astro:80 is a
 * `<section class="vs-lt …">` — so a wrapper here would nest two sections
 * inside one another and change the markup this block exists to preserve.
 * Same rule PageBlocks.astro follows for the list as a whole (2.5).
 *
 * Because the band keeps its place inside `<main>` inside `.caligners`, the
 * page-scoped sheet still cascades into it exactly as it did from the template.
 *
 * ── Why there is no <style> block ─────────────────────────────────────────
 * This component authors no markup of its own in production, so it has nothing
 * to style. The dev placeholder below therefore uses inline `style` attributes
 * rather than a co-located <style>: Astro extracts a <style> block statically
 * and ships it wherever the component is in the module graph, which would put
 * diagnostic CSS into the stylesheet of every page that renders any block, for
 * markup no visitor can ever reach. This is the one block where §2.5's
 * co-location rule buys nothing and costs bytes.
 *
 * ── The CSS this DOES pull in ─────────────────────────────────────────────
 * Importing LocalTrust here puts its scoped CSS in the module graph of every
 * page that renders blocks, whether or not that page's blocks include a
 * `code_section` row. Currently free: the pilot is the only page importing
 * PageBlocks and it already imports LocalTrust directly. It stops being free
 * when a page that has no LocalTrust band adopts blocks. If that ever shows up
 * in a build diff, the fix is a dynamic import here, not a new indirection in
 * manifest.ts — the manifest must keep importing zero .astro files.
 *
 * ── Do not let the band render twice ──────────────────────────────────────
 * A page whose template still calls the component directly AND carries a
 * `code_section` row for it renders the band twice. The template's bespoke
 * invocation has to sit behind the same `hasBlocks` guard every other migrated
 * band sits behind.
 *
 * Spec: docs/PAGE-BLOCKS.md 1.3, 2.2, 2.4, 7.
 */
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

import LocalTrust from "../components/LocalTrust.astro";
// Wave A (Phase 4, hub pages). These three are NEW components, created by the
// build agents in the same wave as this registration — the imports fail the
// build loudly until they exist, which is the correct failure mode: the quiet
// alternative (registering the keys later) is a select choice in wp-admin that
// saves fine and renders a blank band. Their contract:
//   AreaBand    — the hubs' `#area` band: `.area` grid of `.area-copy` (eyebrow,
//                 <h2> via set:html, the paragraphs below, then the
//                 `.area-address-line`, and the sage "Get Directions" (hover
//                 "Open Maps", href directionsHref) + ghost "Contact Us" (hover
//                 "Reach Us", href /contact/) pair) beside the `.area-map`
//                 Google iframe. Address line, phone link, buttons and iframe
//                 all come from src/data/contact.ts INSIDE the component; the
//                 literal tokens {street} and {city} in a paragraph prop are
//                 replaced with addressStreet/addressCity so the copy keeps
//                 tracking Practice Settings exactly as the template
//                 interpolation it replaces — bake the address in and the next
//                 address change strands three pages.
//   TrustBand   — general-dentistry's `#trust`: the centred `.trust-quote` on
//                 the sage-pale band (eyebrow light, <h2> set:html, two
//                 `.trust-body` paragraphs — the second html-bearing — and the
//                 `.trust-attr` line of aria-hidden stars + text).
//   PaymentBand — general-dentistry's `#payment` on the charcoal band:
//                 `.pay-grid` of `.pay-copy` (eyebrow, <h2> set:html, two
//                 paragraphs, light "Book Online" (hover "Let's Talk", href
//                 bookNowHref) + ghost-light "Call {phoneLabel}" (hover "Tap to
//                 Dial", href phoneHref)) beside the `.pay-card` aside
//                 (`.pay-card-eyebrow`, <h3> set:html, `.pay-list` of
//                 html-bearing lines, ghost "See Membership Plan" →
//                 /dental-membership-plan/, hover "See Plan").
import AreaBand from "../components/AreaBand.astro";
import TrustBand from "../components/TrustBand.astro";
import PaymentBand from "../components/PaymentBand.astro";
import ScenarioBand from "../components/ScenarioBand.astro";
import PreventBand from "../components/PreventBand.astro";
import ReviewsBand from "../components/ReviewsBand.astro";

/** One registered bespoke band. */
interface CodeBand {
  /** The component that has always drawn this band. */
  component: AstroComponentFactory;
  /**
   * Its props, verbatim from the template that used to invoke it. This is the
   * band's content, and it is code-owned on purpose: the editor moves the row,
   * the developer owns what is in it.
   */
  props?: Record<string, unknown>;
  /**
   * Which prop the row's (already deduplicated) anchor feeds. Defaults to `id`,
   * which is what every band component in this codebase calls it. Set to `null`
   * for a component that takes no DOM id — passing one would be inert in Astro,
   * but saying so is cheaper than rediscovering it.
   */
  anchorProp?: string | null;
}

/**
 * band key → the band it names.
 *
 * ADDING THE NEXT BAND IS ONE ENTRY HERE AND ONE CHOICE IN THE PHP. Nothing
 * else changes: `code_section` is already in manifest.ts and registry.ts, and
 * its selection set never grows, because the layout has no per-band fields to
 * ask for.
 *
 * KEYS ARE PER BAND INSTANCE, NOT PER COMPONENT. The heading below says "for
 * Clear Aligners"; the same component draws a differently-worded band on nine
 * other pages. So the key is `<page>_<anchor>` — mechanical, collision-free,
 * and it reads correctly in the wp-admin select next to the anchor an editor
 * can already see. `map_visit` (Wave B, Phase 4) is what eventually turns these
 * into one editable layout; until then each instance is its own key.
 */
const BANDS: Record<string, CodeBand> = {
  /**
   * The pilot's "Parker, CO" trust band — map embed, review summary, address,
   * two CTAs. Reproduced verbatim from clear-aligners.astro:505-510, including
   * the omitted `background` (LocalTrust defaults to cream, which is the band
   * this has always drawn) and the omitted `eyebrow` (defaults to "Our
   * Practice"). Both are left omitted rather than restated: a default that is
   * spelled out here and changed there is a difference nobody would look for.
   */
  local_trust: {
    component: LocalTrust,
    props: {
      heading: "Why Patients Choose Vivid Smiles",
      headingItalic: "for Clear Aligners",
      intro:
        "Dr. Bryce Richardson is a Parker resident who built Vivid Smiles Dentistry on the values of his hometown — and that shows in every visit, whether patients drive across town or fly in for treatment.",
      body: "With 300+ five-star Google reviews and a welcoming office at 17167 Cedar Gulch Pkwy Ste 102, patients receive individual attention that larger groups cannot replicate. Many patients discover additional smile possibilities during treatment.",
    },
  },

  /**
