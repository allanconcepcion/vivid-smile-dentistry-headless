   * place they could drift from LocalTrust.astro.
   *
   * Registered in BLOCK_CODE_BANDS in the same commit. Only one of the two and
   * the row saves cleanly, resolves to nothing, and the band is simply gone
   * from a live page with a console warning nobody reads.
   */
  porcelain_veneers_local: {
    component: LocalTrust,
    props: {
      heading: "Veneers Designed",
      headingItalic: "in Parker, Colorado",
