    margin-inline: auto;
  }
  /* all-on-4-single-arch.css:530-531 and bone-grafting.css:530-531, identical. */
  .alternatives-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
  /* No `.alternatives-grid` in the corpus is four across — the only 4-col value
     for this card shape is sinus-lift.css:387-388's `.cause-grid`, which is the
     media_split side of the same batch. It is here because the PHP select offers
     "4" (vs-content-model.php:2341-2345) and a choice with no rule behind it
     would render as a single implicit column. */
  .alternatives-grid.cols-4 { grid-template-columns: repeat(4, 1fr); }

  .config-card {
    background: var(--vs-paper);
    border: 1px solid var(--vs-line);
    border-radius: var(--vs-r-lg);
    padding: 36px 34px;
    display: flex;
    flex-direction: column;
