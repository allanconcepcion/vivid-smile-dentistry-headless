     text must not follow the band (R2). Doubling the class is the same
     specificity lever global.css:228 already uses for cards on dark bands. */
  .safety-callout {
    margin: 50px auto 0;
    max-width: 920px;
    padding: 36px 40px;
    border-radius: var(--vs-r-lg);
    background: var(--vs-cream);
    border-left: 3px solid var(--vs-sage);
  }
  .safety-callout.safety-callout h3 {
    font-family: var(--vs-font-display);
    font-weight: 500;
    font-size: clamp(20px, 2vw, 24px);
