---
/**
 * Blog post — single article page.
 *
 * Renders one post from the `blog` content collection at /blog/<slug>/.
 * - Drafts are filtered out of getStaticPaths so they don't ship.
 * - The body arrives from WordPress as sanitized HTML (see src/loaders/blog.ts)
 *   and is injected with set:html after its images are run through the asset
 *   pipeline by optimizeBodyImages().
 * - The TOC is generated from the rendered headings (H2 + H3) and wired to
 *   the shared scroll-spy in src/scripts/toc-spy.ts (same script the service
 *   detail pages use; the spy keys off the .blog-post wrapper).
 *
 * Layout convention follows the rest of the site:
 * - Page-scoped wrapper class `.blog-post` (styles in src/styles/pages/blog-post.css)
 * - Inline breadcrumb (no component)
 * - Inline Schema.org JSON-LD (BlogPosting + BreadcrumbList)
 */
import type { GetStaticPaths } from "astro";
import { Image, getImage } from "astro:assets";
import { optimizeBodyImages } from "../../lib/wp-body-images";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import VirtualConsult from "../../components/VirtualConsult.astro";
import BlogByline from "../../components/BlogByline.astro";
import BlogShareButtons from "../../components/BlogShareButtons.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { getAllPosts, categoryUrl, type BlogPost } from "../../lib/blog";
import "../../styles/pages/blog-post.css";

export const getStaticPaths = (async () => {
  const posts = await getAllPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}) satisfies GetStaticPaths;

interface Props {
  post: BlogPost;
  allPosts: BlogPost[];
}

const { post, allPosts } = Astro.props;
const { data, body } = post;
const { headings } = await render(post);

// The body comes from WordPress as an HTML string. Astro's <Content /> would
// inject it verbatim, leaving in-body <img> tags pointing at the CMS host —
// unoptimized, and a runtime dependency on WordPress being up. Rewriting them
// here downloads each one at build time and swaps in a hashed local asset.
//
// Heading ids are untouched by this pass, so the sticky TOC and toc-spy.ts
// keep resolving against the same anchors.
const bodyHtml = await optimizeBodyImages(post.rendered?.html ?? "");

// Build a TOC from H2 + H3 headings only. H1 is the post title (rendered above
// the body), H4+ are too granular for a sticky rail.
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);

// A post with no usable featured image still publishes — src/loaders/blog.ts
// never drops one — and arrives carrying a placeholder plate with
// heroPlaceholder: true. Everything hero-shaped on this page is therefore
// conditional, and each branch is a deliberate choice, not a fallback:
//
//   the hero figure   omitted entirely. A 16:9 blank plate at the top of an
//                     article reads as a broken image; a post that simply opens
//                     on its headline and byline reads as an editorial choice.
//                     (The hub grid is the opposite case — see BlogCard.astro,
//                     where every tile needs a media well or the grid goes
//                     ragged — so there the placeholder does render.)
//   og: / twitter:    omitted, so BaseLayout falls through to its site-logo
//                     default — the same social preview every other page on the
//                     site uses when it has nothing more specific.
//   JSON-LD image     omitted. `image` is recommended-not-required on
//                     BlogPosting, and pointing it at a 180px logo or a blank
//                     plate is worse than saying nothing: Google wants a real
//                     ≥1200px article image, and a stand-in misrepresents the
//                     article in every surface that consumes it.
const hasHero = !data.heroPlaceholder;

// Absolute hero image URL for og:image + JSON-LD. getImage returns the
// transformed src so the social preview is the optimized webp, not the raw.
//
// heroImage is a remote WordPress URL, so the source dimensions have to be
// passed explicitly — a remote src carries none, and getImage needs the aspect
// ratio to derive the height for a given width.
const heroOg = hasHero
  ? await getImage({
      src: data.heroImage,
      width: 1200,
      height: Math.round((1200 * data.heroHeight) / data.heroWidth),
      format: "webp",
    })
  : null;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const heroAbs = heroOg ? new URL(heroOg.src, Astro.site).href : null;

const pageTitle = `${data.title} | Vivid Smiles Dentistry`;
---

<BaseLayout
  title={pageTitle}
  description={data.description}
  ogImage={heroOg?.src}
  articlePublishedDate={data.date}
  articleAuthor={data.author}
>
  <div class="blog-post">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/blog/">Blog</a>
        <span class="sep">/</span>
        <span class="here">{data.title}</span>
      </div>
    </nav>

    <main id="main">

    {/* ---------- HERO ---------- */}
    <header class="post-hero" data-vs-reveal-batch>
      <div class="wrap">
        <div class="post-hero-meta">
          <a class="post-hero-cat" href={categoryUrl(data.category)}>{data.category}</a>
        </div>
        <h1 class="post-h1" data-vs-reveal-lines>{data.title}</h1>
        <div class="post-hero-row">
          <BlogByline author={data.author} date={data.date} body={body ?? ""} />
          <div class="post-hero-share">
            <BlogShareButtons url={canonical} title={data.title} />
          </div>
        </div>
        {hasHero && (
          <div class="post-hero-img" data-vs-reveal>
            <Image
              src={data.heroImage}
              alt={data.heroAlt}
              width={data.heroWidth}
              height={data.heroHeight}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 991px) 100vw, 1200px"
              loading="eager"
            />
          </div>
        )}
      </div>
    </header>

    {/* ---------- TOC (sticky) ---------- */}
    {tocItems.length > 1 && (
      <nav class="toc" id="toc" aria-label="On this page">
        <div class="toc-inner">
          <span class="toc-label">On this page</span>
          <div class="toc-scroll">
            <div class="toc-list">
              {tocItems.map((h) => (
                <a href={`#${h.slug}`} data-depth={h.depth}>{h.text}</a>
              ))}
            </div>
          </div>
        </div>
      </nav>
    )}

    {/* ---------- BODY ---------- */}
    <section class="post-body-section">
      <div class="wrap">
        {/* Body deliberately NOT wrapped in data-vs-reveal-batch — the reveal
            primitive applies opacity:0 to every direct child (paragraphs,
            headings, lists, images) and staggers them in at 0.14s each, which
            for a long article never finishes. The body should be visible from
            first paint; only block-level scenery (hero, related) gets reveals. */}
        <article class="prose">
          <Fragment set:html={bodyHtml} />
        </article>
        <div class="post-body-share" aria-label="Share this article">
          <BlogShareButtons url={canonical} title={data.title} />
        </div>
      </div>
    </section>

    {/* ---------- VIRTUAL CONSULT — closing CTA ---------- */}
    <VirtualConsult id="consult" eyebrow="Ready When You Are">
      <Fragment slot="headline">Your healthiest smile <em>starts with a conversation.</em></Fragment>
      <Fragment slot="body">
        If anything in this article sparked a question — or you'd like Dr. Richardson to look at
        your specific case — submit a few photos and we'll record a personalized video back.
      </Fragment>
    </VirtualConsult>

    {/* ---------- RELATED POSTS ---------- */}
    <RelatedPosts current={post} all={allPosts} />

    </main>

    {/* ---------- JSON-LD: BlogPosting ---------- */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": data.title,
      "description": data.description,
      // Omitted rather than filled with a stand-in when the post has no real
      // featured image — see the hasHero note in the frontmatter.
      ...(heroAbs ? { "image": heroAbs } : {}),
      "datePublished": data.date.toISOString(),
      "dateModified": (data.updated ?? data.date).toISOString(),
      "author": {
        "@type": "Organization",
        "name": data.author,
      },
      "publisher": {
        "@type": "Dentist",
        "name": "Vivid Smiles Dentistry",
        "url": new URL("/", Astro.site).href,
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": canonical,
      },
      "articleSection": data.category,
    })} />

    {/* ---------- JSON-LD: BreadcrumbList ---------- */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).href },
        { "@type": "ListItem", "position": 2, "name": "Blog", "item": new URL("/blog/", Astro.site).href },
        { "@type": "ListItem", "position": 3, "name": data.title, "item": canonical },
      ],
    })} />

    {/* ---------- TOC scroll-spy ---------- */}
    <script>
      import { initTocSpy } from "../../scripts/toc-spy";
      initTocSpy(".blog-post");
    </script>

  </div>
</BaseLayout>
