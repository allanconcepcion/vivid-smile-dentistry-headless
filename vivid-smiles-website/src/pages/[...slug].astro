---
/**
 * Every WordPress page that has no hand-built route of its own.
 *
 * The 35 templates under src/pages are bespoke: each one's stylesheet assumes a
 * fixed structure, which is why page copy is edited in WordPress but page
 * LAYOUT is not. The gap that left: a page an editor creates in wp-admin had no
 * route, so it 404'd on the front end and was dropped from the sitemap with a
 * warning nobody reads.
 *
  *  This closes it. Any page in the pages collection whose URL no template
 * already owns is built here, in the site's shell, from the same fields the
 * designed templates read. Nothing about those pages changes — a static route
 * always wins, and the guard below makes that explicit rather than relying on
 * Astro's route priority.
 *
 * Note there is no post_content to fall back on: vs-content-model.php calls
 * remove_post_type_support('page', 'editor') on purpose, so a page IS its
 * fields. Sections, process steps, FAQs and cards are what an editor fills in,
 * and they are what gets rendered here.
 *
 * It is a floor, not a ceiling: the right typography in the right shell. A page
 * that matters still deserves its own template.
 */
import { readdir } from "node:fs/promises";
import { join } from "node:path";
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { optimizeBodyImages } from "../lib/wp-body-images";
import "../styles/pages/wp-page.css";

type PageData = CollectionEntry<"pages">["data"];

/**
 * Astro lifts getStaticPaths out of this frontmatter so it can be called
 * without rendering the component, and only the imports above come with it —
 * a const declared out here is not in scope by the time it runs. Everything
 * this function needs is therefore declared inside it.
 */
export const getStaticPaths = (async () => {
  /**
   * Every .astro file below a directory, as a path relative to it.
   *
   * Read from disk rather than globbed. A Vite glob for every .astro file in
   * this directory matches this file too, which hands the bundler a page that
   * imports itself. Reading the directory keeps the list generated rather than
   * hardcoded, without putting pages into each other's import graph.
   */
  async function astroFilesIn(dir: string, prefix = ""): Promise<string[]> {
    const found: string[] = [];

    for (const entry of await readdir(dir, { withFileTypes: true })) {
      const relative = prefix ? `${prefix}/${entry.name}` : entry.name;

      if (entry.isDirectory()) {
        found.push(...(await astroFilesIn(join(dir, entry.name), relative)));
      } else if (entry.name.endsWith(".astro")) {
        found.push(relative);
      }
    }

    return found;
  }

  /** Every route already served by a hand-built template. */
  async function handBuiltRoutes(): Promise<Set<string>> {
    // src/pages, whether the build runs from the site directory or the repo root.
    const candidates = [
      join(process.cwd(), "src", "pages"),
      join(process.cwd(), "vivid-smiles-website", "src", "pages"),
    ];

    let files: string[] | null = null;

    for (const dir of candidates) {
      try {
        files = await astroFilesIn(dir);
        break;
      } catch {
        // Not this one. Try the next.
      }
    }

    // Better to stop than to guess: an empty set here would let a WordPress
    // page claim a designed page's URL and overwrite it in the output.
    if (!files) {
      throw new Error(
        "[wp-pages] Could not find src/pages, so the routes that already have " +
          "a hand-built template are unknown. Refusing to build WordPress pages.",
      );
    }

    const routes = new Set<string>();

    for (const file of files) {
      // Dynamic routes, this file included — they own no fixed path.
      if (file.includes("[")) continue;

      const route = file.replace(/\.astro$/, "").replace(/(^|\/)index$/, "");
      routes.add(route ? `/${route}/` : "/");
    }

    return routes;
  }

  const entries = await getCollection("pages");
  const handBuilt = await handBuiltRoutes();
  const claimed = new Set<string>();

  return entries.flatMap((entry) => {
    const raw = entry.data.route;

    // No usable URL means there is nothing to build.
    if (!raw.startsWith("/")) return [];

    const route = raw.endsWith("/") ? raw : `${raw}/`;

    // The home page belongs to index.astro whatever WordPress thinks.
    if (route === "/") return [];

    // A designed template always wins.
    if (handBuilt.has(route)) return [];

    // Two pages can end up sharing a URL after a slug edit. The first wins,
    // rather than both writing to the same file.
    if (claimed.has(route)) return [];
    claimed.add(route);

    // A page with nothing in any field still gets built.
    //
    // It used to be skipped, on the reasoning that a URL with only a heading on
    // it is worse than no URL at all. In practice the opposite was true: the
    // editor had already published the page, so the address existed and was
    // being handed out, and skipping it produced a 404 plus a silent drop from
    // the sitemap — a worse failure than a thin page, and a much harder one to
    // notice. Building it puts the page where the editor put it; filling it in
    // is then an ordinary edit rather than a mystery.
    //
    // Note tocLinks counts as copy. It did not before, so a page using only the
    // "On this page" tab — one of the three tabs a newly created page can
    // actually use today — was skipped as empty.
    const { sections, processSteps, faqs, cards, tocLinks } = entry.data;
    const hasCopy =
      sections.some((s) => s.heading.trim() || s.body.trim()) ||
      processSteps.length > 0 ||
      faqs.length > 0 ||
      cards.length > 0 ||
      tocLinks.length > 0;

    // Named in the log so an empty page is discoverable from the build output
    // rather than by clicking. Informational: it is not a failure.
    if (!hasCopy) {
      console.info(`[wp-pages] ${route} has no content in any field — building it title-only.`);
    }

    return [{ params: { slug: route.slice(1, -1) }, props: { page: entry.data } }];
  });
}) satisfies GetStaticPaths;

interface Props {
  page: PageData;
}

const { page } = Astro.props;

/**
 * A field's copy as HTML.
 *
 * A wysiwyg field arrives as HTML; a plain textarea does not, and handing raw
 * text to set:html would collapse every paragraph into one. Images inside the
 * HTML go through the asset pipeline, exactly as the blog's do — otherwise a
 * "static" page keeps a runtime dependency on WordPress.
 */
async function toHtml(value: string): Promise<string> {
  const copy = value.trim();
  if (!copy) return "";

  if (!copy.includes("<")) {
    return copy
      .split(/\n\s*\n/)
      .map((paragraph) => `<p>${paragraph.trim().replace(/\n/g, "<br />")}</p>`)
      .join("");
  }

  return await optimizeBodyImages(copy);
}

const sections = await Promise.all(
  page.sections
    .filter((section) => section.heading.trim() || section.body.trim())
    .map(async (section) => ({ ...section, html: await toHtml(section.body) })),
);

const steps = await Promise.all(
  page.processSteps.map(async (step) => ({ ...step, html: await toHtml(step.body) })),
);

const faqs = await Promise.all(
  page.faqs.map(async (faq) => ({ ...faq, html: await toHtml(faq.a) })),
);

// Cards are grouped by the field array they came from, the same way
// getPageContent groups them for the designed templates.
const cardGroups = new Map<string, PageData["cards"]>();
for (const card of page.cards) {
  cardGroups.set(card.group, [...(cardGroups.get(card.group) ?? []), card]);
}

// Editor-managed SEO wins. Falling back to the opening copy beats the
// site-wide default repeated on every page an editor adds.
const description =
  page.seo.description ||
  sections[0]?.html
    .replace(/<[^>]+>/g, " ")
    .replace(/\s+/g, " ")
    .trim()
    .slice(0, 155) ||
  undefined;

// A page whose fields are all empty renders as hero only. Without this the
// body wrapper still emits, and its padding leaves a tall blank slab under the
// heading that reads as a broken page rather than an unfinished one.
const hasBody =
  page.tocLinks.length > 0 ||
  sections.length > 0 ||
  steps.length > 0 ||
  cardGroups.size > 0 ||
  faqs.length > 0;
---

<BaseLayout
  title={page.seo.title || `${page.title} | Vivid Smiles Dentistry`}
  description={description}
  noindex={page.seo.noindex}
  ogImage={page.seo.ogImage || undefined}>
  <div class="wp-page">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="here">{page.title}</span>
      </div>
    </nav>

    <main id="main">
      {/* ---------- HERO ---------- */}
      <header class="wp-page-hero" data-vs-reveal-batch>
        <div class="wrap">
          <h1 class="vs-h1">{page.title}</h1>
          {description && <p class="vs-lede">{description}</p>}
        </div>
      </header>

      {hasBody && (
        <div class="wp-page-body">
          <div class="wrap">
            {page.tocLinks.length > 0 && (
              <aside class="wp-page-toc" aria-label="On this page">
                <span class="wp-page-toc-label">On this page</span>
                <ul>
                  {page.tocLinks.map((link) => (
                    <li><a href={link.href}>{link.label}</a></li>
                  ))}
                </ul>
              </aside>
            )}

            {sections.map((section) => (
              <section class="wp-page-section" id={section.section_id || undefined} data-vs-reveal>
                {section.eyebrow && <span class="wp-page-eyebrow">{section.eyebrow}</span>}
                {section.heading && <h2 class="vs-h3">{section.heading}</h2>}
                {section.html && <div class="wp-page-prose" set:html={section.html}></div>}
                {section.cta_label && section.cta_href && (
                  <a class="wp-page-cta" href={section.cta_href}>{section.cta_label}</a>
                )}
              </section>
            ))}

            {steps.length > 0 && (
              <section class="wp-page-section" data-vs-reveal>
                <ol class="wp-page-steps">
                  {steps.map((step) => (
                    <li>
                      {step.tag && <span class="wp-page-step-tag">{step.tag}</span>}
                      <h3 class="wp-page-step-title">{step.title}</h3>
                      {step.html && <div class="wp-page-prose" set:html={step.html}></div>}
                    </li>
                  ))}
                </ol>
              </section>
            )}

            {Array.from(cardGroups).map(([group, cards]) => (
              <section class="wp-page-section" data-vs-reveal>
                <ul class="wp-page-cards" data-group={group}>
                  {cards.map((card) => (
                    <li>
                      {card.meta && <span class="wp-page-card-meta">{card.meta}</span>}
                      <h3 class="wp-page-card-title">
                        {card.href ? <a href={card.href}>{card.title}</a> : card.title}
                      </h3>
                      {card.body && <p>{card.body}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            ))}

            {faqs.length > 0 && (
              <section class="wp-page-section" data-vs-reveal>
                <h2 class="vs-h3">Frequently asked questions</h2>
                <div class="wp-page-faqs">
                  {faqs.map((faq) => (
                    <details open={faq.open}>
                      <summary>{faq.q}</summary>
                      <div class="wp-page-prose" set:html={faq.html}></div>
                    </details>
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>
      )}
    </main>
  </div>
</BaseLayout>
