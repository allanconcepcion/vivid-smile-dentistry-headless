---
/**
 * Every WordPress page that has no hand-built route of its own.
 *
 * The 35 templates under src/pages are bespoke: each one's stylesheet assumes a
 * fixed structure, which is why page copy is edited in WordPress but page
 * LAYOUT is not. The gap that left: a page an editor creates in wp-admin had no
 * route, so it 404'd on the front end and was dropped from the sitemap with a
 * warning nobody reads.
 *
 * This closes it. Any published page whose URL no template already owns is
 * built here from its WordPress body, in the site's shell, with its images run
 * through the asset pipeline. Nothing about the designed pages changes — a
 * static route always wins over this one, and the guard below makes that
 * explicit rather than relying on Astro's route priority.
 *
 * It is a floor, not a ceiling: generic prose in the right typography. A page
 * that matters still deserves its own template.
 */
import { readdir } from "node:fs/promises";
import { join } from "node:path";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { wpQuery } from "../lib/wp";
import { optimizeBodyImages } from "../lib/wp-body-images";
import "../styles/pages/wp-page.css";

type WpPage = {
  title: string | null;
  uri: string | null;
  content: string | null;
};

/**
 * Astro lifts getStaticPaths out of this frontmatter so it can be called
 * without rendering the component, and only the imports above come with it —
 * a const declared out here is not in scope by the time it runs. Everything
 * this function needs is therefore declared inside it.
 */
export const getStaticPaths = (async () => {
  // No status filter: an unauthenticated WPGraphQL request already returns only
  // published content, and query-level errors are fatal to the build, so the
  // fewer arguments this depends on the better.
  const PAGES_QUERY = `
    query PagesForCatchAllRoute($first: Int!) {
      pages(first: $first) {
        nodes {
          title
          uri
          content
        }
      }
    }
  `;

  /**
   * Every .astro file below a directory, as a path relative to it.
   *
   * Read from disk rather than globbed. A Vite glob for every .astro file in
   * this directory matches this file too, which hands the bundler a page that
   * imports itself. Reading the directory keeps the list generated rather than
   * hardcoded, without putting pages into each other's import graph.
   */
  async function astroFilesIn(dir: string, prefix = ""): Promise<string[]> {
    const found: string[] = [];

    for (const entry of await readdir(dir, { withFileTypes: true })) {
      const relative = prefix ? `${prefix}/${entry.name}` : entry.name;

      if (entry.isDirectory()) {
        found.push(...(await astroFilesIn(join(dir, entry.name), relative)));
      } else if (entry.name.endsWith(".astro")) {
        found.push(relative);
      }
    }

    return found;
  }

  /** Every route already served by a hand-built template. */
  async function handBuiltRoutes(): Promise<Set<string>> {
    // src/pages, whether the build runs from the site directory or the repo root.
    const candidates = [
      join(process.cwd(), "src", "pages"),
      join(process.cwd(), "vivid-smiles-website", "src", "pages"),
    ];

    let files: string[] | null = null;

    for (const dir of candidates) {
      try {
        files = await astroFilesIn(dir);
        break;
      } catch {
        // Not this one. Try the next.
      }
    }

    // Better to stop than to guess: an empty set here would let a WordPress
    // page claim a designed page's URL and overwrite it in the output.
    if (!files) {
      throw new Error(
        "[wp-pages] Could not find src/pages, so the routes that already have " +
          "a hand-built template are unknown. Refusing to build WordPress pages.",
      );
    }

    const routes = new Set<string>();

    for (const file of files) {
      // Dynamic routes, this file included — they own no fixed path.
      if (file.includes("[")) continue;

      const route = file.replace(/\.astro$/, "").replace(/(^|\/)index$/, "");
      routes.add(route ? `/${route}/` : "/");
    }

    return routes;
  }

  const data = await wpQuery<{ pages: { nodes: WpPage[] } | null }>(
    PAGES_QUERY,
    { first: 200 },
    "pages for catch-all route",
  );

  const handBuilt = await handBuiltRoutes();
  const claimed = new Set<string>();

  return (data.pages?.nodes ?? []).flatMap((page) => {
    const uri = page.uri ?? "";

    // No usable URL means there is nothing to build.
    if (!uri.startsWith("/")) return [];

    const route = uri.endsWith("/") ? uri : `${uri}/`;

    // The home page belongs to index.astro whatever WordPress thinks.
    if (route === "/") return [];

    // A designed template always wins.
    if (handBuilt.has(route)) return [];

    // Two pages can end up sharing a URL after a slug edit. The first wins,
    // rather than both writing to the same file.
    if (claimed.has(route)) return [];
    claimed.add(route);

    const content = (page.content ?? "").trim();

    // An empty body means the page exists to feed fields into a hand-built
    // template, not to be read on its own. Publishing a blank URL would be
    // worse than leaving it out, so it is skipped and named in the log.
    if (!content) {
      console.warn(`[wp-pages] ${route} has no body content — not building it.`);
      return [];
    }

    return [
      {
        params: { slug: route.slice(1, -1) },
        props: { title: page.title ?? "Untitled", content },
      },
    ];
  });
}) satisfies GetStaticPaths;

interface Props {
  title: string;
  content: string;
}

const { title, content } = Astro.props;

// Body images are authored against the CMS host. Rewriting them here downloads
// each at build time and swaps in a hashed local asset, exactly as the blog
// does — otherwise a "static" page keeps a runtime dependency on WordPress.
const bodyHtml = await optimizeBodyImages(content);

// This page has no SEO fields to read: it was never wired to the field group
// the designed pages use. A description taken from the opening copy beats the
// site-wide default repeated on every page an editor adds.
const description = content
  .replace(/<[^>]+>/g, " ")
  .replace(/\s+/g, " ")
  .trim()
  .slice(0, 155);
---

<BaseLayout title={`${title} | Vivid Smiles Dentistry`} description={description || undefined}>
  <div class="wp-page">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="here">{title}</span>
      </div>
    </nav>

    <main id="main">
      <header class="wp-page-hero" data-vs-reveal-batch>
        <div class="wrap">
          <h1 class="vs-h1">{title}</h1>
        </div>
      </header>

      <section class="wp-page-body">
        <div class="wrap">
          <div class="wp-page-prose" data-vs-reveal set:html={bodyHtml}></div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
