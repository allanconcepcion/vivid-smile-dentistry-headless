---
/**
 * Every WordPress page that has no hand-built route of its own.
 *
 * The 35 templates under src/pages are bespoke: each one's stylesheet assumes a
 * fixed structure, which is why page copy is edited in WordPress but page
 * LAYOUT is not. The gap that left: a page an editor creates in wp-admin had no
 * route, so it 404'd on the front end and was dropped from the sitemap with a
 * warning nobody reads.
 *
  *  This closes it. Any page in the pages collection whose URL no template
 * already owns is built here, in the site's shell, from the same fields the
 * designed templates read. Nothing about those pages changes — a static route
 * always wins, and the guard below makes that explicit rather than relying on
 * Astro's route priority.
 *
 * Note there is no post_content to fall back on: vs-content-model.php calls
 * remove_post_type_support('page', 'editor') on purpose, so a page IS its
 * fields. Sections, process steps, FAQs and cards are what an editor fills in,
 * and they are what gets rendered here.
 *
 * It is a floor, not a ceiling: the right typography in the right shell. A page
 * that matters still deserves its own template.
 *
 * ONE COST, STATED RATHER THAN DISCOVERED LATER. Importing PageBlocks below is a
 * STATIC import, so Astro attaches the whole 17-block CSS graph to every page
 * this route builds — including a page that has no blocks and renders the
 * repeater fallback. Measured on a real catch-all page: 117,106 bytes of
 * render-blocking CSS becomes 296,847, of which 177,972 is the block bundle.
 * The branch is a runtime ternary; the module graph is not, and a dynamic
 * import cannot supply a component to Astro's template compiler.
 *
 * Accepted, for now, because it costs nothing today and the trade is the right
 * way round tomorrow: this route builds ZERO pages at present (every WordPress
 * page has a hand-built template that wins), and the pages it exists to create
 * are blocks pages, which need that CSS. The page that overpays is the legacy
 * shape — repeaters, no blocks — and none exists. If that changes, the fix is
 * to split this into two routes rather than to make the import conditional.
 */
import { readdir } from "node:fs/promises";
import { join } from "node:path";
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBlocks from "../blocks/PageBlocks.astro";
import { optimizeBodyImages } from "../lib/wp-body-images";
import { getPageContent } from "../lib/page-content";
import { fillSiteTokens } from "../blocks/site-tokens";
/**
 * Imported at module scope, not inside the component, because getStaticPaths is
 * lifted out of this frontmatter and only module imports come with it — see the
 * note above the function. `hasCopy` calls it.
 *
 * manifest.ts, never registry.ts: manifest.ts:1-20 exists precisely so that
 * something can KNOW about layouts without pulling the 17 block components —
 * and their ~62 kB of scoped CSS — into the importer's module graph.
 */
import { isRegisteredLayout } from "../blocks/manifest";
import "../styles/pages/wp-page.css";
/**
 * The blocks branch's cascade. Everything a designed page's namespace element
 * supplies and a blank page has none of; see the file's own header. Ordered
 * after wp-page.css deliberately, though nothing in the two ties: the sheets
 * share no selector, and the blocks branch renders `.wp-blocks`, which
 * `.wp-page .wrap` cannot match.
 */
import "../styles/pages/wp-page-blocks.css";

type PageData = CollectionEntry<"pages">["data"];

/**
 * Astro lifts getStaticPaths out of this frontmatter so it can be called
 * without rendering the component, and only the imports above come with it —
 * a const declared out here is not in scope by the time it runs. Everything
 * this function needs is therefore declared inside it.
 */
export const getStaticPaths = (async () => {
  /**
   * Every .astro file below a directory, as a path relative to it.
   *
   * Read from disk rather than globbed. A Vite glob for every .astro file in
   * this directory matches this file too, which hands the bundler a page that
   * imports itself. Reading the directory keeps the list generated rather than
   * hardcoded, without putting pages into each other's import graph.
   */
  async function astroFilesIn(dir: string, prefix = ""): Promise<string[]> {
    const found: string[] = [];

    for (const entry of await readdir(dir, { withFileTypes: true })) {
      const relative = prefix ? `${prefix}/${entry.name}` : entry.name;

      if (entry.isDirectory()) {
        found.push(...(await astroFilesIn(join(dir, entry.name), relative)));
      } else if (entry.name.endsWith(".astro")) {
        found.push(relative);
      }
    }

    return found;
  }

  /** Every route already served by a hand-built template. */
  async function handBuiltRoutes(): Promise<Set<string>> {
    // src/pages, whether the build runs from the site directory or the repo root.
    const candidates = [
      join(process.cwd(), "src", "pages"),
      join(process.cwd(), "vivid-smiles-website", "src", "pages"),
    ];

    let files: string[] | null = null;

    for (const dir of candidates) {
      try {
        files = await astroFilesIn(dir);
        break;
      } catch {
        // Not this one. Try the next.
      }
    }

    // Better to stop than to guess: an empty set here would let a WordPress
    // page claim a designed page's URL and overwrite it in the output.
    if (!files) {
      throw new Error(
        "[wp-pages] Could not find src/pages, so the routes that already have " +
          "a hand-built template are unknown. Refusing to build WordPress pages.",
      );
    }

    const routes = new Set<string>();

    for (const file of files) {
      // Dynamic routes, this file included — they own no fixed path.
      if (file.includes("[")) continue;

      const route = file.replace(/\.astro$/, "").replace(/(^|\/)index$/, "");
      routes.add(route ? `/${route}/` : "/");
    }

    return routes;
  }

  const entries = await getCollection("pages");
  const handBuilt = await handBuiltRoutes();
  const claimed = new Set<string>();

  return entries.flatMap((entry) => {
    const raw = entry.data.route;

    // No usable URL means there is nothing to build.
    if (!raw.startsWith("/")) return [];

    const route = raw.endsWith("/") ? raw : `${raw}/`;

    // The home page belongs to index.astro whatever WordPress thinks.
    if (route === "/") return [];

    // A designed template always wins.
    if (handBuilt.has(route)) return [];

    // Two pages can end up sharing a URL after a slug edit. The first wins,
    // rather than both writing to the same file.
    if (claimed.has(route)) return [];
    claimed.add(route);

    // A page with nothing in any field still gets built.
    //
    // It used to be skipped, on the reasoning that a URL with only a heading on
    // it is worse than no URL at all. In practice the opposite was true: the
    // editor had already published the page, so the address existed and was
    // being handed out, and skipping it produced a 404 plus a silent drop from
    // the sitemap — a worse failure than a thin page, and a much harder one to
    // notice. Building it puts the page where the editor put it; filling it in
    // is then an ordinary edit rather than a mystery.
    //
    // Note tocLinks counts as copy. It did not before, so a page using only the
    // "On this page" tab was skipped as empty.
    //
    // The tab arithmetic, recounted against cms/mu-plugins/vs-content-model.php
    // because the number here was stale. Eight tabs exist (:1125, :1154, :1189,
    // :1258, :1320, :1372, :1409, :1559). A newly created page could already
    // use FIVE of them — On this page, Process, Section copy, Cards & lists,
    // FAQ — and three did nothing: Images (this route never reads
    // `page.images`), Hero (not on the pages schema and not in
    // src/loaders/pages.ts, so it never crosses into Astro at all) and Page
    // sections. This change makes Page sections the sixth that works, leaving
    // two that do not.
    //
    // `blocks` is tested with isRegisteredLayout, NOT `.length > 0`, and the
    // difference is the whole point of the line. A row whose layout this build
    // has no component for renders as nothing (PageBlocks.astro:229-231), so a
    // page whose only rows are unregistered layouts really does ship hero-only
    // and the "title-only" log SHOULD fire for it. Asking the registry is the
    // same question src/lib/page-content.ts:253 asks, for the same reason
    // recorded at :243-252.
    //
    // Safe to read raw here even though the rest of this file goes through
    // getPageContent for `unwrapSelects` (see the component frontmatter):
    // `__typename` is a GraphQL meta field, guaranteed present and a string by
    // UNKNOWN_BLOCK = z.looseObject({ __typename: z.string().min(1) })
    // (src/content.config.ts:168), and never array-shaped — so it is the one
    // sub-field the missing unwrap cannot corrupt.
    const { sections, processSteps, faqs, cards, tocLinks, blocks } = entry.data;
    const hasCopy =
      blocks.some((b) => isRegisteredLayout(b.__typename)) ||
      sections.some((s) => s.heading.trim() || s.body.trim()) ||
      processSteps.length > 0 ||
      faqs.length > 0 ||
      cards.length > 0 ||
      tocLinks.length > 0;

    // Named in the log so an empty page is discoverable from the build output
    // rather than by clicking. Informational: it is not a failure.
    if (!hasCopy) {
      console.info(`[wp-pages] ${route} has no content in any field — building it title-only.`);
    }

    // `route` travels in props because the component needs the normalized key
    // to call getPageContent, and this is the copy that cannot drift: it was
    // normalized at the top of this closure (trailing slash guaranteed) from
    // the same entry the props carry. Astro.url.pathname would be a second
    // source of truth for the same fact.
    return [{ params: { slug: route.slice(1, -1) }, props: { page: entry.data, route } }];
  });
}) satisfies GetStaticPaths;

interface Props {
  page: PageData;
  route: string;
}

const { page, route } = Astro.props;

/**
 * The ordered section list, read through getPageContent rather than off
 * `page.blocks` — and that is not a stylistic preference.
 *
 * `unwrapSelects` (src/lib/page-content.ts:156-199) runs only inside
 * getPageContent, and its header records the consequence of skipping it as a
 * SHIPPED defect: WPGraphQL returns every ACF select as a list, so `band`
 * arrives as ["charcoal"], eight components test `typeof band === "string"`,
 * and every one of them silently falls back to its default. Two charcoal bands
 * shipped as paper on /cosmetic-dentistry/clear-aligners/ and the word-level
 * diff reported zero differences, because a band that loses its modifier class
 * keeps all of its words. Reading `page.blocks` here would reintroduce exactly
 * that on every page this branch exists to create.
 *
 * `hasBlocks` comes from the same call for the same reason: it is defined once
 * (page-content.ts:243-253) as "does the registry know how to draw any of
 * these", never `blocks.length > 0`, so that a page migrated against a layout
 * that has not shipped yet degrades to "not migrated" instead of going blank.
 * Restating it here is what page-content.ts:101-104 forbids.
 *
 * It cannot throw for a route built here: getPageContent throws only when
 * getEntry misses (:216-222), and `route` came out of getCollection("pages") in
 * getStaticPaths above.
 */
const { blocks, hasBlocks } = await getPageContent(route);

/**
 * THE TWO CONTAINER DECISIONS IN THE MARKUP BELOW, since neither can carry its
 * own comment: a `{/* … *\/}` in a position that has none today would leave a
 * permanent whitespace text node in the output, and whitespace is a real diff.
 *
 * 1. THE SHELL CLASS IS A CASCADE SWITCH, not decoration.
 *    `.wp-page .wrap` (src/styles/pages/wp-page.css:12-16) is (0,2,0), and every
 *    block's own scoped `.wrap` compiles to `.wrap[data-astro-cid-…]`, also
 *    (0,2,0) — 14 blocks declare one. Astro compiles ATTRIBUTE scoping, not
 *    :where(), so those TIE and bundle order decides it, which this project has
 *    already paid for twice. The values differ on both properties: 1280px
 *    (--vs-container-max, tokens.css:64) vs 1240px, and clamp(20px,5vw,48px) vs
 *    0 40px. Renaming the root on the blocks branch puts wp-page.css out of
 *    reach entirely rather than out-specifying it.
 *
 * 2. THE HERO'S CONTAINER CHANGES WITH IT. `.wp-page-hero` (wp-page.css:18-20)
 *    is a single-class rule and applies on both branches, but its inner
 *    `<div class="wrap">` gets its geometry solely from `.wp-page .wrap` — which
 *    decision 1 just removed. A bare `.wrap` has no global rule (checked:
 *    src/styles/global.css declares none), so it would render full-bleed and
 *    unpadded. `.wp-blocks-wrap` supplies the BLOCKS' geometry rather than
 *    wp-page's, so the H1 aligns with the bands directly beneath it; wp-page's
 *    container would leave it 20px outboard of every band edge.
 *
 * The hero itself stays outside the switch, unconditionally, and that is
 * mechanical rather than aesthetic: `grep -n "<h1" src/blocks/*.astro` and the
 * seven code-owned bands returns ZERO matches — every block heads itself with
 * an <h2>. Drop the hero and a blocks-composed page ships with no <h1> at all,
 * on precisely the pages this branch exists to create.
 */

/**
 * A field's copy as HTML.
 *
 * A wysiwyg field arrives as HTML; a plain textarea does not, and handing raw
 * text to set:html would collapse every paragraph into one. Images inside the
 * HTML go through the asset pipeline, exactly as the blog's do — otherwise a
 * "static" page keeps a runtime dependency on WordPress.
 */
async function toHtml(value: string): Promise<string> {
  const copy = value.trim();
  if (!copy) return "";

  if (!copy.includes("<")) {
    return copy
      .split(/\n\s*\n/)
      .map((paragraph) => `<p>${paragraph.trim().replace(/\n/g, "<br />")}</p>`)
      .join("");
  }

  return await optimizeBodyImages(copy);
}

const sections = await Promise.all(
  page.sections
    .filter((section) => section.heading.trim() || section.body.trim())
    .map(async (section) => ({ ...section, html: await toHtml(section.body) })),
);

const steps = await Promise.all(
  page.processSteps.map(async (step) => ({ ...step, html: await toHtml(step.body) })),
);

const faqs = await Promise.all(
  page.faqs.map(async (faq) => ({ ...faq, html: await toHtml(faq.a) })),
);

// Cards are grouped by the field array they came from, the same way
// getPageContent groups them for the designed templates.
const cardGroups = new Map<string, PageData["cards"]>();
for (const card of page.cards) {
  cardGroups.set(card.group, [...(cardGroups.get(card.group) ?? []), card]);
}

/**
 * The first RENDERED band's body, as a meta description.
 *
 * `sections` is empty on a page composed only of blocks, so the existing
 * fallback yields undefined and the page ships the site-wide default on every
 * page an editor adds. `body` is the honest substitute: docs/PAGE-BLOCKS.md:92
 * makes it a textarea that is plain text, no tags ever, so it needs collapsing
 * but no stripping. Nested rows are skipped — they are drawn inside the band
 * above (PageBlocks.astro:146-177) and are not the page's opening sentence.
 * `code_section` carries no `body` at all — its selection set is the three
 * fields at manifest.ts:1103-1110 and never grows — so it never matches.
 *
 * `heading` is deliberately not a candidate: docs/PAGE-BLOCKS.md:87 permits
 * <em> inside it, so it would need stripping, and a bare heading is a label
 * rather than a description.
 */
const blockBody = blocks.find(
  (b) => !b?.nested && typeof b.body === "string" && b.body.trim() !== "",
)?.body as string | undefined;

const blockDescription = blockBody
  ? blockBody.replace(/\s+/g, " ").trim().slice(0, 155)
  : undefined;

const sectionDescription = sections[0]?.html
  .replace(/<[^>]+>/g, " ")
  .replace(/\s+/g, " ")
  .trim()
  .slice(0, 155);

// Editor-managed SEO wins. Falling back to the opening copy beats the
// site-wide default repeated on every page an editor adds — but the fallback
// must describe what the page RENDERS, so the blocks branch never falls back to
// `sections`, whose rows it does not draw. On the non-blocks branch this is
// byte-identical to the single `description` it replaces.
const metaDescription =
  page.seo.description || (hasBlocks ? blockDescription : sectionDescription) || undefined;

/**
 * The visible lede, which is NOT the meta description on a blocks page.
 *
 * `description` was consumed twice — once as <meta name="description"> and once
 * as the <p class="vs-lede"> under the H1. Feeding a blocks page's derived
 * description to both would print the first band's opening sentence twice, ~40px
 * apart, the second copy cut mid-word at 155 characters. So a blocks page shows
 * a lede only when an editor wrote one in the SEO tab, and shows none otherwise.
 *
 * An all-`code_section` page has no `body` anywhere, so `blockDescription` is
 * undefined and BaseLayout's site-wide default stands. That is the honest
 * answer; reaching into `sections` to fill it would describe rows the page does
 * not draw.
 */
const heroLede = hasBlocks ? page.seo.description || undefined : metaDescription;

/**
 * FAQPage follows the same switch the visible accordion does — never a merge
 * and never a fallback-when-empty. A FAQPage listing questions the page does
 * not answer is worse than no FAQPage at all, so an empty list emits no script.
 * Modelled on emergency-dentistry/index.astro:325-334, which is the correct
 * model; clear-aligners.astro:667-680 is the pilot page and still reads the
 * pre-migration `faqs` array, a known pre-existing gap (block-map.json:10960).
 *
 * Every field is read defensively: an ACF row an editor has never saved comes
 * back null, and `null.trim()` on a live route is a failed build. Annotated
 * rather than inferred, because the ternary otherwise collapses to a union of
 * two array types that TypeScript will not let you call .map() on.
 *
 * `answer` goes through fillSiteTokens (src/blocks/site-tokens.ts:39) because
 * stored answers carry `{phone}` / `{phone_href}` under the href policy —
 * without it the schema ships literal braces to a search engine. The shared
 * helper rather than a local token table: emergency-dentistry/index.astro:295-308
 * and contact/index.astro both keep a hand-rolled copy and both record "switch
 * to fillSiteTokens once it lands". It has landed.
 */
const faqSchemaItems: Array<{ q: string; a: string }> = hasBlocks
  ? blocks
      .filter((b) => !b?.nested && b?.__typename === "PageFieldsBlocksFaqLayout")
      .flatMap((b) => (Array.isArray(b.items) ? (b.items as unknown[]) : []))
      .map((row) => (row ?? {}) as { question?: unknown; answer?: unknown })
      .map((row) => ({
        q: typeof row.question === "string" ? row.question : "",
        a: typeof row.answer === "string" ? fillSiteTokens(row.answer) : "",
      }))
      .filter((row) => row.q !== "")
  : faqs.map((f) => ({ q: f.q, a: f.a }));

// DO NOT ADD `blocks` TO hasBody. It guards `.wp-page-body`, and the block run
// must never live inside that wrapper — the shell below records both reasons.
// A blocks-only page evaluating hasBody === false is correct and required; the
// PageBlocks branch is a SIBLING of this gate, not a child of it.
//
// A page whose fields are all empty renders as hero only. Without this the
// body wrapper still emits, and its padding leaves a tall blank slab under the
// heading that reads as a broken page rather than an unfinished one.
const hasBody =
  page.tocLinks.length > 0 ||
  sections.length > 0 ||
  steps.length > 0 ||
  cardGroups.size > 0 ||
  faqs.length > 0;
---

<BaseLayout
  title={page.seo.title || `${page.title} | Vivid Smiles Dentistry`}
  description={metaDescription}
  noindex={page.seo.noindex}
  ogImage={page.seo.ogImage || undefined}>
  <div class={hasBlocks ? "wp-blocks" : "wp-page"}>
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="here">{page.title}</span>
      </div>
    </nav>

    <main id="main">
      {/* ---------- HERO ---------- */}
      <header class="wp-page-hero" data-vs-reveal-batch>
        <div class={hasBlocks ? "wp-blocks-wrap" : "wrap"}>
          <h1 class="vs-h1">{page.title}</h1>
          {heroLede && <p class="vs-lede">{heroLede}</p>}
        </div>
      </header>

      {hasBlocks ? <PageBlocks blocks={blocks} route={route} /> : hasBody && (
        <div class="wp-page-body">
          <div class="wrap">
            {page.tocLinks.length > 0 && (
              <aside class="wp-page-toc" aria-label="On this page">
                <span class="wp-page-toc-label">On this page</span>
                <ul>
                  {page.tocLinks.map((link) => (
                    <li><a href={link.href}>{link.label}</a></li>
                  ))}
                </ul>
              </aside>
            )}

            {sections.map((section) => (
              <section class="wp-page-section" id={section.section_id || undefined} data-vs-reveal>
                {section.eyebrow && <span class="wp-page-eyebrow">{section.eyebrow}</span>}
                {section.heading && <h2 class="vs-h3">{section.heading}</h2>}
                {section.html && <div class="wp-page-prose" set:html={section.html}></div>}
                {section.cta_label && section.cta_href && (
                  <a class="wp-page-cta" href={section.cta_href}>{section.cta_label}</a>
                )}
              </section>
            ))}

            {steps.length > 0 && (
              <section class="wp-page-section" data-vs-reveal>
                <ol class="wp-page-steps">
                  {steps.map((step) => (
                    <li>
                      {step.tag && <span class="wp-page-step-tag">{step.tag}</span>}
                      <h3 class="wp-page-step-title">{step.title}</h3>
                      {step.html && <div class="wp-page-prose" set:html={step.html}></div>}
                    </li>
                  ))}
                </ol>
              </section>
            )}

            {Array.from(cardGroups).map(([group, cards]) => (
              <section class="wp-page-section" data-vs-reveal>
                <ul class="wp-page-cards" data-group={group}>
                  {cards.map((card) => (
                    <li>
                      {card.meta && <span class="wp-page-card-meta">{card.meta}</span>}
                      <h3 class="wp-page-card-title">
                        {card.href ? <a href={card.href}>{card.title}</a> : card.title}
                      </h3>
                      {card.body && <p>{card.body}</p>}
                    </li>
                  ))}
                </ul>
              </section>
            ))}

            {faqs.length > 0 && (
              <section class="wp-page-section" data-vs-reveal>
                <h2 class="vs-h3">Frequently asked questions</h2>
                <div class="wp-page-faqs">
                  {faqs.map((faq) => (
                    <details open={faq.open}>
                      <summary>{faq.q}</summary>
                      <div class="wp-page-prose" set:html={faq.html}></div>
                    </details>
                  ))}
                </div>
              </section>
            )}
          </div>
        </div>
      )}
    </main>
  </div>

  {/*
    BOTH SCRIPTS ARE NEW, ON BOTH BRANCHES, AND NEITHER CAN REGRESS ANYTHING.
    This route emits zero JSON-LD today — `grep -c "application/ld+json"` on
    this file before the change returned 0 — despite rendering a visible
    breadcrumb since it was written and a visible FAQ accordion below. There is
    no baseline to move. Placed at the tail of the BaseLayout slot so the text
    nodes around them land directly in <body>, outside any flex or grid
    container, rather than inside a band's `.wrap` where a stray node collapses
    a margin.

    `new URL(route, Astro.site)` is safe: `route` arrives from getStaticPaths
    already normalized with a leading AND trailing slash. Note BaseLayout.astro:49
    derives `canonical` from Astro.url.pathname and declares no canonical prop,
    so `page.seo.canonical` stays unread here — site-wide and pre-existing, out
    of scope for this change.
  */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).href },
      { "@type": "ListItem", "position": 2, "name": page.title, "item": new URL(route, Astro.site).href },
    ],
  })} />

  {faqSchemaItems.length > 0 && <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqSchemaItems.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a },
    })),
  })} />}
</BaseLayout>
