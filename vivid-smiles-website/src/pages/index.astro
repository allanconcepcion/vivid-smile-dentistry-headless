---
/**
 * Home page — Vivid Smiles Dentistry, Parker CO.
 *
 * Page-scoped styles: src/styles/pages/home.css
 * Buttons + scroll reveals wired by src/scripts/animations.js
 *   (data-vs-arrow, data-vs-reveal*).
 */
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import ArrowBadge from "../components/ArrowBadge.astro";
import ReviewMarquee from "../components/ReviewMarquee.astro";
import VirtualConsult from "../components/VirtualConsult.astro";
import {
  phoneHref,
  bookNowHref,
  phoneE164,
  emailAddress,
  addressStreet,
  addressCity,
  addressState,
  addressZip,
} from "../data/contact";
import { openingHoursSpecification } from "../data/hours";
import "../styles/pages/home.css";

// Reviews — newest first by frontmatter date (schema coerces to Date)
const reviews = (await getCollection("reviews"))
  .sort((a, b) => +b.data.date - +a.data.date);

// Hero / team
import heroBg from "../assets/images/team/vivid-smiles-team-candid.webp";
const teamPhoto = heroBg;

// Trust bar logos
import logoAACD from "../assets/images/credentials/american-academy-of-cosmetic-dentistry.webp";
import logoAAID from "../assets/images/credentials/american-academy-of-implant-dentistry.webp";
import logoFAM from "../assets/images/credentials/full-arch-masters.webp";
import logoYomi from "../assets/images/facility/yomi-robotics.webp";
import logoADA from "../assets/images/credentials/american-dental-association.webp";
import logoGoogle from "../assets/images/credentials/google-reviews.png";

// Service cards — mirror the services hub mappings (src/assets/images/procedures/)
import imgVeneers from "../assets/images/procedures/veneer-application-brush-macro.webp";
import imgImplants from "../assets/images/procedures/implant-prosthesis-underside.webp";
import imgGeneral from "../assets/images/procedures/hygienist-polishing-teeth.webp";
import imgEmergency from "../assets/images/procedures/same-day-emergency-dental-care.webp";

// Doctor portrait
import drPortrait from "../assets/images/team/dr-bryce-richardson.webp";

// Smile gallery marquee — sourced dynamically from the central
// src/assets/images/smiles/ folder via the loader; drop/remove
// files there and the home strip updates automatically on the next build.
import { getSmiles } from "../lib/smiles";

// Tech section
import techYomi from "../assets/images/procedures/dr-richardson-performing-yomi-guided-implant-surgery.webp";
import techVeneerShells from "../assets/images/procedures/veneer-shells-backlit-white.webp";

// Patient stories — cosmetic veneer shorts (vertical 9:16 source)
import storyVeneersMore from "../assets/images/video-stories/veneers-story-more-than-a-smile.webp";
import storyVeneersConfidence from "../assets/images/video-stories/veneers-story-confidence-restored.webp";
import storyVeneersLength from "../assets/images/video-stories/veneers-story-length-and-balance.webp";

// Notable patients — Denver Broncos cheerleaders (real patient portraits)
import notableAnnMarie from "../assets/images/people/real/ann-marie-muscarello-veneer-makeover.webp";
import notableBrittany from "../assets/images/people/real/brittany-fanning-smile-makeover.webp";
import { getPageContent } from '../lib/page-content';
// Section copy is edited in WordPress (Pages -> this page -> Section copy).
const { section, image, seo } = await getPageContent(Astro.url.pathname);


const galleryTiles = getSmiles();

// Duplicate the marquee track once so the loop seam is invisible
const galleryTrack = [...galleryTiles, ...galleryTiles];

const trustBar = [
  { logo: logoAACD, alt: "American Academy of Cosmetic Dentistry", title: "AACD", sub: "Accredited Member" },
  { logo: logoAAID, alt: "American Academy of Implant Dentistry", title: "AAID", sub: "Implant Dentistry" },
  { logo: logoFAM, alt: "Full Arch Masters", title: "Full Arch Masters", sub: "Clinical Mentor" },
  { logo: logoYomi, alt: "Yomi Robotics", title: "Yomi Robotics", sub: "Certified Surgeon" },
  { logo: logoADA, alt: "American Dental Association", title: "ADA", sub: "American Dental Association" },
  { logo: logoGoogle, alt: "Google Reviews", title: "5.0 · 300+ Reviews", sub: "Google Verified" },
];

// Duplicate trust bar so the marquee animation has seamless loop content
const trustTrack = [...trustBar, ...trustBar];

---

<BaseLayout
  title={seo.title || "Vivid Smiles Dentistry — Cosmetic & Implant Dentistry, Parker CO"}
  description={seo.description || "Cosmetic, implant, general, and emergency dentistry in Parker, Colorado. Calm, premium, patient-centered care."}
 noindex={seo.noindex}>
  <div class="home">

    <main id="main">

    {/* ---------- HERO ---------- */}
    <section class="hero">
      <div class="hero-card">
        <div class="hero-bg" aria-hidden="true">
          <Image
            src={image("heroBg").url} width={image("heroBg").width} height={image("heroBg").height}
            alt="The Vivid Smiles Dentistry team"
            widths={[1280, 1920, 2560]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>

        <div class="hero-rails">
          <span class="rail">Cosmetic &amp; Implant Dentistry</span>
          <span class="rail right">Parker, Colorado · Est. 5-Star</span>
        </div>

        <div class="hero-copy" data-vs-reveal-batch>
          <span class="eyebrow">Where artistry meets dentistry</span>
          <h1>
            Smile boldly<span class="period">.</span>
            <span class="ln2"><em class="vs-italic-word">Live vividly</em><span class="period">.</span></span>
          </h1>
          <p class="hero-sub">
            Parker's highest-rated cosmetic and implant practice. From routine cleanings to no-prep
            veneers and Yomi-robot assisted implants. Dr. Bryce Richardson and our 5-star team are
            now accepting new patients.
          </p>
          <div class="hero-actions">
            <Button variant="sage" href="#virtualConsult" hoverLabel="Let's Talk">Free Virtual Consult</Button>
            <Button variant="ghost-light" href="/smile-gallery/" hoverLabel="View Gallery">See Our Work</Button>
          </div>
        </div>

        <div class="hero-glass tl" data-vs-reveal>
          <div><span class="stars">★★★★★</span></div>
          <div class="div"></div>
          <div>
            <div class="num">5.0</div>
            <div class="lbl">300+ Reviews</div>
          </div>
        </div>

        <div class="hero-glass tr" data-vs-reveal>
          <span class="accept-dot" aria-hidden="true"></span>
          <div class="text">Now accepting <em>new patients</em></div>
        </div>
      </div>
    </section>

    {/* ---------- TRUST BAR ---------- */}
    <section class="trust" aria-label="Credentials and memberships">
      <div class="trust-card" data-vs-reveal>
        <div class="trust-label">Accredited by</div>
        <div class="trust-track">
          <div class="trust-strip">
            {trustTrack.map((t, i) => {
              const isClone = i >= trustBar.length;
              return (
                <>
                  <div class="trust-item" aria-hidden={isClone || undefined} inert={isClone || undefined}>
                    <span class="trust-logo"><Image src={t.logo} alt={t.alt} /></span>
                    <span class="trust-text"><b>{t.title}</b><small>{t.sub}</small></span>
                  </div>
                  <span class="trust-sep" aria-hidden="true"></span>
                </>
              );
            })}
          </div>
        </div>
      </div>
    </section>

    {/* ---------- SERVICES ---------- */}
    <section class="services" id="services">
      <div class="wrap">
        <div class="services-head" data-vs-reveal-batch>
          <div class="left">
            <span class="eyebrow">{section("services").eyebrow}</span>
            <h2><Fragment set:html={section("services").heading} /></h2>
          </div>
          <div class="right">
            <p>{section("services").body}</p>
            <Button variant="ghost" href="/services/" hoverLabel="Browse All">View All Services</Button>
          </div>
        </div>

        <div class="services-shell" data-vs-reveal-batch>
          <a class="svc-card featured" href="/cosmetic-dentistry/" data-vs-arrow>
            <div class="svc-img">
              <Image src={image("imgVeneers").url} width={image("imgVeneers").width} height={image("imgVeneers").height} alt="Cosmetic dentist applying a porcelain veneer with a fine brush — close-up of polished white teeth" widths={[800, 1200, 1600]} sizes="100vw" />
            </div>
            <span class="svc-tag">Our Signature Work</span>
            <div class="svc-body">
              <p class="svc-desc">
                No-prep and minimal-prep veneers designed with our proprietary Vivid Smile Cosmetic Process.
                Previewed, refined, and delivered so the result feels effortless and unmistakably yours.
              </p>
              <div class="svc-row-bot">
                <h3>Cosmetic &amp; Veneers</h3>
                <ArrowBadge size="xl" variant="ghost-light" />
              </div>
            </div>
          </a>

          <a class="svc-card compact" href="/implant-dentistry/" data-vs-arrow>
            <div class="svc-img">
              <Image src={image("imgImplants").url} width={image("imgImplants").width} height={image("imgImplants").height} alt="An implant-supported restoration held on a dental model" widths={[600, 900, 1200]} sizes="(max-width: 780px) 100vw, 33vw" />
            </div>
            <span class="svc-tag">Yomi&nbsp;Robotic</span>
            <div class="svc-body">
              <p class="svc-desc">
                Single-tooth to full-arch implants, placed with Yomi robotic precision and restored to feel like your own.
              </p>
              <div class="svc-row-bot">
                <h3>Implants</h3>
                <ArrowBadge size="xl" variant="ghost-light" />
              </div>
            </div>
          </a>

          <a class="svc-card compact" href="/general-dentistry/" data-vs-arrow>
            <div class="svc-img">
              <Image src={image("imgGeneral").url} width={image("imgGeneral").width} height={image("imgGeneral").height} alt="Hygienist polishing a patient's teeth during a cleaning" widths={[600, 900, 1200]} sizes="(max-width: 780px) 100vw, 33vw" style="object-position: center 25%" />
            </div>
            <span class="svc-tag">Cleanings&nbsp;&amp;&nbsp;Care</span>
            <div class="svc-body">
              <p class="svc-desc">
                Six-month exams, hygiene, fillings and crowns, handled with the same craftsmanship as our cosmetic work.
              </p>
              <div class="svc-row-bot">
                <h3>General Dentistry</h3>
                <ArrowBadge size="xl" variant="ghost-light" />
              </div>
            </div>
          </a>

          <a class="svc-card compact" href="/emergency-dentistry/" data-vs-arrow>
            <div class="svc-img">
              <Image src={image("imgEmergency").url} width={image("imgEmergency").width} height={image("imgEmergency").height} alt="Same-day emergency dental care" widths={[600, 900, 1200]} sizes="(max-width: 780px) 100vw, 33vw" />
            </div>
            <span class="svc-tag">Same-Day</span>
            <div class="svc-body">
              <p class="svc-desc">
                Same-day appointments for breaks, pain, or trauma. Call before noon and we'll see you today.
              </p>
              <div class="svc-row-bot">
                <h3>Emergency Care</h3>
                <ArrowBadge size="xl" variant="ghost-light" />
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

    {/* ---------- PATIENT STORIES ---------- */}
    <section class="stories" id="stories">
      <div class="wrap">
        <div class="stories-head" data-vs-reveal-batch>
          <span class="eyebrow">{section("stories").eyebrow}</span>
          <h2><Fragment set:html={section("stories").heading} /></h2>
          <p>{section("stories").body}</p>
        </div>

        <div class="stories-grid" data-vs-reveal-batch>
          <button type="button" class="story-card" data-video-id="Nm7RjGKP8jw" data-video-short="true" data-video-title="How veneers can change more than just your smile" aria-label="Play porcelain veneers patient story: more than a smile">
            <div class="story-photo">
              <Image src={image("storyVeneersMore").url} width={image("storyVeneersMore").width} height={image("storyVeneersMore").height} alt="Porcelain veneers patient — confident smile after treatment" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>More than a smile</h4>
              <p>Porcelain veneers can change far more than the way teeth look. See how the right cosmetic plan resets confidence and presence — at work, in photos, in everyday life.</p>
              <span class="label">Porcelain Veneers</span>
            </div>
          </button>
          <button type="button" class="story-card" data-video-id="EA19QZ4lk8k" data-video-short="true" data-video-title="Her confidence after veneers says everything" aria-label="Play porcelain veneers patient story: confidence after veneers">
            <div class="story-photo">
              <Image src={image("storyVeneersConfidence").url} width={image("storyVeneersConfidence").width} height={image("storyVeneersConfidence").height} alt="Porcelain veneers patient — close-up smile after treatment" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>Confidence, restored</h4>
              <p>A close look at what happens when the smile finally matches the person behind it. The veneers do their part — her confidence does the rest.</p>
              <span class="label">Porcelain Veneers</span>
            </div>
          </button>
          <button type="button" class="story-card" data-video-id="fRyN4dHhizo" data-video-short="true" data-video-title="How veneers can add length and improve your smile" aria-label="Play porcelain veneers patient story: length and balance">
            <div class="story-photo">
              <Image src={image("storyVeneersLength").url} width={image("storyVeneersLength").width} height={image("storyVeneersLength").height} alt="Porcelain veneers patient — after photo showing restored tooth length and balance" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>Length &amp; balance</h4>
              <p>Worn or short teeth can leave a smile looking aged or out of proportion. Watch how porcelain veneers restore length, symmetry, and a fuller, more natural finish.</p>
              <span class="label">Porcelain Veneers</span>
            </div>
          </button>
        </div>
      </div>

      <dialog class="story-video-modal" id="story-video-modal" aria-label="Patient story video">
        <button type="button" class="story-video-close" data-video-close aria-label="Close video">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <div class="story-video-frame" data-video-frame></div>
      </dialog>

      <script is:inline>
        (() => {
          const modal = document.getElementById("story-video-modal");
          if (!modal) return;
          const frame = modal.querySelector("[data-video-frame]");
          const closeBtn = modal.querySelector("[data-video-close]");
          const cards = document.querySelectorAll(".story-card[data-video-id]");

          const openVideo = (id, title, isShort) => {
            if (!id) return;
            const iframe = document.createElement("iframe");
            iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
            iframe.title = title || "Patient story video";
            iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
            iframe.allowFullscreen = true;
            iframe.loading = "lazy";
            frame.replaceChildren(iframe);
            modal.classList.toggle("is-short", !!isShort);
            if (typeof modal.showModal === "function") modal.showModal();
            else modal.setAttribute("open", "");
            document.body.style.overflow = "hidden";
          };

          const closeVideo = () => {
            frame.replaceChildren();
            modal.classList.remove("is-short");
            if (typeof modal.close === "function" && modal.open) modal.close();
            else modal.removeAttribute("open");
            document.body.style.overflow = "";
          };

          cards.forEach((card) => {
            card.addEventListener("click", () => {
              openVideo(card.dataset.videoId, card.dataset.videoTitle, card.dataset.videoShort === "true");
            });
          });

          closeBtn?.addEventListener("click", closeVideo);
          modal.addEventListener("click", (e) => {
            if (e.target === modal) closeVideo();
          });
          modal.addEventListener("close", closeVideo);
          modal.addEventListener("cancel", (e) => {
            e.preventDefault();
            closeVideo();
          });
        })();
      </script>
    </section>

    {/* ---------- NOTABLE PATIENTS ---------- */}
    <section class="notable" id="notable" aria-labelledby="notable-heading">
      <div class="wrap">
        <div class="notable-head" data-vs-reveal-batch>
          <span class="eyebrow">{section("notable").eyebrow}</span>
          <h2 id="notable-heading"><Fragment set:html={section("notable").heading} /></h2>
          <p>{section("notable").body}</p>
        </div>

        <div class="notable-grid" data-vs-reveal-batch>
          <figure class="notable-card">
            <div class="notable-photo">
              <Image src={image("notableAnnMarie").url} width={image("notableAnnMarie").width} height={image("notableAnnMarie").height} alt="Ann-Marie Muscarello — Denver Broncos cheerleader and Vivid Smiles cosmetic patient" widths={[420, 600, 800]} sizes="(max-width: 780px) 90vw, 480px" />
            </div>
            <figcaption>
              <span class="notable-tag">Denver Broncos Cheerleader</span>
              <h3>Ann-Marie Muscarello</h3>
              <p>Porcelain veneer makeover</p>
            </figcaption>
          </figure>

          <figure class="notable-card">
            <div class="notable-photo">
              <Image src={image("notableBrittany").url} width={image("notableBrittany").width} height={image("notableBrittany").height} alt="Brittany Fanning — Denver Broncos cheerleader and Vivid Smiles cosmetic patient" widths={[420, 600, 800, 1000]} sizes="(max-width: 780px) 90vw, 480px" />
            </div>
            <figcaption>
              <span class="notable-tag">Denver Broncos Cheerleader</span>
              <h3>Brittany Fanning</h3>
              <p>Smile makeover</p>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    {/* ---------- MEET THE DOCTOR ---------- */}
    <section class="doc" id="doctor">
      <div class="wrap">
        <div class="doc-grid">
          <div class="doc-imagery" data-vs-reveal>
            <div class="doc-portrait" data-vs-parallax data-parallax="-40">
              <Image src={image("drPortrait").url} width={image("drPortrait").width} height={image("drPortrait").height} alt="Dr. Bryce Richardson — editorial portrait" widths={[600, 900, 1200]} sizes="(max-width: 780px) 100vw, 50vw" />
            </div>
            <div class="signature">— Dr. Bryce</div>
            <div class="badge">
              <span class="stars">★★★★★</span>
              <span class="b-text">300+ five-star</span>
              <small>Google Verified</small>
            </div>
          </div>
          <div class="doc-copy" data-vs-reveal-batch>
            <span class="eyebrow">{section("doctor").eyebrow}</span>
            <h2><Fragment set:html={section("doctor").heading} /></h2>
            <p class="lead">{section("doctor").body}</p>
            <p class="bio">
              A distinguished graduate of Indiana University School of Dentistry, Dr. Richardson has completed
              more than 600 hours of advanced postgraduate training in esthetics, veneers, full-mouth rehab,
              and surgical dentistry. He is the creator of the Vivid Smile Cosmetic Process and a clinical
              mentor at Full Arch Masters, one of the nation's premier implant education programs.
            </p>

            <div class="doc-credentials">
              <div class="cred"><div class="k">IU</div><div class="v">School of Dentistry Graduate</div></div>
              <div class="cred"><div class="k">600+</div><div class="v">Hours Postgrad Training</div></div>
              <div class="cred"><div class="k">FAM</div><div class="v">Full Arch Masters Mentor</div></div>
            </div>

            <div class="doc-actions">
              <Button variant="sage" href="#virtualConsult" hoverLabel="Schedule Now">Get a Video Reply from Dr. Richardson</Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- SMILE GALLERY ---------- */}
    <section class="gallery" id="gallery">
      <div class="wrap">
        <div class="gallery-head" data-vs-reveal-batch>
          <span class="eyebrow light">Smile Gallery</span>
          <h2><Fragment set:html={section("gallery").heading} /></h2>
          <p>{section("gallery").body}</p>
          <div class="actions">
            <Button variant="sage" href={bookNowHref} hoverLabel="Book Yours">Book Online</Button>
            <Button variant="ghost-light" href="/smile-gallery/" hoverLabel="See Cases">View the Gallery</Button>
          </div>
        </div>
      </div>

      <div class="gallery-marquee" data-vs-marquee aria-label="Smile gallery">
        <div class="gallery-track" data-vs-marquee-track>
          {galleryTrack.map((tile, i) => {
            const isClone = i >= galleryTiles.length;
            return (
              <div class="smile-tile" aria-hidden={isClone || undefined} inert={isClone || undefined}>
                <Image src={tile.src} alt={tile.alt} widths={[420, 840]} sizes="420px" />
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* ---------- TECHNOLOGY ---------- */}
    <section class="tech" id="technology">
      <div class="wrap">
        <div class="tech-grid">
          <div class="tech-imagery" data-vs-reveal>
            <div class="stamp"><b>FDA</b><small>Cleared robotic system</small></div>
            <div class="ph-a" data-vs-parallax data-parallax="-50"><Image src={image("techYomi").url} width={image("techYomi").width} height={image("techYomi").height} alt="Dr. Bryce Richardson placing a dental implant with the Yomi robotic arm at Vivid Smiles Dentistry" widths={[600, 900, 1200]} sizes="50vw" /></div>
            <div class="ph-b" data-vs-parallax data-parallax="30"><Image src={image("techVeneerShells").url} width={image("techVeneerShells").width} height={image("techVeneerShells").height} alt="Porcelain veneer shells seated on a dental model, lit against white" widths={[400, 800]} sizes="30vw" /></div>
          </div>
          <div class="tech-copy" data-vs-reveal-batch>
            <span class="eyebrow">{section("technology").eyebrow}</span>
            <h2><Fragment set:html={section("technology").heading} /></h2>
            <p class="lead">{section("technology").body}</p>

            <div class="tech-list" data-vs-reveal-batch>
              <div class="tech-item">
                <div class="idx">01</div>
                <div>
                  <h4>Yomi-Robot Assisted Implants</h4>
                  <p>The only FDA-cleared robotic system for dental implants: sub-millimeter accuracy, smaller incisions, and faster recovery.</p>
                </div>
              </div>
              <div class="tech-item">
                <div class="idx">02</div>
                <div>
                  <h4>Digital Smile Design</h4>
                  <p>Facially-driven design software lets us preview your exact result before a tooth is ever touched.</p>
                </div>
              </div>
              <div class="tech-item">
                <div class="idx">03</div>
                <div>
                  <h4>3D CBCT Imaging</h4>
                  <p>High-resolution 3D scans replace guesswork with certainty for implants, airway analysis, and reconstruction.</p>
                </div>
              </div>
              <div class="tech-item">
                <div class="idx">04</div>
                <div>
                  <h4>Intra-Oral Scanning</h4>
                  <p>Goodbye to gooey impressions. Digital scans capture your mouth in seconds with micron-level fidelity.</p>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    {/* ---------- SIGNATURE PROCESS ---------- */}
    <section class="process">
      <div class="process-inner">
        <div class="process-head" data-vs-reveal-batch>
          <span class="eyebrow">The Vivid Smile Cosmetic Process</span>
          <h2>A smile you imagine should<br><em class="vs-italic-word">feel inevitable, not improvised.</em></h2>
          <span class="pcp">Our proprietary three-step method</span>
          <p>
            Every cosmetic case at Vivid Smiles moves through the same disciplined framework,
            so the final result feels effortless, precise, and unmistakably yours.
          </p>
        </div>

        <div class="process-card" data-vs-reveal>
          <div class="process-steps" data-vs-reveal-batch>
            <div class="pstep">
              <div class="num">01</div>
              <span class="tagline">Listen &amp; envision.</span>
              <h3>Discovery</h3>
              <p>
                A relaxed, unhurried conversation about what you'd change — and what you'd keep.
                We study your face, your bite, and the way you speak and smile, then translate it
                into a clear design direction.
              </p>
              <span class="lbl">Step One</span>
            </div>
            <div class="pstep">
              <div class="num">02</div>
              <span class="tagline">Preview before we prep.</span>
              <h3>Design</h3>
              <p>
                Using Digital Smile Design and hand-sculpted mock-ups, we render your exact result
                before a tooth is ever touched. You refine it with us, chairside, until it's right.
              </p>
              <span class="lbl">Step Two</span>
            </div>
            <div class="pstep">
              <div class="num">03</div>
              <span class="tagline">Crafted, then delivered.</span>
              <h3>Deliver</h3>
              <p>
                Minimal- or no-prep veneers are shaped to the approved design and bonded with
                heirloom-grade precision. The reveal is the easy part — everything before it is the craft.
              </p>
              <span class="lbl">Step Three</span>
            </div>
          </div>
        </div>

        <div class="process-sign" data-vs-reveal>
          <div class="av" aria-hidden="true"><Image src={image("drPortrait").url} width={image("drPortrait").width} height={image("drPortrait").height} alt="Dr. Bryce Richardson" /></div>
          <div>
            <b>Dr. Bryce Richardson</b>
            <small>Creator · Vivid Smile Cosmetic Process</small>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- MEMBERSHIP BAND ---------- */}
    <aside class="membership-band" id="membership" aria-labelledby="membership-heading">
      <div class="wrap">
        <div class="membership-visual" data-vs-reveal>
          <Image src={teamPhoto} alt="The Vivid Smiles Dentistry team" widths={[480, 800, 1200]} sizes="(max-width: 991px) 100vw, 50vw" />
        </div>
        <div class="membership-content" data-vs-reveal-batch>
          <span class="membership-eyebrow">No Insurance? No Problem</span>
          <h3 class="membership-heading" id="membership-heading">Become a Vivid Smiles Dentistry Member</h3>
          <div class="membership-price-line">
            <span class="amt">$500</span>
            <span class="per">/year</span>
          </div>
          <p class="membership-desc">While it is not a requirement, we offer patients the option to join our Exclusive Dental Membership Plan for just $500 annually and experience exceptional dental care at an affordable price.</p>
          <div class="membership-benefits">
            <div class="membership-benefit">15% Discount Off Treatment</div>
            <div class="membership-benefit">Oral Cancer Screening</div>
            <div class="membership-benefit">2 Cleanings Per Year</div>
            <div class="membership-benefit">10% Off Clear Aligners</div>
            <div class="membership-benefit">Comprehensive Exam</div>
            <div class="membership-benefit">Complimentary Consults</div>
            <div class="membership-benefit">Unlimited Digital X-Rays</div>
            <div class="membership-benefit">2 Fluoride Treatments</div>
          </div>
          <div class="membership-actions">
            <Button variant="sage" href={phoneHref} hoverLabel="Tap to Call">Ask About Membership</Button>
          </div>
        </div>
      </div>
    </aside>

    {/* ---------- TESTIMONIALS ---------- */}
    <section class="testi">
      <div class="wrap">
        <div class="testi-head" data-vs-reveal-batch>
          <span class="eyebrow">Testimonials</span>
          <h2>5-Star <em>Smiles</em></h2>
          <div class="stars">★★★★★</div>
          <p>Hear from some of our happy patients. Vivid Smiles Dentistry is the only dentist with a 5-star rating in Parker, CO.</p>
        </div>
        <div class="testi-actions" data-vs-reveal>
          <Button variant="sage" href="https://share.google/CletN4Tfk51TpK4It" hoverLabel="See Reviews">Read More on Google</Button>
        </div>
      </div>
      <ReviewMarquee reviews={reviews} ariaLabel="Patient testimonials" />
    </section>

    {/* ---------- VIRTUAL CONSULT FORM ----------
         The home conversion engine. Component lives at src/components/VirtualConsult.astro
         and is reused on every service detail page (same Typeform, page-specific framing).
         background="paper" forces a light → dark transition into the footer for the
         homepage charcoal-green test (the new charcoal bands above would otherwise
         clash dark-on-dark with the --vs-ink-deep footer). */}
    <VirtualConsult background="paper" />

    </main>

    {/* JSON-LD structured data — Dentist (LocalBusiness subtype). Mirrors the
        block used on /contact/, /our-office/, and service pages. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Dentist",
      "name": "Vivid Smiles Dentistry",
      "image": new URL("/apple-touch-icon.png", Astro.site).href,
      "url": new URL("/", Astro.site).href,
      "telephone": phoneE164,
      "email": emailAddress,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": addressStreet,
        "addressLocality": addressCity,
        "addressRegion": addressState,
        "postalCode": addressZip,
        "addressCountry": "US"
      },
      "openingHoursSpecification": openingHoursSpecification,
      "priceRange": "$$",
      "areaServed": ["Parker, CO", "Castle Rock, CO", "Lone Tree, CO"]
    })} />

  </div>
</BaseLayout>
