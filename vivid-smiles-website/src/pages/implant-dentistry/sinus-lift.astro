---
/**
 * Sinus Lift Procedure — Vivid Smiles Dentistry, Parker CO.
 *
 * The shoot contains no sinus-lift or CBCT imagery, so the hero is a patient
 * portrait rather than a procedure shot. The one clinical frame this page owns
 * (the Yomi placement) sits in #technology, where the copy actually describes it.
 *
 * MIGRATED TO BLOCKS (docs/PAGE-BLOCKS.md 2.3). EIGHT top-level content bands —
 * why, what, process, alternatives, technology, investment, gallery, faq — each
 * guarded with `hasBlocks ? null : …` and each carrying a row in
 * cms/import/block-map.json under /implant-dentistry/sinus-lift/ (staged for
 * merge as cms/import/routes/sinus-lift.json). No <LocalTrust> on this page, so
 * no `code_section` row and nothing added to vs-content-model.php.
 *
 * BAND COLOURS ARE READ OFF sinus-lift.css, NOT OFF THE CLASS NAMES. The band
 * comments below used to say "cream split" for #what and #technology and "sage"
 * for #process and #gallery, and all four were wrong: `.section.alt` is
 * var(--vs-charcoal-green) at sinus-lift.css:225 and `.section.dark` is
 * var(--vs-sage-pale) at :235. `alt` and `dark` mean different tokens on
 * different page sheets (Fact 4), so a value copied from a sibling repaints a
 * band. Each comment now names the rule it was read from.
 *
 * THREE THINGS THIS PAGE OWNS THAT THE TWO WORKED EXAMPLES DO NOT:
 *   1. #technology draws its numbered list as `.tech-list`; MediaSplitBlock
 *      emits `.candidate-list` for the identical shape. sinus-lift.css gains an
 *      ADDITIVE alias so the page sheet answers to both names — see the comment
 *      on that rule. Nothing is deleted: `.tech-list` is the else branch.
 *   2. #what carries a whole `.what-sub` "Common Causes" sub-grid below the
 *      media split, and #investment is a bespoke two-column `.invest-grid` with
 *      a sage `.insurance-card` aside. Neither has a field on any registered
 *      layout. Both are recorded as known_gaps on their blocks; nothing was
 *      invented to cover them.
 *   3. Its `faq` band puts the CMS body in the SECTION-HEAD and hardcodes the
 *      `.pull` aside — the opposite of porcelain-veneers, where the CMS body is
 *      the pull. The map follows this page, not that one.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FinalBand from '../../components/FinalBand.astro';
import VirtualConsult from '../../components/VirtualConsult.astro';
import { phoneHref, phoneLabel, bookNowHref } from '../../data/contact';
import { getSmiles } from '../../lib/smiles';
import PageBlocks from '../../blocks/PageBlocks.astro';
import '../../styles/pages/sinus-lift.css';

// "What is a sinus lift" — anatomical cross-section diagram (gpt_image_2).
// #technology — the Yomi placement, which is tech-list item 03.
import { getPageContent, type TocLink } from '../../lib/page-content';
// tocLinks, processSteps, faqs are edited in WordPress (Pages -> Sinus Lift Procedure in Parker, CO).
// The shapes are unchanged from the arrays that used to live here, so the
// markup below is untouched.
const { blocks, hasBlocks, tocLinks, processSteps, faqs, hero, section, image, seo } =
  await getPageContent(Astro.url.pathname);


// Gallery pulls dynamically from src/assets/images/smiles/ via the
// central loader. Doubled for seamless marquee loop.
const galleryTiles = getSmiles();
const galleryTrack = [...galleryTiles, ...galleryTiles];

const causeCards = [
  { tag: 'Most common', title: 'Upper back tooth loss' },
  { tag: 'Cause', title: 'Periodontal disease' },
  { tag: 'Cause', title: 'Long-term denture wear' },
  { tag: 'Cause', title: 'Naturally thin sinus anatomy' },
];

const alternatives = [
  {
    tag: 'Alternative',
    title: 'Short implants',
    body: 'Can work in thinner bone, but long-term success rates are lower than standard implants in fully grafted bone.',
  },
  {
    tag: 'Alternative',
    title: 'Zygomatic implants',
    body: 'Anchor in the cheekbone rather than the jawbone; reserved for severe bone loss requiring specialized surgical training.',
  },
  {
    tag: 'Alternative',
    title: 'Removable dentures',
    body: 'No surgery required, but chewing stability and long-term function are significantly lower than implant-supported restorations.',
  },
];

const techList = [
  {
    marker: '01',
    title: 'CBCT imaging',
    body: 'Gives Dr. Richardson a precise 3D map of bone height and sinus anatomy before any incision, measuring the exact graft volume needed and eliminating guesswork from the plan.',
  },
  {
    marker: '02',
    title: 'Digital planning',
    body: 'Converts that to precise surgical coordinates.',
  },
  {
    marker: '03',
    title: 'Robotic implant placement',
    body: 'Guides the final procedure to the pre-planned position.',
  },
];

const costBullets = [
  {
    title: 'Graft material',
    body: "Synthetic, bovine, or autogenous (patient's own) bone each carries different costs.",
  },
  {
    title: 'Implant timing',
    body: 'Simultaneous placement, when anatomy permits, reduces total treatment cost.',
  },
  {
    title: 'Insurance coverage',
    body: 'Dental insurance may cover a portion when medically necessary; some medical plans also contribute when sinus pathology is documented.',
  },
];

/**
 * The "On this page" rail, derived from the blocks themselves (docs/PAGE-BLOCKS.md 1.2).
 *
 * Used only when this page renders from `blocks`. The `toc_links` repeater is
 * seven rows that restate the order of the eight bands below it, so a reorder in
 * wp-admin moves a band and leaves its rail entry pointing at the old
 * neighbour — the single largest way a reorder breaks a link. Reading the
 * anchors off the blocks makes that unrepresentable: there is one ordering and
 * the rail is a projection of it.
 *
 * Three rules, in the order they bite:
 *
 * 1. A blank anchor is skipped. Not tidiness — src/scripts/toc-spy.ts:24 feeds
 *    each rendered href straight to document.querySelector(), and
 *    querySelector("") throws a SyntaxError that kills the whole spy, not just
 *    the one entry. PageBlocks.astro emits no id at all for a blank anchor
 *    (`id={anchor || undefined}`), so there is nothing to link to either.
 * 2. An anchor that is not a valid id selector is skipped for the same reason —
 *    "#3-reasons" is legal HTML and an illegal CSS selector. Dropping one rail
 *    entry costs one link; letting it through costs every link on the page,
 *    plus the mobile pill auto-centering.
 * 3. Duplicate anchors follow PageBlocks.astro's dedup exactly, second
 *    occurrence onward suffixed `-2`, `-3`. The counter has to advance on every
 *    non-blank anchor, including blocks with no nav_label, or the rail's idea
 *    of "the second #faq" drifts from the id the renderer actually emitted.
 *
 * A blank nav_label means "leave this block out of the rail" (1.2), which is
 * how a band that should not be navigable opts out — `gallery` on this page,
 * which has no toc_links row and never appeared in the rail.
 */
const ANCHOR_IS_ID_SELECTOR = /^[A-Za-z_][A-Za-z0-9_-]*$/;

const anchorsSeen = new Map<string, number>();
// Typed as TocLink[] rather than an equivalent inline shape so the ternary in
// the rail below collapses to one type instead of a union of two array types,
// which TypeScript will not let you call .map() on.
const derivedTocLinks: TocLink[] = [];

for (const block of blocks) {
  // A nested block is drawn INSIDE the band above it, not as a band of its own,
  // so it has no id to link to. Without this the rail emits an entry pointing at
  // an anchor nothing renders — a dead link in the "On this page" list.
  if (block?.nested) continue;

  const anchor = typeof block.anchor === 'string' ? block.anchor.trim() : '';
  if (anchor === '') continue;

  const nth = (anchorsSeen.get(anchor) ?? 0) + 1;
  anchorsSeen.set(anchor, nth);

  const label = typeof block.navLabel === 'string' ? block.navLabel.trim() : '';
  if (label === '') continue;

  if (!ANCHOR_IS_ID_SELECTOR.test(anchor)) {
    console.warn(
      `[blocks] anchor "${anchor}" on ${Astro.url.pathname} cannot be used as a selector — ` +
        `omitting "${label}" from the On this page rail so toc-spy keeps working`,
    );
    continue;
  }

  derivedTocLinks.push({ href: `#${nth > 1 ? `${anchor}-${nth}` : anchor}`, label });
}

---

<BaseLayout
  title={seo.title || "Sinus Lift Procedure in Parker, CO | Vivid Smiles Dentistry"}
  description={seo.description || "Sinus lift in Parker, CO with Dr. Bryce Richardson — CBCT imaging, robotic implant placement, and 600-plus hours of advanced surgical training. Schedule a free consultation."}
 noindex={seo.noindex}>
  <div class="sinuslift">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/services/">Services</a>
        <span class="sep">/</span>
        <a href="/implant-dentistry/">Implant Dentistry</a>
        <span class="sep">/</span>
        <span class="here">Sinus Lift</span>
      </div>
    </nav>

    <main id="main">
      {/* ---------- HERO ---------- */}
      <header class="hero" data-vs-reveal-batch>
        <div class="wrap hero-inner">
          <div class="hero-copy">
            {hero.eyebrow ? <span class="eyebrow">{hero.eyebrow}</span> : <span class="eyebrow">Implant Dentistry · Parker, CO</span>}
            {hero.h1 ? <h1 data-vs-reveal-lines set:html={hero.h1} /> : <h1 data-vs-reveal-lines>Sinus Lift Procedure <em>in Parker, Colorado</em></h1>}
            {hero.sub ? <p class="hero-sub">{hero.sub}</p> : <p class="hero-sub">
              A sinus lift (sinus augmentation) adds bone to the upper jaw, so <a
                class="vs-link"
                href="/implant-dentistry/single-tooth-dental-implants/">dental implants</a
              > have enough height to anchor securely. When upper back teeth are lost, the jawbone recedes,
              and the sinus expands downward, leaving insufficient bone for a stable implant. Here is
              who needs a sinus lift, how the procedure works, and what recovery looks like at Vivid Smiles
              in Parker, CO.
            </p>}
            <div class="hero-actions">
              <Button variant="light" href={hero.cta(0) ? hero.cta(0)!.href : bookNowHref} hoverLabel="Let's Talk">{hero.cta(0) ? hero.cta(0)!.label : "Book Online"}</Button
              >
              <Button variant="ghost-light" href={hero.cta(1) ? hero.cta(1)!.href : "#consult"} hoverLabel="Get a Video"
                >{hero.cta(1) ? hero.cta(1)!.label : "Free Virtual Consult"}</Button
              >
              {hero.showRatings && <div class="ratings">
                <span class="stars" aria-hidden="true">★★★★★</span>
                <span>5.0 · 300+ reviews</span>
              </div>}
            </div>
          </div>
          <div class="hero-img" data-vs-parallax data-parallax="-30">
            <Image
              src={image("heroImg").url} width={image("heroImg").width} height={image("heroImg").height}
              alt="Smiling woman photographed outdoors in the Colorado foothills"
              widths={[600, 900, 1400]}
              sizes="(max-width: 991px) 100vw, 50vw"
            />
          </div>
        </div>
      </header>

      {/* ---------- KEYS — at-a-glance ---------- */}
      <section class="keys" id="keys" aria-label="Sinus lift at a glance" data-vs-reveal-batch>
        <div class="keys-grid">
          <div class="keys-label">At a glance</div>
          <div class="keys-item">
            <div class="k">4–6 mo</div><div class="v">Bone Integration</div>
          </div>
          <div class="keys-item"><div class="k">95%+</div><div class="v">Success Rate</div></div>
          <div class="keys-item">
            <div class="k">2–3 days</div><div class="v">Return to Work</div>
          </div>
          <div class="keys-item">
            <div class="k">600+ hrs</div><div class="v">Surgical Training</div>
          </div>
        </div>
      </section>

      {
        /* ---------- ON-THIS-PAGE TOC ----------
         The rail itself is never a block (spec 7: "Not a block, even though it
         is a band") — only its contents move. Derived from the blocks when
         they are drawing the page, read from the `toc_links` repeater when the
         template is. Same markup either way, which is what lets
         src/scripts/toc-spy.ts go on reading its section list off the rendered
         links without knowing which source produced them. */
      }
      <nav class="toc" id="toc" aria-label="On this page">
        <div class="toc-inner">
          <span class="toc-label">On this page</span>
          <div class="toc-scroll">
            <div class="toc-list">
              {(hasBlocks ? derivedTocLinks : tocLinks).map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          </div>
        </div>
      </nav>

      {
        /* ---------- WHY (paper, editorial credentials split) ----------

         THE MIGRATION SWITCH (docs/PAGE-BLOCKS.md 2.3) starts here. `hasBlocks`
         means "this build can draw this page from its blocks" — not "WordPress
         sent rows" (src/lib/page-content.ts). When it is true PageBlocks draws
         the eight bands in the order an editor arranged them; when it is false —
         which is every build until the backfill has run, and again the moment
         an editor empties the field — every band below renders exactly as it
         always has.

         Written as one guard per band rather than one guard around all eight on
         purpose, and it is not a style choice. Astro's compressHTML pass treats
         an Astro comment expression differently inside a component slot than at
         element level: wrapping these bands in a Fragment silently drops one
         space at every comment boundary below, and scripts/vr-html.mjs compares
         exact bytes and calls that a difference. A guard sitting exactly where
         its section sat emits byte-identical HTML.

         EVERY top-level band between here and <VirtualConsult> is guarded, and
         every one of them has a row in cms/import/routes/sinus-lift.json. Those
         two facts have to move together: a band that is neither blocked nor
         guarded renders in ADDITION to the block run and lands at the bottom of
         the page, and a band that is guarded with no map row disappears on
         backfill with nothing in the log. There is no third outcome. The bands
         ABOVE this line — the breadcrumb, the hero, `.keys` and the rail — are
         not blocks by spec 7 and are deliberately unguarded, as are
         <VirtualConsult> and <FinalBand> below the run.

         `.section` carries no background on this page (sinus-lift.css:224 sets
         padding only), so this band is the body's paper. */
      }
      {hasBlocks ? <PageBlocks blocks={blocks} /> : <section class="section" id="why" data-vs-reveal-batch>
        <div class="wrap">
          <div class="why-editorial">
            <div class="why-image" data-vs-parallax data-parallax="-20">
              <Image
                src={image("drRichardsonImg").url} width={image("drRichardsonImg").width} height={image("drRichardsonImg").height}
                alt="Dr. Bryce Richardson, lead surgeon at Vivid Smiles Dentistry in Parker, CO"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 45vw"
              />
            </div>
            <div class="why-text">
              <span class="eyebrow">{section("why").eyebrow}</span>
              <h2><Fragment set:html={section("why").heading} /></h2>
              <p class="why-lede">{section("why").body}</p>
              <div class="why-creds">
                <div class="cred">
                  <div class="cred-stat">600+ hrs</div>
                  <div class="cred-label">Advanced Surgical Training</div>
                </div>
                <div class="cred">
                  <div class="cred-stat">
                    300+ <span class="stars" aria-hidden="true">★★★★★</span>
                  </div>
                  <div class="cred-label">Five-Star Google Reviews</div>
                </div>
                <div class="cred">
                  <div class="cred-stat">Implant Pathway</div>
                  <div class="cred-label">Clinical Staff Role</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- WHAT (charcoal split + Common Causes sub-grid) ----------
       `.section.alt` is var(--vs-charcoal-green) on THIS page
       (sinus-lift.css:225), with h2 #fff at :226-229 and p rgba(255,255,255,0.85)
       at :233. Dark, white text — NOT the cream the old comment here claimed and
       NOT the cream the same class name means on teeth-whitening.css:237. The
       band value in the map is read off that rule, not off the class. ---------- */}
      {hasBlocks ? null : <section class="section alt" id="what" data-vs-reveal-batch>
        <div class="wrap">
          <div class="what-grid">
            <div class="what-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("whatImg").url} width={image("whatImg").width} height={image("whatImg").height}
                alt="Cross-section illustration of a sinus lift — graft material placed beneath the lifted sinus membrane above an implant fixture"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
            <div class="what-text">
              <span class="eyebrow">{section("what").eyebrow}</span>
              <h2><Fragment set:html={section("what").heading} /></h2>
              <div class="prose">
                <p>{section("what").body}</p>
              </div>
              <div class="cta-row left">
                <div class="cta-buttons">
                  <Button variant="light" href="#consult" hoverLabel="Get a Video"
                    >Free Virtual Consult</Button
                  >
                  <Button variant="ghost-light" href="#process" hoverLabel="View Steps"
                    >How It Works</Button
                  >
                </div>
              </div>
            </div>
          </div>

          <div class="what-sub">
            <div class="what-sub-head">
              <span class="eyebrow">Common Causes</span>
              <h3>Why You Might Need a Sinus Lift for Dental Implants</h3>
              <div class="prose">
                <p>
                  Upper back tooth loss is the most common reason patients need a sinus lift, but
                  periodontal disease, long-term denture wear, or naturally thin sinus anatomy can
                  create the same problem. CBCT imaging measures the exact bone shortfall before
                  treatment begins, so there are no surprises.
                </p>
              </div>
            </div>
            <div class="cause-grid">
              {
                causeCards.map((c) => (
                  <article class="cause-card">
                    <span class="tag">{c.tag}</span>
                    <h4>{c.title}</h4>
                  </article>
                ))
              }
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- PROCESS (sage-pale, 4-step + Recovery inline-cta) ----------
       `.section.dark` is var(--vs-sage-pale) here (sinus-lift.css:235), with h2
       var(--vs-ink) at :236-239. PALE, despite the class name. `sage` and
       `sage-pale` are two separate BLOCK_BANDS choices painting two different
       tokens, so the map says sage-pale. ---------- */}
      {hasBlocks ? null : <section class="section dark" id="process" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow light">The Procedure</span>
            <h2><Fragment set:html={section("process").heading} /></h2>
            <p>{section("process").body}</p>
          </div>

          <div class="process-grid">
            {
              processSteps.map((s) => (
                <div class="process-card">
                  <span class="step-tag">{s.tag}</span>
                  <div class="num">{s.num}</div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              ))
            }
          </div>

          <div class="inline-cta dark">
            <div class="ic-text">
              <strong>Recovery and Aftercare.</strong> Most patients return to work within 2 to 3 days,
              with mild swelling managed by prescribed medication. The critical post-operative instruction:
              do not blow your nose or sneeze forcefully for two weeks.
            </div>
            <div class="ic-buttons">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- ALTERNATIVES (paper, 3-card) ----------
       `<section class="section">` with no background rule on
       .sinuslift .section (sinus-lift.css:224), so body paper shows through.
       Mapped to `comparison_cards`, whose shell is `.compare` / `.compare-card`
       rather than this page's `.alt-grid` / `.alt-card` — the block carries its
       own declarations for its own names, and the difference is recorded as a
       known_gap on that block rather than papered over by renaming anything
       here. ---------- */}
      {hasBlocks ? null : <section class="section" id="alternatives" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Alternatives</span>
            <h2><Fragment set:html={section("alternatives").heading} /></h2>
            <p>{section("alternatives").body}</p>
          </div>

          <div class="alt-grid">
            {
              alternatives.map((a) => (
                <article class="alt-card">
                  <span class="tag">{a.tag}</span>
                  <h3>{a.title}</h3>
                  <p>{a.body}</p>
                </article>
              ))
            }
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <Button variant="ghost" href="#faq" hoverLabel="See Answers">Read FAQ</Button>
            </div>
            <span class="cta-note">No commitment · Personal video reply</span>
          </div>
        </div>
      </section>}

      {/* ---------- TECHNOLOGY (charcoal split + numbered list) ----------
       Same `.section.alt` rule as `what` above, sinus-lift.css:225 — charcoal,
       not cream.

       `ul.tech-list` below is the one place this page and MediaSplitBlock
       disagree on a class name: the block draws the identical shape as
       `.candidate-list` (MediaSplitBlock.astro's header names this page's
       `.tech-list` as the fourth, identically-declared instance). sinus-lift.css
       therefore carries an ADDITIVE alias giving `.sinuslift .candidate-list`
       the same five rules — nothing here is renamed, because `.tech-list` is
       what the else branch below still emits. ---------- */}
      {hasBlocks ? null : <section class="section alt" id="technology" data-vs-reveal-batch>
        <div class="wrap">
          <div class="natural-grid">
            <div class="natural-text">
              <span class="eyebrow">Technology</span>
              <h2><Fragment set:html={section("technology").heading} /></h2>
              <div class="natural-quote">
                Precision before any incision — CBCT imaging, digital planning, and robotic
                placement eliminate guesswork from the plan.
              </div>
              <ul class="tech-list">
                {
                  techList.map((t) => (
                    <li>
                      <span class="marker">{t.marker}</span>
                      <span>
                        <b>{t.title} —</b> {t.body}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="natural-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("yomiImg").url} width={image("yomiImg").width} height={image("yomiImg").height}
                alt="Dr. Bryce Richardson placing a dental implant with the Yomi robotic arm at Vivid Smiles Dentistry"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- INVESTMENT (paper) ----------
       `.section.invest { background: var(--paper) }` at sinus-lift.css:585, and
       `--paper` is `var(--vs-paper)` at :11 — the same white as the unmodified
       `.section` bands, stated explicitly here rather than inherited.

       THE BESPOKE BAND ON THIS PAGE. Mapped to `card_grid` because that is the
       only registered layout that can draw a numbered section-head-plus-items
       band at all; the two-column `.invest-grid`, the "What affects your cost"
       eyebrow and the ENTIRE sage `.insurance-card` aside — its heading,
       paragraph, four `.insurance-card__list` lines, two buttons and the
       "Bring your insurance card(s)" line — have no field on any of the nine
       deployed layouts. Recorded in full as known_gaps on that block. Nothing
       was invented to cover them and no field was added. ---------- */}
      {hasBlocks ? null : <section class="section invest" id="investment" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("investment").eyebrow}</span>
            <h2><Fragment set:html={section("investment").heading} /></h2>
            <p>{section("investment").body}</p>
          </div>

          <div class="invest-grid">
            <div class="invest-factors">
              <span class="eyebrow">What affects your cost</span>
              <ul class="cost-factor-list">
                {
                  costBullets.map((c, i) => (
                    <li class="cost-factor">
                      <span class="cost-factor__num">{String(i + 1).padStart(2, '0')}</span>
                      <div class="cost-factor__copy">
                        <h3>{c.title}</h3>
                        <p>{c.body}</p>
                      </div>
                    </li>
                  ))
                }
              </ul>
            </div>

            <aside class="insurance-card">
              <span class="eyebrow light">Insurance &amp; Financing</span>
              <h3>A clear estimate before any decisions.</h3>
              <p>
                Every sinus lift is quoted against a CBCT scan — no surprises, no across-the-board
                pricing. We review your PPO benefits up front, document medical-necessity language
                when applicable, and offer financing for the balance.
              </p>
              <ul class="insurance-card__list">
                <li>PPO dental benefits reviewed pre-treatment</li>
                <li>Medical-plan language when sinus pathology is documented</li>
                <li>In-house &amp; third-party financing partners</li>
                <li>Vivid Smiles membership plan for uninsured patients</li>
              </ul>
              <div class="insurance-card__actions">
                <Button variant="light" href="#consult" hoverLabel="Get a Video"
                  >Free Virtual Consult</Button
                >
                <Button variant="outline-light" href={bookNowHref} hoverLabel="Book Consult"
                  >Book a Quote</Button
                >
              </div>
              <p class="insurance-card__bring">Bring your insurance card(s) to the consultation.</p>
            </aside>
          </div>
        </div>
      </section>}

      {/* ---------- GALLERY (sage-pale, marquee, doubled track) ----------
       Same `.section.dark` rule as `process`, sinus-lift.css:235 — sage-pale.
       Out of the rail on both sides of the switch: this page has no `toc_links`
       row for #gallery, so the derived rail leaves it out exactly as the
       repeater does. ---------- */}
      {hasBlocks ? null : <section class="section dark" id="gallery">
        <div class="wrap">
          <div class="section-head" data-vs-reveal>
            <span class="eyebrow light">Smile Gallery</span>
            <h2><Fragment set:html={section("gallery").heading} /></h2>
            <p>{section("gallery").body}</p>
          </div>
        </div>

        <div class="gallery-marquee" data-vs-marquee aria-label="Vivid Smiles smile gallery">
          <div class="gallery-track" data-vs-marquee-track>
            {
              galleryTrack.map((t, i) => {
                const isClone = i >= galleryTiles.length;
                return (
                  <div
                    class="smile-tile"
                    aria-hidden={isClone || undefined}
                    inert={isClone || undefined}
                  >
                    <Image src={t.src} width={t.width} height={t.height} alt={t.alt} widths={[420, 640, 840]} sizes="420px" />
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>}

      {/* ---------- FAQ (paper) — native details/summary, zero JS ----------
       No background rule on .sinuslift .section (sinus-lift.css:224), body paper.

       NOTE THE DIRECTION OF THE BODY/PULL SPLIT, WHICH IS THE OPPOSITE OF
       porcelain-veneers'. Here the CMS `faq` row's body is the section-head
       paragraph (:469 below) and the `.pull` aside is hardcoded, so the map
       sends sections.faq.body -> `body` and transcribes `pull`. On
       porcelain-veneers the head has no paragraph and the CMS body IS the pull.
       Copying that page's mapping here would move the head's paragraph into the
       aside and leave the head bare. ---------- */}
      {hasBlocks ? null : <section class="section" id="faq" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("faq").eyebrow}</span>
            <h2><Fragment set:html={section("faq").heading} /></h2>
            <p>{section("faq").body}</p>
          </div>

          <div class="faq-list">
            {
              faqs.map((f) => (
                <details class="faq" open={f.open}>
                  <summary>
                    <>
                      <h3>{f.q}</h3>
                      <span class="icon" aria-hidden="true">
                        +
                      </span>
                    </>
                  </summary>
                  <div class="answer">{f.a}</div>
                </details>
              ))
            }
          </div>

          <div class="pull">
            <p>
              A sinus lift is a reliable first step for upper-jaw implant patients with insufficient
              bone. Understanding the procedure and timeline before your appointment makes the
              planning conversation more productive.
            </p>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Still Have Questions? Free Virtual Consult</Button
              >
              <Button variant="ghost" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>}

      {
        /* ---------- VIRTUAL CONSULT — primary closing conversion.
         NOT a block and deliberately unguarded, like the breadcrumb, hero,
         `.keys` strip and the rail above: it renders on both sides of the
         switch and has no row in the map. It sits after the block run in
         template order and PageBlocks draws at the `why` position, so the
         closing pair still comes last.
         Anchor #consult is the destination for every mid-page CTA on this
         page — including the two the `what` block and the `investment` band
         emit — so it must survive the switch. */
      }
      <VirtualConsult id="consult" eyebrow="Free sinus lift consultation">
        <Fragment slot="headline">Free sinus lift <em>consultation.</em></Fragment>
        <Fragment slot="body">
          Curious whether a sinus lift is the right next step toward upper-jaw implants? Skip the
          office visit — Dr. Richardson personally records a custom video reviewing your case, your
          candidacy, and what's possible at Vivid Smiles Dentistry, all from photos you submit
          below.
        </Fragment>
      </VirtualConsult>

      {/* ---------- CLOSING BAND ---------- */}
      <FinalBand>
        <p>
          Vivid Smiles Dentistry in Parker, CO, pairs Dr. Richardson's surgical training with CBCT
          imaging and robotic implant placement. Call {phoneLabel} or
          <a href={bookNowHref} target="_blank" rel="noopener noreferrer">
            book a free consultation</a
          > to start with a 3D scan and a personalized plan.
        </p>
      </FinalBand>
    </main>

    <script>
      import { initTocSpy } from '../../scripts/toc-spy';
      initTocSpy('.sinuslift');
    </script>

    {/* JSON-LD structured data — MedicalProcedure + FAQPage + BreadcrumbList */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'MedicalProcedure',
        name: 'Sinus Lift',
