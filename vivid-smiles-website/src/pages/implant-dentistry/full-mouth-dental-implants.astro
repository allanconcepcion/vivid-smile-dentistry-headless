---
/**
 * Full Mouth Dental Implants — Vivid Smiles Dentistry, Parker CO.
 * Page-scoped styles: src/styles/pages/full-mouth-dental-implants.css (.fmdi wrapper).
 *
 * Recipe: All-on-4 single-arch template, namespace .fmdi, copy mapped
 * verbatim from the SEO brief. Adaptations vs. the source recipe:
 *   - "What" cream split has NO sub-grid (the brief's only definition-level copy is
 *     a single short paragraph; the original Upper-vs-Lower split has no analog).
 *   - "Benefits" paper grid is a 4-card mapping of the verbatim
 *     "How Full Mouth Implants Differ from Traditional Dentures" bullets,
 *     replacing the all-on-4 "Living" (Eating/Cleaning/etc.) cards since the
 *     brief has no daily-life copy.
 *   - "Compare" sub-grid is 2 alternatives instead of 3 (the brief lists 4
 *     options total; 2 occupy the head-to-head, 2 occupy the sub).
 *   - 6 FAQs (vs. 8 in all-on-4) per brief.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FinalBand from '../../components/FinalBand.astro';
import VirtualConsult from '../../components/VirtualConsult.astro';
import PricingTiers from '../../components/PricingTiers.astro';
import { phoneHref, phoneLabel, bookNowHref } from '../../data/contact';
import { getSmiles } from '../../lib/smiles';
import '../../styles/pages/full-mouth-dental-implants.css';

import heroImg from '../../assets/images/people/real/woman-office-portrait.webp';
// "What is full-mouth implants" — a real full-arch restoration on a lab
// model: the whole-arch prosthesis this page is about, shown as an object
// rather than as a patient's result.
import whatImg from '../../assets/images/procedures/full-arch-restoration-model.webp';
// Robotics section — keep the authentic Dr. Bryce Yomi-guided procedure.
import roboticsImg from '../../assets/images/procedures/dr-richardson-performing-yomi-guided-implant-surgery.webp';
// Candidacy — lifestyle patient portrait.
import candidacyImg from '../../assets/images/people/real/woman-lakeside-seated.webp';
import { getPageContent } from '../../lib/page-content';

// Track doubled for seamless marquee loop.
const galleryTiles = getSmiles();
const galleryTrack = [...galleryTiles, ...galleryTiles];

const whyCards = [
  {
    num: '01',
    title: 'Implant Pathway · 600+ hours',
    body: 'Dr. Richardson was part of the staff at Implant Pathway, accumulating 600+ hours of surgical training. That places him in a small tier of general dentists at this level.',
  },
  {
    num: '02',
    title: 'Robotic-guided placement',
    body: 'Robotic-assisted surgery improves placement accuracy to within fractions of a millimeter, which matters most in full arch cases where four to six implants must support a bridge and placement errors compound across the arch.',
  },
  {
    num: '03',
    title: 'In-house milling & 3D printing',
    body: 'His in-house lab includes milling units and 3D printers for prosthetic fabrication, keeping quality control with the surgeon throughout.',
  },
  {
    num: '04',
    title: '300+ reviews · Parker roots',
    body: 'With over 300 five-star Google reviews and deep Parker roots, he brings destination-level full arch expertise to a neighborhood practice.',
  },
];

const benefitCards = [
  {
    num: '01',
    title: 'Bone preservation',
    body: 'Implants transfer chewing forces into the jawbone, preventing the resorption that dentures accelerate.',
  },
  {
    num: '02',
    title: 'Stability',
    body: 'The bridge is fixed to the implants; no adhesive, shifting, or daily removal.',
  },
  {
    num: '03',
    title: 'Diet',
    body: 'No food restrictions; full arch implant patients eat normally, including hard and chewy foods.',
  },
  {
    num: '04',
    title: 'Facial structure',
    body: 'The jaw retains its density, so the face maintains its shape rather than developing the sunken look common in long-term denture wearers.',
  },
];

const alternatives = [
  {
    tag: 'Alternative',
    title: 'Implant-supported overdentures',
    body: 'More stable than conventional dentures with two to four implant attachments, but still removable and do not stop bone loss.',
  },
  {
    tag: 'Alternative',
    title: 'Individual implants per tooth',
    body: 'Clinically appropriate for isolated losses; impractical and overly complex for full arch tooth loss.',
  },
];

const keyStats: [string, string][] = [
  ['4–6', 'Implants Per Arch'],
  ['Same-Day', 'Temporary Teeth'],
  ['4–9 mo', 'Treatment Time'],
  ['20+ yrs', 'Prosthetic Bridge'],
];

// tocLinks, processSteps, faqs are edited in WordPress (Pages -> Full Mouth Dental Implants in Parker, CO).
// The shapes are unchanged from the arrays that used to live here, so the
// markup below is untouched.
const { tocLinks, processSteps, faqs, section, image } = await getPageContent(Astro.url.pathname);

---

<BaseLayout
  title="Full Mouth Dental Implants in Parker, CO | Vivid Smiles Dentistry"
  description="Full mouth dental implants in Parker, CO with Dr. Bryce Richardson — robotic placement, CBCT planning, four-to-six titanium implants per arch with a fixed bridge. Free consultation."
>
  <div class="fmdi">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/services/">Services</a>
        <span class="sep">/</span>
        <a href="/implant-dentistry/">Implant Dentistry</a>
        <span class="sep">/</span>
        <span class="here">Full Mouth Dental Implants</span>
      </div>
    </nav>

    <main id="main">
      {/* ---------- HERO ---------- */}
      <header class="hero" data-vs-reveal-batch>
        <div class="wrap hero-inner">
          <div class="hero-copy">
            <span class="eyebrow">Implant Dentistry · Parker, CO</span>
            <h1 data-vs-reveal-lines>Full Mouth Dental Implants <em>in Parker, Colorado</em></h1>
            <p class="hero-sub">
              Full mouth dental implants replace an entire arch with a fixed, non-removable
              prosthesis supported by four to six titanium implants fused to the jaw. They function
              like natural teeth and preserve the bone that traditional dentures allow to erode.
              Below is what the procedure involves, who qualifies, and what to expect at Vivid
              Smiles Dentistry.
            </p>
            <div class="hero-actions">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <div class="ratings">
                <span class="stars" aria-hidden="true">★★★★★</span>
                <span>5.0 · 300+ reviews</span>
              </div>
            </div>
          </div>
          <div class="hero-img" data-vs-parallax data-parallax="-30">
            <Image
              src={image("heroImg").url} width={image("heroImg").width} height={image("heroImg").height}
              alt="Smiling woman photographed inside the Vivid Smiles Dentistry office in Parker, CO"
              widths={[600, 900, 1400]}
              sizes="(max-width: 991px) 100vw, 50vw"
            />
          </div>
        </div>
      </header>

      {/* ---------- KEYS — at-a-glance ---------- */}
      <section
        class="keys"
        id="keys"
        aria-label="Full mouth dental implants at a glance"
        data-vs-reveal-batch
      >
        <div class="keys-grid">
          <div class="keys-label">At a glance</div>
          {
            keyStats.map(([k, v]) => (
              <div class="keys-item">
                <>
                  <div class="k">{k}</div>
                  <div class="v">{v}</div>
                </>
              </div>
            ))
          }
        </div>
      </section>

      {/* ---------- ON-THIS-PAGE TOC ---------- */}
      <nav class="toc" id="toc" aria-label="On this page">
        <div class="toc-inner">
          <span class="toc-label">On this page</span>
          <div class="toc-scroll">
            <div class="toc-list">
              {tocLinks.map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          </div>
        </div>
      </nav>

      {/* ---------- WHY (paper, 4-card grid) ---------- */}
      <section class="section" id="why" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("why").eyebrow}</span>
            <h2><Fragment set:html={section("why").heading} /></h2>
          </div>

          <div class="why-grid">
            {
              whyCards.map((c) => (
                <article class="why-card">
                  <div class="num">{c.num}</div>
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      {
        /* ---------- WHAT (cream split, no sub-grid — single-paragraph definition only) ---------- */
      }
      <section class="section alt" id="what" data-vs-reveal-batch>
        <div class="wrap">
          <div class="what-grid">
            <div class="what-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("whatImg").url} width={image("whatImg").width} height={image("whatImg").height}
                alt="Full-arch restoration on a dental model, held in a gloved hand"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
            <div class="what-text">
              <span class="eyebrow">{section("what").eyebrow}</span>
              <h2><Fragment set:html={section("what").heading} /></h2>
              <div class="prose">
                <p>{section("what").body}</p>
              </div>
              <div class="cta-row left">
                <div class="cta-buttons">
                  <Button variant="light" href="#consult" hoverLabel="Get a Video"
                    >Free Virtual Consult</Button
                  >
                  <Button variant="ghost-light" href="#robotics" hoverLabel="See How"
                    >How It Works</Button
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ---------- ROBOTICS (paper, with same-day callout) ---------- */}
      <section class="section" id="robotics" data-vs-reveal-batch>
        <div class="wrap">
          <div class="robotics-grid">
            <div class="robotics-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("roboticsImg").url} width={image("roboticsImg").width} height={image("roboticsImg").height}
                alt="Dr. Bryce Richardson placing a dental implant with the Yomi robotic arm at Vivid Smiles Dentistry"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
            <div class="robotics-text">
              <span class="eyebrow">{section("robotics").eyebrow}</span>
              <h2><Fragment set:html={section("robotics").heading} /></h2>
              <p class="robotics-prose">{section("robotics").body}</p>
              <div class="robotics-callout">
                <span class="label">Same-day teeth</span>
                <h4>Can You Get Teeth the Same Day?</h4>
                <p>
                  Many full arch patients receive a temporary prosthesis the same day as surgery.
                  The same-day restoration is a well-fitting temporary; the permanent bridge follows
                  after osseointegration is confirmed. Qualification depends on bone density and
                  implant stability achieved at surgery, both evaluated during your initial
                  consultation with Dr. Richardson.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {
        /* ---------- PROCESS (sage, 5-step recovery timeline + Advanced-Technology inline-cta) ---------- */
      }
      <section class="section dark" id="process" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow light">Recovery Timeline</span>
            <h2><Fragment set:html={section("process").heading} /></h2>
            <p>{section("process").body}</p>
          </div>

          <div class="process-grid">
            {
              processSteps.map((s) => (
                <div class="process-card">
                  <span class="step-tag">{s.tag}</span>
                  <div class="num">{s.num}</div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              ))
            }
          </div>

          <div class="inline-cta dark">
            <div class="ic-text">
              <strong>Advanced technology at Vivid Smiles.</strong> CBCT imaging maps nerve locations,
              bone quality, and implant trajectories before surgery begins, and digital smile design lets
              patients preview the result before committing to treatment. In-house milling and 3D printing
              produce prosthetic components, reducing appointments and keeping quality control with Dr.
              Richardson throughout the process.
            </div>
            <div class="ic-buttons">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>

      {/* ---------- COMPARE (paper, 1 featured + 1 main + 2-alt sub-grid) ---------- */}
      <section class="section" id="compare" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("compare").eyebrow}</span>
            <h2><Fragment set:html={section("compare").heading} /></h2>
            <p>{section("compare").body}</p>
          </div>

          <div class="compare">
            <article class="compare-card featured">
              <span class="ribbon">Our Specialty</span>
              <span class="tag">Full Arch Implants</span>
              <h3>Full Arch Implants (All-on-4 / All-on-X)</h3>
              <ul class="compare-list">
                <li>
                  <b>Profile —</b> Fixed, bone-anchored, and designed for patients missing most or all
                  teeth in an arch.
                </li>
                <li>
                  <b>Implants —</b> Four to six titanium roots per arch supporting a non-removable bridge.
                </li>
                <li>
                  <b>Bone —</b> Transfers chewing forces into the jawbone, preventing the resorption that
                  dentures accelerate.
                </li>
                <li>
                  <b>Lifestyle —</b> No adhesive, shifting, or daily removal; no food restrictions once
                  healed.
                </li>
              </ul>
            </article>

            <article class="compare-card">
              <span class="tag">Traditional Dentures</span>
              <h3>Traditional Dentures</h3>
              <ul class="compare-list">
                <li>
                  <b>Profile —</b> Removable, lower upfront cost, but permit ongoing bone resorption and
                  deteriorate in fit as the jaw changes shape.
                </li>
                <li>
                  <b>Bone —</b> Stay on top of the gums and allow the jawbone beneath them to shrink.
                </li>
                <li><b>Stability —</b> Require adhesive or daily removal and refitting.</li>
                <li>
                  <b>Lifestyle —</b> Restrict the diet and accelerate the sunken facial look common in
                  long-term denture wearers.
                </li>
              </ul>
            </article>
          </div>

          <div class="compare-sub">
            <div class="compare-sub-head">
              <span class="eyebrow">Alternatives</span>
              <h3>Other Tooth-Replacement Options</h3>
              <div class="prose">
                <p>
                  Full-arch implants are the right call when most or all teeth in an arch are gone,
                  but other approaches fit different clinical pictures.
                </p>
              </div>
            </div>
            <div class="alternatives-grid">
              {
                alternatives.map((a) => (
                  <article class="config-card">
                    <span class="tag">{a.tag}</span>
                    <h4>{a.title}</h4>
                    <p>{a.body}</p>
                  </article>
                ))
              }
            </div>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <Button variant="ghost" href="#faq" hoverLabel="See Answers">Read FAQ</Button>
            </div>
            <span class="cta-note">No commitment · Personal video reply</span>
          </div>
        </div>
      </section>

      {
        /* ---------- CANDIDACY (cream, image+text + "What If You Have Bone Loss?" sub) ---------- */
      }
      <section class="section alt" id="candidacy" data-vs-reveal-batch>
        <div class="wrap">
          <div class="natural-grid">
            <div class="natural-text">
              <span class="eyebrow">Candidacy</span>
              <h2><Fragment set:html={section("candidacy").heading} /></h2>
              <div class="natural-quote">
                Full arch implants are for individuals missing most or all teeth in one or both
                arches, including those with severe decay, advanced gum disease, or long-term
                denture wearers seeking a permanent alternative.
              </div>
              <ul class="candidate-list">
                <li>
                  <span class="marker">01</span>
                  <span
                    ><b>Missing most or all teeth in an arch —</b> the procedure replaces every tooth
                    in one or both jaws with a fixed bridge.</span
                  >
                </li>
                <li>
                  <span class="marker">02</span>
                  <span
                    ><b>Severe decay or advanced gum disease —</b> failing teeth across the arch are removed
                    during the same surgical visit.</span
                  >
                </li>
                <li>
                  <span class="marker">03</span>
                  <span
                    ><b>Long-term denture wearers —</b> patients seeking a permanent alternative to removable
                    prosthetics.</span
                  >
                </li>
                <li>
                  <span class="marker">04</span>
                  <span
                    ><b>Most situations are treatable —</b> with the correct preparation, candidacy is
                    more inclusive than most patients expect.</span
                  >
                </li>
              </ul>
            </div>
            <div class="natural-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("candidacyImg").url} width={image("candidacyImg").width} height={image("candidacyImg").height}
                alt="Woman seated in tall grass above a Colorado lake"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
          </div>

          <div class="candidacy-sub">
            <span class="label">If you have reduced bone</span>
            <h3>What If You Have Bone Loss?</h3>
            <p>{section("candidacy").body}</p>
          </div>
        </div>
      </section>

      {
        /* ---------- BENEFITS (paper, 4-card — replaces all-on-4 "Living"; maps the
        verbatim Implants-vs-Dentures differences) ---------- */
      }
      <section class="section" id="benefits" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("benefits").eyebrow}</span>
            <h2><Fragment set:html={section("benefits").heading} /></h2>
            <p>{section("benefits").body}</p>
          </div>

          <div class="benefits-grid">
            {
              benefitCards.map((c) => (
                <article class="benefits-card">
                  <div class="num">{c.num}</div>
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      {/* ---------- INVESTMENT (cream) ---------- */}
      <section class="section alt" id="cost" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("cost").eyebrow}</span>
            <h2><Fragment set:html={section("cost").heading} /></h2>
            <p>{section("cost").body}</p>
          </div>

          <PricingTiers
            tiers={[
              {
                name: 'Full Mouth Dental Implants',
                priceQualifier: 'Starting at',
                price: '$19,995',
                priceSuffix: 'per arch',
                tagline: 'Full-arch fixed teeth — single arch or full mouth.',
                bullets: [
                  'Robotic implant placement per arch',
                  'Zirconia or acrylic prosthetic options',
                  'CBCT-planned with preparatory procedures included',
                  'PPO insurance benefits reviewed up front',
                  'In-house and third-party financing available',
                ],
                highlight: true,
                ribbon: 'Most Common',
              },
            ]}
            financingNote="Every case has a unique anatomy and material profile — a free consultation with CBCT imaging is the only way to get an accurate quote. Vivid Smiles works with third-party financing partners to spread the investment across monthly payments; patients without insurance can also enroll in the Vivid Smiles dental membership plan."
          />
        </div>
      </section>

      {/* ---------- GALLERY ---------- */}
      <section class="section dark" id="gallery">
        <div class="wrap">
          <div class="section-head" data-vs-reveal>
            <span class="eyebrow light">Smile Gallery</span>
            <h2><Fragment set:html={section("gallery").heading} /></h2>
            <p>{section("gallery").body}</p>
          </div>
        </div>

        <div class="gallery-marquee" data-vs-marquee aria-label="Vivid Smiles smile gallery">
          <div class="gallery-track" data-vs-marquee-track>
            {
              galleryTrack.map((t, i) => {
                const isClone = i >= galleryTiles.length;
                return (
                  <div
                    class="smile-tile"
                    aria-hidden={isClone || undefined}
                    inert={isClone || undefined}
                  >
                    <Image src={t.src} alt={t.alt} widths={[420, 640, 840]} sizes="420px" />
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      {/* ---------- FAQ (paper, 6 accordion items + closing pull-quote) ---------- */}
      <section class="section" id="faq" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("faq").eyebrow}</span>
            <h2><Fragment set:html={section("faq").heading} /></h2>
          </div>

          <div class="faq-list">
            {
              faqs.map((f) => (
                <details class="faq" open={f.open}>
                  <summary>
                    <>
                      <h3>{f.q}</h3>
                      <span class="icon" aria-hidden="true">
                        +
                      </span>
                    </>
                  </summary>
                  <div class="answer" set:html={f.a} />
                </details>
              ))
            }
          </div>

          <div class="pull">
            <p>{section("faq").body}</p>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Still Have Questions? Free Virtual Consult</Button
              >
              <Button variant="ghost" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>

      {/* ---------- VIRTUAL CONSULT ---------- */}
      <VirtualConsult id="consult" eyebrow="Free full mouth implant consultation">
        <Fragment slot="headline">Free full mouth implant <em>consultation.</em></Fragment>
        <Fragment slot="body">
          Vivid Smiles Dentistry in Parker, CO, brings Dr. Richardson's 600+ hours of surgical
          training, Implant Pathway credentials, and robotic technology to deliver outcomes grounded
          in precision planning. Schedule your free consultation below or call {phoneLabel} to learn whether
          full-mouth implants are the right path for you.
        </Fragment>
      </VirtualConsult>

      {/* ---------- CLOSING BAND ---------- */}
      <FinalBand>
        <p>
          Dr. Richardson's staff training at Implant Pathway, robotic placement technology, and
          in-house lab capabilities give Parker-area clients access to our
          <a href="/services/"> full range of dental services</a> at a level found only at specialized
          surgical centers.
        </p>
      </FinalBand>
    </main>
  </div>
</BaseLayout>

<script>
  import { initTocSpy } from '../../scripts/toc-spy';
  initTocSpy('.fmdi');
</script>

{/* JSON-LD: MedicalProcedure + FAQPage + BreadcrumbList */}
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'MedicalProcedure',
    name: 'Full Mouth Dental Implants',
    alternateName: ['Full Arch Dental Implants', 'Full-Mouth Implants', 'All-on-X Implants'],
    procedureType: 'https://schema.org/SurgicalProcedure',
    bodyLocation: 'Jaw',
    preparation:
      'CBCT cone-beam imaging maps nerve locations, bone quality, and implant trajectories before surgery begins; digital smile design previews the final restoration; planning software maps the position, depth, and angle of each implant before robotic surgery.',
    howPerformed:
      'Four to six titanium implants are placed per arch under local anesthesia or sedation, using robotic-guided surgery for sub-millimeter precision. Many patients receive a temporary fixed prosthesis the same day. After three to six months of osseointegration, the final zirconia or acrylic bridge is fabricated in-house and bite-refined.',
    followup:
      'Soft foods during osseointegration; daily brushing, water flosser or floss threaders around each abutment; routine hygiene appointments to maintain gum tissue health around implants; annual imaging to assess bone levels.',
    performer: {
      '@type': 'Dentist',
      name: 'Dr. Bryce Richardson',
      worksFor: {
        '@type': 'Dentist',
        name: 'Vivid Smiles Dentistry',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '17167 Cedar Gulch Pkwy Ste 102',
          addressLocality: 'Parker',
          addressRegion: 'CO',
          postalCode: '80134',
          addressCountry: 'US',
        },
        telephone: '+1-303-841-5313',
      },
    },
  })}
/>

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify({
