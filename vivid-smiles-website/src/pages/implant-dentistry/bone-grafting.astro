---
/**
 * Bone Grafting — Vivid Smiles Dentistry, Parker CO.
 * Page-scoped styles: src/styles/pages/bone-grafting.css (.bgraft wrapper).
 *
 * Ported from the all-on-4-single-arch template. Same structural sections —
 * HERO → KEYS → TOC → WHY → WHAT → IMPLANTS → PROCESS → TYPES → CANDIDACY → GALLERY → FAQ
 * → VirtualConsult → final-band — with markdown copy mapped verbatim. The COMPARE slot is
 * repurposed for "Types of Bone Grafting": procedures render as a 3-card .alternatives-grid
 * (clinical situations), and material sources render as a 2-col .materials-block (head left,
 * stacked .material-row definition rows right) — distinct visual treatment so two 3-card grids
 * don't sit back-to-back. WHAT section integrates "Why Jawbone Loss Happens" inline as a
 * .what-causes block in the same right column as the definition prose, separated by a hairline
 * rule, so the causes content doesn't float as a centered orphan below the cream split.
 * No new images were added — assets reused from src/assets/images/procedures/ and people/.
 *
 * MIGRATED TO BLOCKS (docs/PAGE-BLOCKS.md 2.3). Eight top-level content bands —
 * why, what, implants, process, types, candidacy, gallery, faq — each guarded
 * with `hasBlocks ? null : …` and each carrying a row in
 * cms/import/block-map.json under /implant-dentistry/bone-grafting/. No
 * `code_section` row: this page mounts no <LocalTrust> and no other bespoke
 * component band, so there is nothing for the escape hatch to hold a place for.
 *
 * THREE THINGS ON THIS PAGE THAT THE MIGRATED COSMETIC PAGES DO NOT HAVE, all
 * three recorded as known_gaps on their blocks in the map:
 *   1. `#implants` is a centred .implants-intro stacked over a sage-tinted
 *      .implants-band card. No registered layout draws that shape; the closest
 *      is media_split, which returns the band as a .what-grid split — the very
 *      shape the note at :271 restructured it away from.
 *   2. `#types` carries a .materials-block <dl> after its .alternatives-grid,
 *      and `#what` and `#candidacy` each carry a bespoke sub-block
 *      (.what-causes, .candidacy-sub). None of the nine layouts draws a
 *      definition list or either sub-block.
 *   3. `.why-grid` is FOUR across here, so this is the first route to store
 *      card_grid `columns: "4"` and the first to emit `.why-grid.cols-4`. That
 *      compound outranks this sheet's own 1240px collapse — see the map.
 *
 * The bands ABOVE the switch — breadcrumb, hero, .keys and the rail — are not
 * blocks by spec 7 and stay unguarded, as do <VirtualConsult> and <FinalBand>
 * below the run.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FinalBand from '../../components/FinalBand.astro';
import VirtualConsult from '../../components/VirtualConsult.astro';
import { phoneHref, phoneLabel, bookNowHref, directionsHref } from '../../data/contact';
import { getSmiles } from '../../lib/smiles';
import '../../styles/pages/bone-grafting.css';

// "What is bone grafting" — anatomical cross-section diagram (gpt_image_2).
// "Implants context band" — real Dr. Richardson + Yomi-arm procedure shot
// (the actual robotic implant placement in Vivid Smiles' operatory). Replaces
// the previous AI-generated yomi-robotic-implant-procedure.webp which read as
// "photo of a computer" because it was dominated by planning screens.
// Candidacy section — lifestyle patient portrait.
import { getPageContent, type TocLink } from '../../lib/page-content';
import PageBlocks from '../../blocks/PageBlocks.astro';
// tocLinks, processSteps, faqs are edited in WordPress (Pages -> Bone Grafting in Parker, CO).
// The shapes are unchanged from the arrays that used to live here, so the
// markup below is untouched.
const { blocks, hasBlocks, tocLinks, processSteps, faqs, section, image, seo } =
  await getPageContent(Astro.url.pathname);


// Track doubled for seamless marquee loop.
const galleryTiles = getSmiles();
const galleryTrack = [...galleryTiles, ...galleryTiles];

const whyCards = [
  {
    num: '01',
    title: '600+ Hours of Surgical Training',
    body: 'Dr. Richardson brings 600-plus hours of specialized surgical training and Implant Pathway staff experience to every bone grafting case.',
  },
  {
    num: '02',
    title: 'CBCT Imaging-Guided',
    body: 'CBCT imaging guides bone volume assessment before treatment begins, and robotic implant placement follows once healing is confirmed.',
  },
  {
    num: '03',
    title: '5-Star · 300+ Reviews',
    body: 'Vivid Smiles holds a 5-star rating across 300+ Google reviews, reflecting the precision and patient-first care Parker patients receive at every stage.',
  },
  {
    num: '04',
    title: 'Parker Resident · Implant Pathway',
    body: "Dr. Richardson trained at Implant Pathway, one of the country's most selective implant training institutions, and lives and practices in Parker, CO.",
  },
];

const procedures = [
  {
    tag: 'Procedure',
    title: 'Socket Preservation',
    body: 'Performed at extraction — graft material is placed in the empty socket immediately after a tooth is removed to maintain ridge volume for future implant placement.',
  },
  {
    tag: 'Procedure',
    title: 'Ridge Augmentation',
    body: 'Rebuilds implant site height or width when the jawbone has already resorbed, restoring the volume an implant needs to anchor securely.',
  },
  {
    tag: 'Procedure',
    title: 'Sinus Lifts',
    body: 'Used for upper molar cases — the sinus floor is gently lifted and graft material is added to create enough vertical bone for implants in the back of the upper jaw.',
  },
];

const materials = [
  {
    tag: 'Allograft',
    title: 'Processed donor bone',
    body: 'Processed donor bone from a certified tissue bank; integrates predictably with natural jawbone.',
  },
  {
    tag: 'Xenograft',
    title: 'Bovine-derived mineral',
    body: 'Mineral derived from bovine bone, used for its structural compatibility with human jaw tissue.',
  },
  {
    tag: 'Synthetic',
    title: 'Lab-made scaffold',
    body: 'Lab-made scaffold material that supports new bone growth while your body rebuilds around it.',
  },
];

const keyStats: [string, string][] = [
  ['CBCT', '3D Imaging Guided'],
  ['3–6 mo', 'Healing Window'],
  ['600+ hrs', 'Surgical Training'],
  ['5.0★ · 300+', 'Google Reviews'],
];

/**
 * The "On this page" rail, derived from the blocks themselves (docs/PAGE-BLOCKS.md 1.2).
 *
 * Used only when this page renders from `blocks`. The `toc_links` repeater is
 * seven rows that restate the order of the eight bands below it, so a reorder in
 * wp-admin moves a band and leaves its rail entry pointing at the old
 * neighbour — the single largest way a reorder breaks a link. Reading the
 * anchors off the blocks makes that unrepresentable: there is one ordering and
 * the rail is a projection of it.
 *
 * Three rules, in the order they bite:
 *
 * 1. A blank anchor is skipped. Not tidiness — src/scripts/toc-spy.ts:24 feeds
 *    each rendered href straight to document.querySelector(), and
 *    querySelector("") throws a SyntaxError that kills the whole spy, not just
 *    the one entry. PageBlocks.astro emits no id at all for a blank anchor
 *    (`id={anchor || undefined}`), so there is nothing to link to either.
 * 2. An anchor that is not a valid id selector is skipped for the same reason —
 *    "#3-reasons" is legal HTML and an illegal CSS selector. Dropping one rail
 *    entry costs one link; letting it through costs every link on the page,
 *    plus the mobile pill auto-centering.
 * 3. Duplicate anchors follow PageBlocks.astro's dedup exactly, second
 *    occurrence onward suffixed `-2`, `-3`. The counter has to advance on every
 *    non-blank anchor, including blocks with no nav_label, or the rail's idea
 *    of "the second #faq" drifts from the id the renderer actually emitted.
 *
 * A blank nav_label means "leave this block out of the rail" (1.2), which is
 * how a band that should not be navigable opts out — `gallery` on this page,
 * which has no toc_links row and never appeared in the rail.
 */
const ANCHOR_IS_ID_SELECTOR = /^[A-Za-z_][A-Za-z0-9_-]*$/;

const anchorsSeen = new Map<string, number>();
// Typed as TocLink[] rather than an equivalent inline shape so the ternary in
// the rail below collapses to one type instead of a union of two array types,
// which TypeScript will not let you call .map() on.
const derivedTocLinks: TocLink[] = [];

for (const block of blocks) {
  const anchor = typeof block.anchor === 'string' ? block.anchor.trim() : '';
  if (anchor === '') continue;

  const nth = (anchorsSeen.get(anchor) ?? 0) + 1;
  anchorsSeen.set(anchor, nth);

  const label = typeof block.navLabel === 'string' ? block.navLabel.trim() : '';
  if (label === '') continue;

  if (!ANCHOR_IS_ID_SELECTOR.test(anchor)) {
    console.warn(
      `[blocks] anchor "${anchor}" on ${Astro.url.pathname} cannot be used as a selector — ` +
        `omitting "${label}" from the On this page rail so toc-spy keeps working`,
    );
    continue;
  }

  derivedTocLinks.push({ href: `#${nth > 1 ? `${anchor}-${nth}` : anchor}`, label });
}


---

<BaseLayout
  title={seo.title || "Bone Grafting in Parker, CO | Vivid Smiles Dentistry"}
  description={seo.description || "Bone grafting in Parker, CO with Dr. Bryce Richardson — CBCT-guided assessment, socket preservation, ridge augmentation, and sinus lifts that prepare your jaw for dental implants."}
 noindex={seo.noindex}>
  <div class="bgraft">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/services/">Services</a>
        <span class="sep">/</span>
        <a href="/implant-dentistry/">Implant Dentistry</a>
        <span class="sep">/</span>
        <span class="here">Bone Grafting</span>
      </div>
    </nav>

    <main id="main">
      {/* ---------- HERO ---------- */}
      <header class="hero" data-vs-reveal-batch>
        <div class="wrap hero-inner">
          <div class="hero-copy">
            <span class="eyebrow">Implant Dentistry · Parker, CO</span>
            <h1 data-vs-reveal-lines>Bone Grafting <em>in Parker, CO</em></h1>
            <p class="hero-sub">
              Bone grafting rebuilds jawbone lost after tooth extraction or gum disease, creating
              the foundation needed for dental implants. Without adequate bone volume, implants
              cannot anchor securely, which is why Dr. Richardson evaluates every patient with CBCT
              3D imaging before recommending treatment. Here is what bone grafting involves, who
              needs it, and what to expect at Vivid Smiles Dentistry in Parker.
            </p>
            <div class="hero-actions">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <div class="ratings">
                <span class="stars" aria-hidden="true">★★★★★</span>
                <span>5.0 · 300+ reviews</span>
              </div>
            </div>
          </div>
          <div class="hero-img" data-vs-parallax data-parallax="-30">
            <Image
              src={image("heroImg").url} width={image("heroImg").width} height={image("heroImg").height}
              alt="Smiling man photographed at the Vivid Smiles Dentistry neon smile wall in Parker, CO"
              widths={[600, 900, 1400]}
              sizes="(max-width: 991px) 100vw, 50vw"
            />
          </div>
        </div>
      </header>

      {/* ---------- KEYS — at-a-glance ---------- */}
      <section class="keys" id="keys" aria-label="Bone grafting at a glance" data-vs-reveal-batch>
        <div class="keys-grid">
          <div class="keys-label">At a glance</div>
          {
            keyStats.map(([k, v]) => (
              <div class="keys-item">
                <>
                  <div class="k">{k}</div>
                  <div class="v">{v}</div>
                </>
              </div>
            ))
          }
        </div>
      </section>

      {
        /* ---------- ON-THIS-PAGE TOC ----------
         The rail itself is never a block (spec 7: "Not a block, even though it
         is a band") — only its contents move. Derived from the blocks when
         they are drawing the page, read from the `toc_links` repeater when the
         template is. Same markup either way, which is what lets
         src/scripts/toc-spy.ts go on reading its section list off the rendered
         links without knowing which source produced them. */
      }
      <nav class="toc" id="toc" aria-label="On this page">
        <div class="toc-inner">
          <span class="toc-label">On this page</span>
          <div class="toc-scroll">
            <div class="toc-list">
              {(hasBlocks ? derivedTocLinks : tocLinks).map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          </div>
        </div>
      </nav>

      {
        /* ---------- WHY (paper) ----------

         THE MIGRATION SWITCH (docs/PAGE-BLOCKS.md 2.3) starts here. `hasBlocks`
         means "this build can draw this page from its blocks" — not "WordPress
         sent rows" (src/lib/page-content.ts). When it is true PageBlocks draws
         the eight bands in the order an editor arranged them; when it is false —
         which is every build until the backfill has run, and again the moment
         an editor empties the field — every band below renders exactly as it
         always has.

         Written as one guard per band rather than one guard around all eight on
         purpose, and it is not a style choice. Astro's compressHTML pass treats
         an Astro comment expression differently inside a component slot than at
         element level: wrapping these bands in a Fragment silently drops one
         space at every comment boundary below, and scripts/vr-html.mjs compares
         exact bytes and calls that a difference. A guard sitting exactly where
         its section sat emits byte-identical HTML.

         EVERY top-level band between here and <VirtualConsult> is guarded, and
         every one of them has a row in cms/import/block-map.json. Those two
         facts have to move together: a band that is neither blocked nor guarded
         renders in ADDITION to the block run and lands at the bottom of the
         page, and a band that is guarded with no map row disappears on backfill
         with nothing in the log. There is no third outcome. The bands ABOVE
         this line — the breadcrumb, the hero, `.keys` and the rail — are not
         blocks by spec 7 and are deliberately unguarded, as are <VirtualConsult>
         and <FinalBand> below the run. */
      }
      {hasBlocks ? <PageBlocks blocks={blocks} /> : <section class="section" id="why" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("why").eyebrow}</span>
            <h2><Fragment set:html={section("why").heading} /></h2>
          </div>

          <div class="why-grid">
            {
              whyCards.map((c) => (
                <article class="why-card">
                  <div class="num">{c.num}</div>
                  <h3>{c.title}</h3>
                  <p>{c.body}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>}

      {/* ---------- WHAT (charcoal) — `.section.alt` is var(--vs-charcoal-green)
       on THIS page (bone-grafting.css:227), with h2/h3/h4 #fff at :228-231 and
       p rgba(255,255,255,.85) at :235. The band comment this replaced called it
       a "cream split", which the sheet contradicts; the map's band value is read
       off the rule, not off the class name and not off the comment. The
       .what-causes sub-block inside .what-text has no field on media_split — see
       the known_gap on this block. ---------- */}
      {hasBlocks ? null : <section class="section alt" id="what" data-vs-reveal-batch>
        <div class="wrap">
          <div class="what-grid">
            <div class="what-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("whatImg").url} width={image("whatImg").width} height={image("whatImg").height}
                alt="Cross-section illustration showing bone-graft material placed under a collagen barrier membrane against native jawbone"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
            <div class="what-text">
              <span class="eyebrow">{section("what").eyebrow}</span>
              <h2><Fragment set:html={section("what").heading} /></h2>
              <div class="prose">
                <p>{section("what").body}</p>
              </div>

              {
                /* Causes content integrated inline so it shares the column with the definition prose
                (instead of floating as a centered .what-sub block below the cream split). */
              }
              <div class="what-causes">
                <div class="what-causes-rule" aria-hidden="true"></div>
                <span class="eyebrow">Causes</span>
                <h3>Why Jawbone Loss Happens</h3>
                <p>
                  Jawbone loss most often results from tooth extraction without replacement,
                  periodontal disease, or a missing tooth left untreated for years. How quickly bone
                  resorbs varies by patient. CBCT imaging reveals your current bone volume and
                  determines whether grafting is necessary before implant planning begins.
                </p>
              </div>

              <div class="cta-row left">
                <div class="cta-buttons">
                  <Button variant="light" href="#consult" hoverLabel="Get a Video"
                    >Free Virtual Consult</Button
                  >
                  <Button variant="ghost-light" href="#process" hoverLabel="See How"
                    >See the Procedure</Button
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>}

      {
        /* ---------- IMPLANTS (centered intro + compact highlight band — distinct from WHAT) ---------- */
      }
      {
        /* Original ROBOTICS slot was image-left + text-right 50/50, which sat next to WHAT's
        same-shape split and read as a duplicate layout. Restructured here as a vertical
        stack: centered intro (max-width 760px) on top, then a sage-tinted .implants-band
        below with a smaller framed image flanked by the callout content — same content,
        very different rhythm from the section above.

         ---------- IMPLANTS (paper) — <section class="section">, no background
         rule on .bgraft .section (bone-grafting.css:226).

         THE BAND WITH THE LARGEST SHAPE LOSS ON THIS ROUTE. Its map row is a
         media_split, which is the only registered layout that keeps the photo —
         and media_split draws a .what-grid, which is exactly the 50/50 split the
         restructure note above moved this band away from. The .implants-band
         card's own eyebrow, <h3> and paragraph (with its two internal
         <a class="vs-link"> to the single-tooth and full-mouth implant pages)
         have no field and are quoted verbatim in the block's known_gaps so they
         are recoverable from the map alone. */
      }
      {hasBlocks ? null : <section class="section" id="implants" data-vs-reveal-batch>
        <div class="wrap">
          <div class="implants-intro">
            <span class="eyebrow">{section("implants").eyebrow}</span>
            <h2><Fragment set:html={section("implants").heading} /></h2>
            <p>{section("implants").body}</p>
          </div>

          <div class="implants-band">
            <div class="implants-band-img" data-vs-parallax data-parallax="-15">
              <Image
                src={image("implantsImg").url} width={image("implantsImg").width} height={image("implantsImg").height}
                alt="Close-up of an implant-supported restoration on a dental model"
                widths={[400, 600, 900]}
                sizes="(max-width: 991px) 100vw, 38vw"
              />
            </div>
            <div class="implants-band-text">
              <span class="eyebrow">Why grafting comes first</span>
              <h3>Foundation, then placement.</h3>
              <p>
                Bone grafting is needed when bone loss is significant enough to prevent stable <a
                  class="vs-link"
                  href="/implant-dentistry/single-tooth-dental-implants/">implant placement</a
                >. Common candidates include patients with unpreserved extraction sites, multiple
                missing teeth, or denture wearers considering <a
                  class="vs-link"
                  href="/implant-dentistry/full-mouth-dental-implants/">implant-supported options</a
                >. Not all implant cases require grafting, and a CBCT evaluation at Vivid Smiles
                confirms whether it applies to you.
              </p>
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- PROCESS (sage-pale) — `.section.dark` is var(--vs-sage-pale)
       here (bone-grafting.css:237), with h2/h3/h4 var(--vs-ink) at :238-241.
       `sage` and `sage-pale` are two separate BLOCK_BANDS choices painting two
       different tokens, so the map says sage-pale and the band comment this
       replaced — which said "sage" — was reading the class name, not the rule.
       Five steps across a repeat(5, 1fr) grid (bone-grafting.css:433). --------- */}
      {hasBlocks ? null : <section class="section dark" id="process" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow light">The Procedure</span>
            <h2><Fragment set:html={section("process").heading} /></h2>
            <p>{section("process").body}</p>
          </div>

          <div class="process-grid">
            {
              processSteps.map((s) => (
                <div class="process-card">
                  <span class="step-tag">{s.tag}</span>
                  <div class="num">{s.num}</div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              ))
            }
          </div>

          <div class="inline-cta dark">
            <div class="ic-text">
              <strong>What to expect during recovery.</strong> Most patients manage post-graft discomfort
              with over-the-counter pain medication. Swelling peaks at 48 to 72 hours; a soft food diet
              is recommended for the first week. Full osseointegration, meaning the graft material fusing
              completely with your jawbone, takes 3 to 6 months before implant surgery proceeds.
            </div>
            <div class="ic-buttons">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>}

      {
        /* ---------- TYPES (reuses COMPARE slot — 3 procedure cards + materials glossary) ---------- */
      }
      {
        /* Two distinct patterns: .alternatives-grid for procedures (3 prominent cards), then a
        2-col .materials-block (head + .materials-list) for material sources — keeps the eye
        from reading two identical 3-card rows back-to-back.

         ---------- TYPES (paper) — <section class="section">, no background rule
         (bone-grafting.css:226).

         Mapped to comparison_cards, which draws the three procedure cards from
         the CMS `cards` group `procedures` — but into `.compare` / `.compare-card`
         / <h3>, not this page's `.alternatives-grid` / `.config-card` / <h4>.
         The .materials-block <dl> below has no field on any registered layout,
         and its three rows are live CMS content (`cards` group `materials`), so
         they are listed in `exempt.cards` in the map rather than silently
         dropped by the leftover check. Both losses are on the block's
         known_gaps. */
      }
      {hasBlocks ? null : <section class="section" id="types" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("types").eyebrow}</span>
            <h2><Fragment set:html={section("types").heading} /></h2>
            <p>{section("types").body}</p>
          </div>

          <div class="alternatives-grid">
            {
              procedures.map((p) => (
                <article class="config-card">
                  <span class="tag">{p.tag}</span>
                  <h4>{p.title}</h4>
                  <p>{p.body}</p>
                </article>
              ))
            }
          </div>

          {
            /* Materials list — split 2-col (head left, stacked definition rows right) so it reads
            as reference info, not a duplicate of the procedures card grid above. */
          }
          <div class="materials-block">
            <div class="materials-head">
              <span class="eyebrow">Material Sources</span>
              <h3>Where Does Bone Graft Material Come From?</h3>
              <p>Graft material is selected based on your anatomy and the procedure required.</p>
            </div>
            <dl class="materials-list">
              {
                materials.map((m) => (
                  <div class="material-row">
                    <dt>
                      <span class="tag">{m.tag}</span>
                      <span class="label">{m.title}</span>
                    </dt>
                    <dd>{m.body}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <Button variant="ghost" href="#faq" hoverLabel="See Answers">Read FAQ</Button>
            </div>
            <span class="cta-note">No commitment · Personal video reply</span>
          </div>
        </div>
      </section>}

      {/* ---------- CANDIDACY (charcoal) — the same `.section.alt` rule as `what`
       above, bone-grafting.css:227. The band comment this replaced said "cream";
       the sheet says var(--vs-charcoal-green), and the map follows the sheet.
       The .candidate-list here is the markup media_split.checklist was built
       from — lead, item, markers derived from row position. The .candidacy-sub
       card below the grid is not expressible and is a known_gap. ---------- */}
      {hasBlocks ? null : <section class="section alt" id="candidacy" data-vs-reveal-batch>
        <div class="wrap">
          <div class="natural-grid">
            <div class="natural-text">
              <span class="eyebrow">{section("candidacy").eyebrow}</span>
              <h2><Fragment set:html={section("candidacy").heading} /></h2>
              <div class="natural-quote">
                Bone grafting is needed when bone loss is significant enough to prevent stable
                implant placement.
              </div>
              <ul class="candidate-list">
                <li>
                  <span class="marker">01</span>
                  <span
                    ><b>Unpreserved extraction sites —</b> Patients whose teeth were removed without a
                    socket-preservation graft at the time of extraction.</span
                  >
                </li>
                <li>
                  <span class="marker">02</span>
                  <span
                    ><b>Multiple missing teeth —</b> When several teeth have been absent long enough for
                    surrounding bone to resorb.</span
                  >
                </li>
                <li>
                  <span class="marker">03</span>
                  <span
                    ><b>Denture wearers considering implants —</b> Long-term denture wear accelerates
                    bone loss; grafting often restores enough volume to switch to an implant-supported
                    option.</span
                  >
                </li>
                <li>
                  <span class="marker">04</span>
                  <span
                    ><b>CBCT-confirmed deficit —</b> Not all implant cases require grafting, and a CBCT
                    evaluation at Vivid Smiles confirms whether it applies to you.</span
                  >
                </li>
              </ul>
            </div>
            <div class="natural-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("candidacyImg").url} width={image("candidacyImg").width} height={image("candidacyImg").height}
                alt="Woman standing beside a stone wall on a bright afternoon"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
          </div>

          <div class="candidacy-sub">
            <span class="label">The bottom line</span>
            <h3>An imaging-guided foundation for implants</h3>
            <p>{section("candidacy").body}</p>
          </div>
        </div>
      </section>}

      {/* ---------- GALLERY (sage-pale) — the same `.section.dark` rule as
       `process`, bone-grafting.css:237. Marquee, doubled track. Out of the rail
       on both sides of the switch: this page has no `toc_links` row for
       #gallery, so the derived rail leaves it out exactly as the repeater does.
       ---------- */}
      {hasBlocks ? null : <section class="section dark" id="gallery">
        <div class="wrap">
          <div class="section-head" data-vs-reveal>
            <span class="eyebrow light">Smile Gallery</span>
            <h2><Fragment set:html={section("gallery").heading} /></h2>
            <p>{section("gallery").body}</p>
          </div>
        </div>

        <div class="gallery-marquee" data-vs-marquee aria-label="Vivid Smiles smile gallery">
          <div class="gallery-track" data-vs-marquee-track>
            {
              galleryTrack.map((t, i) => {
                const isClone = i >= galleryTiles.length;
                return (
                  <div
                    class="smile-tile"
                    aria-hidden={isClone || undefined}
                    inert={isClone || undefined}
                  >
                    <Image src={t.src} width={t.width} height={t.height} alt={t.alt} widths={[420, 640, 840]} sizes="420px" />
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>}

      {/* ---------- FAQ (paper) — native details/summary, zero JS ---------- */}
      {hasBlocks ? null : <section class="section" id="faq" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("faq").eyebrow}</span>
            <h2><Fragment set:html={section("faq").heading} /></h2>
          </div>

          <div class="faq-list">
            {
              faqs.map((f) => (
                <details class="faq" open={f.open}>
                  <summary>
                    <>
                      <h3>{f.q}</h3>
                      <span class="icon" aria-hidden="true">
                        +
                      </span>
                    </>
                  </summary>
                  <div class="answer">{f.a}</div>
                </details>
              ))
            }
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Still Have Questions? Free Virtual Consult</Button
              >
              <Button variant="ghost" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>}

      {
        /* ---------- VIRTUAL CONSULT — primary closing conversion.
         NOT a block and deliberately unguarded, like the breadcrumb, hero,
         `.keys` strip and the rail above: it renders on both sides of the
         switch and has no row in the map. It sits after the block run in
         template order and PageBlocks draws at the `why` position, so the
         closing pair still comes last. */
      }
      <VirtualConsult id="consult" eyebrow="Free bone grafting consultation">
        <Fragment slot="headline">Free bone grafting <em>consultation.</em></Fragment>
        <Fragment slot="body">
          Vivid Smiles Dentistry serves patients across Parker, Douglas County, and the surrounding
          communities. Schedule a free consultation <a
            href={bookNowHref}
            target="_blank"
            rel="noopener noreferrer">online</a
          > or call
          {' '}{phoneLabel} to find out whether bone grafting is the right next step for you.
        </Fragment>
      </VirtualConsult>

      {/* ---------- CLOSING BAND ---------- */}
      <FinalBand>
        <p>
          Dr. Bryce Richardson combines CBCT-guided planning with 600-plus hours of advanced
          surgical training to deliver bone grafting outcomes built to support implants for the long
          term.
        </p>
      </FinalBand>
    </main>

    <script>
      import { initTocSpy } from '../../scripts/toc-spy';
      initTocSpy('.bgraft');
    </script>

