---
/**
 * Porcelain Veneers — paid-traffic landing page.
 *
 * Lives at /veneers-lp/, the dedicated veneers funnel. A near-1:1 clone of the
 * cosmetic-dentistry LP, re-namespaced .cdlp-* → .vlp-* with
 * veneers-specific copy drawn from the legacy WordPress /veneers-lp page
 * (stunning, natural-looking, minimal-prep, never bulky or fake, warrantied).
 * Uses LandingLayout (stripped header + slim footer, no main nav). noindex by
 * default. Single CTA throughout: "Design my new smile" / "Book my free veneer
 * consult" → #consult (VirtualConsult Typeform) or the header/sticky popup.
 *
 * ── Typeform IDs (dedicated veneers forms) ──────────────────────────────────
 *   1. Header / sticky-CTA + every in-page Button popup → "dzCZRKFT"
 *      (typeformPopupId prop + each data-tf-popup attribute below)
 *   2. Final embedded form → <VirtualConsult typeformId="01KT2E9HXZK8G0YX9X3WNC44C8">
 *      (rendered as data-tf-live by VirtualConsult)
 *
 * Section order: Hero → Credentials → Smile gallery → Featured transformations →
 * Offer → Video story → How it works → Meet Dr. Richardson → Reviews →
 * Warranty → FAQ → Final form.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import LandingLayout from '../layouts/LandingLayout.astro';
import Button from '../components/Button.astro';
import VirtualConsult from '../components/VirtualConsult.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import ReviewCard from '../components/cards/ReviewCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import ProcessStepGrid from '../components/ProcessStepGrid.astro';
import { getSmiles } from '../lib/smiles';
import { phoneHref, phoneLabel } from '../data/contact';

// Doctor portrait (hero attribution chip + philosophy section) + featured cases
import imgRichardson from '../assets/images/team/dr-bryce-richardson.webp';
import imgAnnMarie from '../assets/images/people/real/ann-marie-muscarello-veneer-makeover.webp';
import imgBrittany from '../assets/images/people/real/brittany-fanning-smile-makeover.webp';

// Hero proof trio shown above the fold — three finished-smile photographs
// (distinct from the auto-loaded gallery marquee below, which still pulls
// getSmiles).
import imgHeroSide from '../assets/images/procedures/finished-veneers-side-smile-black.webp';
import imgHeroBerry from '../assets/images/procedures/berry-lip-smile-tilted.webp';
import imgHeroMacro from '../assets/images/procedures/smile-macro-front-view.webp';

// Warranty band editorial photo
import imgEditorial from '../assets/images/procedures/smile-with-diamond-detail.webp';

// Video-story thumbnails (YouTube shorts — clickable thumbnails only)
import storyMore from '../assets/images/video-stories/veneers-story-more-than-a-smile.webp';
import storyConfidence from '../assets/images/video-stories/veneers-story-confidence-restored.webp';
import storyLength from '../assets/images/video-stories/veneers-story-length-and-balance.webp';

// Accredited-by marquee logos — match home page composition
import logoAACD from '../assets/images/credentials/american-academy-of-cosmetic-dentistry.webp';
import logoAAID from '../assets/images/credentials/american-academy-of-implant-dentistry.webp';
import logoFAM from '../assets/images/credentials/full-arch-masters.webp';
import logoYomi from '../assets/images/facility/yomi-robotics.webp';
import logoADA from '../assets/images/credentials/american-dental-association.webp';
import logoGoogle from '../assets/images/credentials/google-reviews.png';
import { getPageContent } from '../lib/page-content';

// ── Smile gallery — auto-loaded from src/assets/images/smiles/.
const galleryTiles = getSmiles();
const galleryTrack = [...galleryTiles, ...galleryTiles];

// Hero proof trio (curated, above the fold). All three are finished-smile
// photographs; the first card spans full width as the main hero image.
const heroCases = [
  // mobileHero: on ≤991px this is the only hero image shown (above the copy);
  // the other two are hidden. Desktop keeps the full trio.
  {
    src: imgHeroSide,
    alt: 'Close-up photograph of a Vivid Smiles patient smiling, side view',
    mobileHero: true,
  },
  {
    src: imgHeroBerry,
    alt: 'Close-up photograph of a Vivid Smiles patient smiling, tilted three-quarter view',
  },
  {
    src: imgHeroMacro,
    alt: 'Close-up photograph of a Vivid Smiles patient smiling, straight-on front view',
  },
];

// ── Reviews — surface veneer/cosmetic-leaning reviews for the marquee, then top
// up from newest so we always have 6 cards. NOTE: the regex deliberately avoids
// the bare word "smile" (it would match the practice name "Vivid Smiles" in
// nearly every review). If no veneer reviews exist yet it honestly falls back to
// the 6 newest; veneer/whitening reviews added later float to the top.
const allReviews = (await getCollection('reviews')).sort((a, b) => +b.data.date - +a.data.date);
const cosmeticRe =
  /veneer|cosmetic|makeover|whiten|invisalign|aligner|porcelain|bonding|new smile|dream smile/i;
const cosmeticReviews = allReviews.filter(
  (r) => cosmeticRe.test((r.data.tags || []).join(' ')) || cosmeticRe.test(r.body ?? ''),
);
const pickedReviews = [
  ...cosmeticReviews,
  ...allReviews.filter((r) => !cosmeticReviews.includes(r)),
].slice(0, 6);
// Duplicated set for the seamless swipe-draggable review marquee (same drag
// contract as the smile gallery — initDraggableMarquee measures equal halves).
const reviewTrack = [...pickedReviews, ...pickedReviews];

// ── Featured transformations. Both NFL-cheerleader veneer quotes verbatim.
const featuredCases = [
  {
    img: imgAnnMarie,
    alt: 'Ann Marie Muscarello — porcelain veneer makeover by Dr. Richardson',
    firstName: 'Ann Marie',
    lastName: 'Muscarello',
    role: 'NFL Cheerleader',
    quote:
      'I chose Dr. Richardson because his before-and-afters were absolutely stunning, but what impressed me even more was how thorough and educated he was throughout the entire process. He walked me through every detail and made sure I felt completely confident in my decision. Now I get compliments on my smile all the time, and the first thing I say is ‘It was all Dr. Richardson.’',
    treatment: 'Custom Porcelain Veneers',
  },
  {
    img: imgBrittany,
    alt: 'Brittany Fanning — veneer smile makeover by Dr. Richardson',
    firstName: 'Brittany',
    lastName: 'Fanning',
    role: 'NFL Cheerleader',
    quote:
      "I was always a little self-conscious about my smile and would do a soft smile because I didn't like the discoloration or how my teeth looked. This whole process has been completely life-changing. I now have a beautiful, perfect smile, and I love it so much. No matter what room I walk into, whether I'm with my teammates, my friends, or my family, I have this extra confidence about me.",
    treatment: 'Custom Veneer Makeover',
  },
];

const offerItems = [
  'A personal 1-on-1 with Dr. Richardson — not a sales rep',
  'A full smile assessment and a digital preview of your new veneers',
  'A custom veneer treatment plan built around your goals',
  'Your exact cost — with financing options available',
  'Zero pressure, zero obligation',
];

const videoStories = [
  {
    img: storyMore,
    id: 'Nm7RjGKP8jw',
    h: 'More than a smile',
    p: 'How the right porcelain veneer plan resets confidence — at work, in photos, in everyday life.',
    featured: true,
  },
  {
    img: storyConfidence,
    id: 'EA19QZ4lk8k',
    h: 'Confidence, restored',
    p: 'What happens when the smile finally matches the person behind it.',
    featured: false,
  },
  {
    img: storyLength,
    id: 'fRyN4dHhizo',
    h: 'Length & balance',
    p: 'Restoring length, symmetry, and a fuller, natural finish with veneers.',
    featured: false,
  },
];

const howSteps = [
  {
    num: '01',
    tagline: 'Two minutes.',
    title: 'Book your free consult',
    label: 'Step One',
    body: 'Fill out the form or tap to call. Choose virtual or in-office — both go straight to Dr. Richardson.',
  },
  {
    num: '02',
    tagline: 'Face to face.',
    title: 'Meet Dr. Richardson',
    label: 'Step Two',
    body: 'He personally reviews your smile and goals — by custom video or in our Parker office. No sales rep, no pressure.',
  },
  {
    num: '03',
    tagline: 'Everything, upfront.',
    title: 'Get your plan & price',
    label: 'Step Three',
    body: 'Walk away with a personalized veneer treatment plan and your exact cost, including financing options. Then decide on your own timeline.',
  },
];

const trustBar = [
  {
    logo: logoAACD,
    alt: 'American Academy of Cosmetic Dentistry',
    title: 'AACD',
    sub: 'Member Dentist',
  },
  {
    logo: logoAAID,
    alt: 'American Academy of Implant Dentistry',
    title: 'AAID',
    sub: 'Implant Trained',
  },
  { logo: logoFAM, alt: 'Full Arch Masters', title: 'Full Arch Masters', sub: 'Clinical Mentor' },
  { logo: logoYomi, alt: 'Yomi Robotics', title: 'Yomi Robotics', sub: 'Certified Surgeon' },
  {
    logo: logoADA,
    alt: 'American Dental Association',
    title: 'ADA',
    sub: 'American Dental Association',
  },
  { logo: logoGoogle, alt: 'Google Reviews', title: '5.0 · 300+ Reviews', sub: 'Google Verified' },
];
const trustTrack = [...trustBar, ...trustBar];

const reinforcer =
  'Dr. Richardson reviews your smile, your goals, and gives you a personalized veneer plan and exact cost — no obligation, completely free.';

const pageTitle = 'Porcelain Veneers in Parker, CO — Vivid Smiles Dentistry';
const pageDescription =
  "Stunning, natural-looking porcelain veneers, designed by Colorado's #1 cosmetic dentist. Minimal-prep, never bulky or fake, and backed by a written warranty. Book a free veneer consult and walk away with a custom plan and your exact cost.";
// faqs is edited in WordPress (Pages -> Veneers Lp).
// The shapes are unchanged from the arrays that used to live here, so the
// markup below is untouched.
const { faqs, image } = await getPageContent(Astro.url.pathname);

---

<LandingLayout title={pageTitle} description={pageDescription} typeformPopupId="dzCZRKFT">
  <div class="vlp-page">
    <!-- ─────────────── S1. Hero (outcome-led) ─────────────── -->
    <section class="vlp-hero">
      <div class="vlp-hero-wrap">
        <div class="vlp-hero-copy" data-vs-reveal-batch>
          <span class="vlp-eyebrow">
            <span class="vlp-eyebrow-rule"></span>
            Porcelain Veneers · Parker, Colorado
          </span>
          <h1 class="vlp-h1">Stunning, natural-looking veneers.</h1>
          <p class="vlp-display">
            Hand-crafted by Colorado's <em>#1</em> cosmetic dentist.
          </p>
          <p class="vlp-hero-byline">
            <span class="vlp-hero-byline-photo">
              <Image
                src={image("imgRichardson").url} width={image("imgRichardson").width} height={image("imgRichardson").height}
                alt="Dr. Bryce Richardson, cosmetic dentist in Parker, Colorado"
                widths={[96, 144]}
                sizes="72px"
              />
            </span>
            <span class="vlp-hero-byline-text">
              In the hands of <strong>Dr. Bryce Richardson, DDS</strong>
            </span>
          </p>
          <p class="vlp-lede">
            A minimal-prep approach and a detailed smile design built around your face — for veneers
            that look natural, balanced, and uniquely you, never bulky or fake. Book a free consult
            and walk away with a custom plan and your exact cost.
          </p>
          <div class="vlp-hero-cta">
            <Button
              variant="gold"
              href="#consult"
              hoverLabel="Let's begin"
              data-tf-popup="dzCZRKFT"
              data-tf-transitive-search-params="utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_ad,utm_adset,gclid,fbclid"
              >Design my new smile</Button
            >
            <a class="vlp-hero-tel" href={phoneHref}>
              <i class="fa-solid fa-phone" aria-hidden="true"></i>
              <span>or call {phoneLabel}</span>
            </a>
          </div>
          <p class="vlp-hero-microcopy">Free · ~30 min with Dr. Richardson · No obligation</p>
          <ul class="vlp-hero-trust">
            <li><strong>5.0 ★</strong><span>300+ Google reviews</span></li>
            <li><strong>Top 1%</strong><span>Cosmetic dentists U.S.</span></li>
            <li><strong>AACD</strong><span>Member dentist</span></li>
          </ul>
        </div>
        <div class="vlp-hero-art" data-vs-reveal-batch>
          <div class="vlp-hero-cases">
            {
              heroCases.map((c, i) => (
                <figure class:list={['vlp-hero-case', { 'is-mobile-hero': c.mobileHero }]}>
                  <Image
                    src={c.src}
                    alt={c.alt}
                    widths={[600, 900, 1200, 1800]}
                    sizes="(max-width: 991px) 80vw, 460px"
                    quality={86}
                    loading={i === 0 || c.mobileHero ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 || c.mobileHero ? 'high' : undefined}
                  />
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────── Credential trust marquee ─────────────── -->
    <section class="vlp-trust" aria-label="Credentials and memberships">
      <div class="vlp-trust-card" data-vs-reveal>
        <div class="vlp-trust-label">Accredited by</div>
        <div class="vlp-trust-track">
          <div class="vlp-trust-strip">
            {
              trustTrack.map((t, i) => {
                const isClone = i >= trustBar.length;
                return (
                  <div
                    class="vlp-trust-item"
                    aria-hidden={isClone || undefined}
                    inert={isClone || undefined}
                  >
                    <span class="vlp-trust-logo">
                      <Image src={t.logo} alt={t.alt} />
                    </span>
                    <span class="vlp-trust-text">
                      <>
                        <b>{t.title}</b>
                        <small>{t.sub}</small>
                      </>
                    </span>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────── S2. Smile gallery (swipe-draggable) ─────────────── -->
    <section class="vlp-work">
      <div class="vlp-section-wrap">
        <div class="vlp-section-intro vlp-work-intro" data-vs-reveal-batch>
          <span class="vlp-eyebrow"
            ><span class="vlp-eyebrow-rule"></span>Real patients, real results</span
          >
          <h2 class="vlp-h2">Hundreds of smiles, <em>designed to look natural.</em></h2>
          <p class="vlp-body">
            Every case is custom-built around your facial features — no one-size-fits-all molds, no
            off-the-shelf shades. Drag to explore real smiles from our patients.
          </p>
        </div>
      </div>
      <div
        class="vlp-marquee"
        data-vs-marquee
        aria-label="Smile gallery — drag to explore"
      >
        <div class="vlp-marquee-track" data-vs-marquee-track>
          {
            galleryTrack.map((tile) => (
              <div class="vlp-marquee-tile">
                <Image
                  src={tile.src}
                  alt={tile.alt}
                  widths={[400, 600, 800]}
                  sizes="(max-width: 768px) 70vw, 360px"
                  draggable={false}
                />
              </div>
            ))
          }
        </div>
      </div>
      <div class="vlp-section-wrap vlp-work-cta">
        <p class="vlp-work-note">
          Every smile above belongs to an actual patient of Dr. Richardson.
        </p>
        <Button
          variant="gold"
          href="#consult"
          hoverLabel="Let's find out"
          data-tf-popup="dzCZRKFT"
          data-tf-transitive-search-params="utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_ad,utm_adset,gclid,fbclid"
          >See if I'm a candidate</Button
        >
      </div>
    </section>

    <!-- ─────────────── Featured transformations (NFL cheerleaders) ─────────────── -->
    <section class="vlp-ft">
      <div class="vlp-section-wrap">
        <div class="vlp-section-intro vlp-ft-intro" data-vs-reveal-batch>
          <span class="vlp-eyebrow"><span class="vlp-eyebrow-rule"></span>Featured cases</span>
          <h2 class="vlp-h2">Smiles they're <em>proud to show off.</em></h2>
        </div>
        <div class="vlp-ft-grid" data-vs-reveal-batch>
          {
            featuredCases.map((c) => (
              <figure class="vlp-ft-card">
                <div class="vlp-ft-img">
                  <Image
                    src={c.img}
                    alt={c.alt}
                    widths={[360, 540, 720]}
                    sizes="(max-width: 991px) 100vw, 360px"
                  />
                </div>
                <figcaption class="vlp-ft-body">
                  <blockquote class="vlp-ft-quote">&ldquo;{c.quote}&rdquo;</blockquote>
                  <div class="vlp-ft-meta">
                    <span class="vlp-ft-name">
                      {c.firstName} {c.lastName}
                    </span>
                    <span class="vlp-ft-role">{c.role}</span>
                    <span class="vlp-ft-treatment">{c.treatment}</span>
                  </div>
                </figcaption>
              </figure>
            ))
          }
        </div>
        <div class="vlp-ft-cta">
          <Button
            variant="gold"
            href="#consult"
            hoverLabel="Let's begin"
            data-tf-popup="dzCZRKFT"
            data-tf-transitive-search-params="utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_ad,utm_adset,gclid,fbclid"
            >Start my transformation</Button
          >
        </div>
      </div>
    </section>

    <!-- ─────────────── S3. The offer (grand-slam value stack) ─────────────── -->
    <section class="vlp-offer">
      <div class="vlp-section-wrap">
        <div class="vlp-offer-card" data-vs-reveal-batch>
          <div class="vlp-offer-copy">
            <span class="vlp-eyebrow"
              ><span class="vlp-eyebrow-rule"></span>Your free veneer consultation</span
            >
            <h2 class="vlp-h2">What you get on your <em>free veneer consultation.</em></h2>
            <span class="vlp-offer-value">A $500 value — <strong>free</strong></span>
          </div>
          <div class="vlp-offer-stack">
            <ul class="vlp-offer-list">
              {
                offerItems.map((item) => (
                  <li>
                    <i class="fa-solid fa-circle-check" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
            <Button
              variant="gold"
              href="#consult"
              hoverLabel="Let's begin"
              data-tf-popup="dzCZRKFT"
              data-tf-transitive-search-params="utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_ad,utm_adset,gclid,fbclid"
              >Claim my free consult</Button
            >
            <p class="vlp-cta-reinforcer">{reinforcer}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────── S4. Video patient story ─────────────── -->
    <section class="vlp-story">
      <div class="vlp-section-wrap">
        <div class="vlp-section-intro vlp-intro-center vlp-story-intro" data-vs-reveal-batch>
          <span class="vlp-eyebrow vlp-eyebrow--light"
            ><span class="vlp-eyebrow-rule"></span>In their own words</span
          >
          <h2 class="vlp-h2">Hear it straight from <em>our patients.</em></h2>
        </div>
        <div class="vlp-story-grid" data-vs-reveal-batch>
          {
            videoStories.map((s) => (
              <button
                type="button"
                class:list={['vlp-story-card', s.featured && 'vlp-story-card--featured']}
                data-video-id={s.id}
                data-video-short="true"
                data-video-title={s.h}
                aria-label={`Play patient story: ${s.h}`}
              >
                <div class="vlp-story-photo">
                  <Image
                    src={s.img}
                    alt={`Vivid Smiles patient story — ${s.h}`}
                    widths={[400, 800]}
                    sizes="(max-width: 780px) 100vw, 50vw"
                    draggable={false}
                  />
                  <span class="vlp-story-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      <path d="M8 5v14l11-7z" fill="currentColor" />
                    </svg>
                  </span>
                </div>
                <div class="vlp-story-body">
                  <h3>{s.h}</h3>
                  <p>{s.p}</p>
                  <span class="vlp-story-label">Porcelain Veneers</span>
                </div>
              </button>
            ))
          }
        </div>
      </div>

      <dialog
        class="vlp-story-video-modal"
        id="vlp-story-video-modal"
        aria-label="Patient story video"
      >
        <button
          type="button"
          class="vlp-story-video-close"
          data-video-close
          aria-label="Close video"
        >
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"
            ><path
              d="M6 6l12 12M18 6L6 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path></svg
          >
        </button>
        <div class="vlp-story-video-frame" data-video-frame></div>
      </dialog>

      <script is:inline>
        (() => {
          const modal = document.getElementById('vlp-story-video-modal');
          if (!modal) return;
          const frame = modal.querySelector('[data-video-frame]');
          const closeBtn = modal.querySelector('[data-video-close]');
          const cards = document.querySelectorAll('.vlp-story-card[data-video-id]');

          const openVideo = (id, title, isShort) => {
            if (!id) return;
            const iframe = document.createElement('iframe');
            iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
            iframe.title = title || 'Patient story video';
            iframe.allow =
              'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
            iframe.allowFullscreen = true;
            iframe.loading = 'lazy';
            frame.replaceChildren(iframe);
            modal.classList.toggle('is-short', !!isShort);
            if (typeof modal.showModal === 'function') modal.showModal();
            else modal.setAttribute('open', '');
            document.body.style.overflow = 'hidden';
          };

          const closeVideo = () => {
            frame.replaceChildren();
            modal.classList.remove('is-short');
            if (typeof modal.close === 'function' && modal.open) modal.close();
            else modal.removeAttribute('open');
            document.body.style.overflow = '';
          };

          cards.forEach((card) => {
            card.addEventListener('click', () => {
              openVideo(
                card.dataset.videoId,
                card.dataset.videoTitle,
                card.dataset.videoShort === 'true',
              );
            });
          });

          closeBtn?.addEventListener('click', closeVideo);
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeVideo();
          });
          modal.addEventListener('close', closeVideo);
          modal.addEventListener('cancel', (e) => {
            e.preventDefault();
            closeVideo();
          });
        })();
      </script>
    </section>

    <!-- ─────────────── S5. How it works ─────────────── -->
    <section class="vlp-how">
      <div class="vlp-section-wrap">
        <div class="vlp-section-intro vlp-intro-center vlp-how-intro" data-vs-reveal-batch>
          <span class="vlp-eyebrow"><span class="vlp-eyebrow-rule"></span>How it works</span>
          <h2 class="vlp-h2">One visit, <em>start to plan.</em></h2>
          <p class="vlp-body">
            No mystery, no pressure. Here's exactly what happens from the moment you reach out.
          </p>
        </div>
        <ProcessStepGrid class="vlp-how-grid">
          {
            howSteps.map((s) => (
              <ProcessStep num={s.num} tagline={s.tagline} title={s.title} label={s.label}>
                {s.body}
              </ProcessStep>
            ))
          }
        </ProcessStepGrid>
        <div class="vlp-how-cta">
          <Button
            variant="gold"
            href="#consult"
            hoverLabel="Let's begin"
            data-tf-popup="dzCZRKFT"
            data-tf-transitive-search-params="utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_ad,utm_adset,gclid,fbclid"
            >Book my free consult</Button
          >
          <p class="vlp-cta-reinforcer">{reinforcer}</p>
        </div>
      </div>
    </section>

    <!-- ─────────────── S6. Meet Dr. Richardson (demoted bio) ─────────────── -->
    <section class="vlp-philo">
      <div class="vlp-philo-wrap">
        <div class="vlp-philo-portrait" data-vs-reveal>
          <Image
            src={image("imgRichardson").url} width={image("imgRichardson").width} height={image("imgRichardson").height}
            alt="Dr. Bryce Richardson, founder and cosmetic dentist at Vivid Smiles"
            widths={[420, 640, 900]}
            sizes="(max-width: 991px) 100vw, 480px"
          />
          <div class="vlp-philo-sig">
            <span class="vlp-philo-sig-line">Bryce Richardson, DDS</span>
            <span class="vlp-philo-sig-sub">Founder · Cosmetic Dentist</span>
          </div>
        </div>
        <div class="vlp-philo-copy" data-vs-reveal-batch>
          <span class="vlp-eyebrow vlp-eyebrow--light"
            ><span class="vlp-eyebrow-rule"></span>Meet your dentist</span
          >
          <h2 class="vlp-philo-h">Artistry first. Veneers <em>designed around your face.</em></h2>
          <p class="vlp-philo-body">
            Dr. Richardson is recognized for veneers that look completely natural — using a
            <strong> minimal-prep</strong> approach and a detailed smile design to preserve your natural
            teeth and enhance your unique features, so results feel individual and never overdone. With
            600+ hours of advanced post-doctoral esthetic training, he personally designs and reviews
            every case.
          </p>
          <div class="vlp-philo-stats">
            <div>
              <strong>600+</strong>
              <span>Hours of advanced post-doctoral training</span>
            </div>
            <div>
              <strong>AACD</strong>
              <span>American Academy of Cosmetic Dentistry member</span>
            </div>
            <div>
              <strong>Top 1%</strong>
              <span>Cosmetic dentists nationally</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ─────────────── S7. Reviews (swipe-draggable marquee) ─────────────── -->
    <section class="vlp-reviews">
      <div class="vlp-section-wrap">
        <div class="vlp-reviews-head" data-vs-reveal-batch>
          <span class="vlp-eyebrow"><span class="vlp-eyebrow-rule"></span>Patient reviews</span>
          <div class="vlp-reviews-rating">
            <span class="vlp-reviews-score">5.0</span>
            <span class="vlp-reviews-stars">★★★★★</span>
            <span class="vlp-reviews-count">
              <Image
                src={image("logoGoogle").url} width={image("logoGoogle").width} height={image("logoGoogle").height}
                alt="Google"
                class="vlp-reviews-google"
                widths={[120]}
                sizes="80px"
              />
              300+ five-star reviews
            </span>
          </div>
        </div>
      </div>
      <div
        class="vlp-marquee vlp-marquee--reviews"
        data-vs-marquee
        aria-label="Patient reviews — drag to explore"
      >
        <div class="vlp-marquee-track" data-vs-marquee-track>
          {
            reviewTrack.map((r) => (
              <ReviewCard
                reviewer={r.data.reviewer}
                rating={r.data.rating}
                source={r.data.source}
                date={r.data.date}
                tags={r.data.tags}
              >
                {r.body}
              </ReviewCard>
            ))
          }
        </div>
      </div>
      <div class="vlp-section-wrap vlp-reviews-cta">
        <Button
          variant="gold"
          href="#consult"
          hoverLabel="Let's begin"
          data-tf-popup="dzCZRKFT"
          data-tf-transitive-search-params="utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_ad,utm_adset,gclid,fbclid"
          >Get my smile plan & price</Button
        >
      </div>
    </section>

    <!-- ─────────────── S8. Warranty / risk reversal ─────────────── -->
    <section class="vlp-close">
      <div class="vlp-close-wrap">
        <div class="vlp-close-photo" data-vs-reveal>
          <Image
            src={image("imgEditorial").url} width={image("imgEditorial").width} height={image("imgEditorial").height}
            alt="Macro close-up of a smile holding an emerald-cut diamond between the teeth — editorial detail"
            widths={[400, 600, 800]}
            sizes="(max-width: 880px) 100vw, 440px"
          />
        </div>
        <div class="vlp-close-copy" data-vs-reveal-batch>
          <span class="vlp-eyebrow vlp-eyebrow--light"
            ><span class="vlp-eyebrow-rule"></span>Backed by our warranty</span
          >
          <h2 class="vlp-close-h">
            Expect the highest quality care — <em>and a warranty on our work.</em>
          </h2>
          <p class="vlp-close-p">
            Maintain your routine checkups and if something breaks, we'll fix it. And if you're not
            in love with your smile, we make it right — in writing.
          </p>
          <ul class="vlp-close-guarantees">
            <li>
              <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
              <div><strong>Written warranty</strong><span>We stand behind our work.</span></div>
            </li>
            <li>
              <i class="fa-solid fa-gift" aria-hidden="true"></i>
              <div><strong>Free consult</strong><span>A $500 value — yours free.</span></div>
            </li>
            <li>
              <i class="fa-solid fa-handshake-angle" aria-hidden="true"></i>
              <div><strong>No obligation</strong><span>Zero pressure, ever.</span></div>
            </li>
            <li>
              <i class="fa-solid fa-award" aria-hidden="true"></i>
              <div><strong>Top 1% dentist</strong><span>AACD-trained cosmetic care.</span></div>
            </li>
          </ul>
          <Button
            variant="gold"
            href="#consult"
            hoverLabel="Let's begin"
            data-tf-popup="dzCZRKFT"
            data-tf-transitive-search-params="utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_ad,utm_adset,gclid,fbclid"
            >Design my new smile</Button
          >
        </div>
      </div>
    </section>

    <!-- ─────────────── S9. FAQ ─────────────── -->
    <section class="vlp-faq">
      <div class="vlp-section-wrap">
        <div class="vlp-section-intro vlp-intro-center vlp-faq-intro" data-vs-reveal-batch>
          <span class="vlp-eyebrow"><span class="vlp-eyebrow-rule"></span>Common questions</span>
          <h2 class="vlp-h2">Answers before <em>you ask.</em></h2>
        </div>
        <div class="vlp-faq-list" data-vs-reveal-batch>
          {
            faqs.map((f) => (
              <details class="vlp-faq-item" open={f.open}>
                <summary>
                  <h3>{f.q}</h3>
                  <span class="vlp-faq-icon" aria-hidden="true">
                    +
                  </span>
                </summary>
                <div class="vlp-faq-answer" set:html={f.a} />
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ─────────────── S10. Final form (scarcity + risk reversal) ─────────────── -->
    <VirtualConsult
      id="consult"
      eyebrow="Reserve your free consult"
      background="cream"
      typeformId="01KT2E9HXZK8G0YX9X3WNC44C8"
    >
      <Fragment slot="headline">
        Book your <em>free veneer consultation.</em>
      </Fragment>
      <Fragment slot="body">
        Dr. Richardson takes a limited number of new veneer cases each month. Fill out the form
        below — choose virtual or in-office — and reserve your spot. He personally reviews every
        request.
      </Fragment>
      <Fragment slot="reassure">
        <ul class="vlp-vc-reassure">
          <li><i class="fa-solid fa-circle-check" aria-hidden="true"></i><span>Free</span></li>
          <li>
            <i class="fa-solid fa-handshake-angle" aria-hidden="true"></i><span>No obligation</span>
          </li>
          <li>
            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span
              >Backed by our written warranty</span>
          </li>
        </ul>
      </Fragment>
    </VirtualConsult>
  </div>

  <StickyMobileCTA slot="stickyCTA" label="Book my free consult" typeformPopupId="dzCZRKFT" />
</LandingLayout>

