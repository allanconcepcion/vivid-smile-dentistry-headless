---
/**
 * Patient Testimonials — Vivid Smiles Dentistry, Parker CO.
 *
 *. Final page of the Astro build.
 * - Video stories grid + YouTube modal ported from src/pages/index.astro
 *   (lines 444–552). Same 3 patients (James, Chanel, Josh), same modal mechanic.
 * - Google reviews marquee ported from src/pages/index.astro (lines 585–629).
 *   Reads from the central reviews content collection — drop a new .md into
 *   src/content/reviews/ and it appears here on next build.
 * - Featured story (Wayne) keeps the verbatim quote from the legacy WP page;
 *   the visual is the All-On-X procedure imagery (not a Wayne portrait) until
 *   a real photo is sourced.
 *
 * Page-scoped styles: src/styles/pages/patient-testimonials.css
 * Reveals/parallax wired by src/scripts/animations.js via data-vs-reveal*.
 */
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import ReviewMarquee from "../../components/ReviewMarquee.astro";
import LocalTrust from "../../components/LocalTrust.astro";
import VirtualConsult from "../../components/VirtualConsult.astro";
import { bookNowHref, phoneHref } from "../../data/contact";
import "../../styles/pages/patient-testimonials.css";

// Reviews — newest first, matches home page
const reviews = (await getCollection("reviews"))
  .sort((a, b) => +b.data.date - +a.data.date);

// Patient story portraits (same 3 as home)
import storyJames from "../../assets/images/video-stories/james.webp";
import storyChanel from "../../assets/images/video-stories/chanel-patient-story.webp";
import storyJosh from "../../assets/images/video-stories/josh.webp";

// Cosmetic veneer story thumbnails — vertical 9:16 sourced from each short's
// oar2.jpg endpoint. First three mirror the home page; last four are exclusive
// to this page.
import veneerMore from "../../assets/images/video-stories/veneers-story-more-than-a-smile.webp";
import veneerConfidence from "../../assets/images/video-stories/veneers-story-confidence-restored.webp";
import veneerLength from "../../assets/images/video-stories/veneers-story-length-and-balance.webp";
import veneerFromTo from "../../assets/images/video-stories/veneers-story-from-veneers-to-allon-x.webp";
import veneerBonding from "../../assets/images/video-stories/veneers-story-bonding-vs-veneers.webp";
import veneerAnneMarie from "../../assets/images/video-stories/veneers-story-anne-marie.webp";
import veneerPrep from "../../assets/images/video-stories/veneers-story-no-prep-vs-minimal-prep.webp";

// Featured story visual. Not a Wayne portrait: until a real one is sourced
// from the practice, the page shows a real full-arch restoration from the
// practice's own lab work, per the "never fabricate practice content" rule.
// (This slot previously held a generated portrait of a man, which read as a
// stand-in for Wayne himself — exactly what that rule exists to prevent.)
import featuredImg from "../../assets/images/procedures/full-arch-restoration-model.webp";

// Hero image — Vivid Smiles team in the Parker studio.
import heroImg from "../../assets/images/team/vivid-smiles-team-candid.webp";
---

<BaseLayout
  title="Patient Testimonials — Vivid Smiles Dentistry · Parker, CO"
  description="Real patient stories and Google reviews from Vivid Smiles Dentistry. Watch James, Chanel, and Josh share their All-On-X transformations, and read 5-star reviews from patients across Parker, CO."
>
  <div class="patient-testimonials">

    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/about-us/">About Us</a>
        <span class="sep">/</span>
        <span class="here">Patient Testimonials</span>
      </div>
    </nav>

    <main id="main">

    {/* ---------- HERO ---------- */}
    <header class="hero" data-vs-reveal-batch>
      <div class="hero-inner">
        <div class="hero-copy">
          <span class="eyebrow">Real stories · Real patients</span>
          <h1 data-vs-reveal-lines>Real stories, <em>real transformations.</em></h1>
          <p class="hero-sub">
            From life-changing All-On-X full-arch makeovers to cosmetic redesigns,
            our patients share their experiences in their own words — and on their
            own terms. Every story on this page is a real Vivid Smiles patient.
          </p>
          <div class="hero-actions">
            <Button variant="sage" href={bookNowHref} hoverLabel="Let's Talk">Schedule a Consultation</Button>
            <Button variant="ghost" href="/smile-gallery/" hoverLabel="See Results">View the Gallery</Button>
            <div class="ratings">
              <span class="stars" aria-hidden="true">★★★★★</span>
              <span>5.0 · 300+ reviews</span>
            </div>
          </div>
        </div>
        <div class="hero-img" data-vs-reveal>
          <Image
            src={heroImg}
            alt="The Vivid Smiles Dentistry team walking outside their Parker, Colorado office"
            widths={[600, 900, 1300]}
            sizes="(max-width: 991px) 100vw, 45vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </header>

    {/* ---------- COSMETIC VENEER STORIES (vertical YouTube shorts) ---------- */}
    <section class="veneer-stories section dark" id="veneer-stories">
      <div class="wrap">
        <div class="veneer-stories-head" data-vs-reveal-batch>
          <span class="eyebrow">Cosmetic veneers</span>
          <h2>Cosmetic <em>transformations</em>.</h2>
          <p>
            From dramatic redesigns to subtle refinements — see how porcelain veneers can change a
            smile, a confidence level, and the way someone shows up day to day.
          </p>
        </div>

        <div class="veneer-stories-grid" data-vs-reveal-batch>
          <button type="button" class="story-card" data-video-id="Nm7RjGKP8jw" data-video-short="true" data-video-title="How veneers can change more than just your smile" aria-label="Play porcelain veneers story: more than a smile">
            <div class="story-photo">
              <Image src={veneerMore} alt="Porcelain veneers patient — confident after treatment" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>More than a smile</h4>
              <p>Porcelain veneers can change far more than the way teeth look. See how the right cosmetic plan resets confidence and presence — at work, in photos, in everyday life.</p>
              <span class="label">Porcelain Veneers</span>
            </div>
          </button>

          <button type="button" class="story-card" data-video-id="EA19QZ4lk8k" data-video-short="true" data-video-title="Her confidence after veneers says everything" aria-label="Play porcelain veneers story: confidence after veneers">
            <div class="story-photo">
              <Image src={veneerConfidence} alt="Porcelain veneers patient — close-up smile" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>Confidence, restored</h4>
              <p>A close look at what happens when the smile finally matches the person behind it. The veneers do their part — her confidence does the rest.</p>
              <span class="label">Porcelain Veneers</span>
            </div>
          </button>

          <button type="button" class="story-card" data-video-id="fRyN4dHhizo" data-video-short="true" data-video-title="How veneers can add length and improve your smile" aria-label="Play porcelain veneers story: length and balance">
            <div class="story-photo">
              <Image src={veneerLength} alt="Porcelain veneers patient — after photo showing restored tooth length" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>Length &amp; balance</h4>
              <p>Worn or short teeth can leave a smile looking aged or out of proportion. Watch how porcelain veneers restore length, symmetry, and a fuller, more natural finish.</p>
              <span class="label">Porcelain Veneers</span>
            </div>
          </button>

          <button type="button" class="story-card" data-video-id="cxTCF1T_1mI" data-video-short="true" data-video-title="From veneers to All-on-X — life-changing smile transformations" aria-label="Play cosmetic transformation story: veneers to All-on-X">
            <div class="story-photo">
              <Image src={veneerFromTo} alt="Cosmetic dentistry patient seated during her story interview" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>From veneers to All-on-X</h4>
              <p>Two paths to a confident smile. Dr. Richardson walks through when porcelain veneers fit, when All-on-X is the better answer, and how to know which path is yours.</p>
              <span class="label">Smile Transformations</span>
            </div>
          </button>

          <button type="button" class="story-card" data-video-id="xYQ3QhwdElQ" data-video-short="true" data-video-title="Composite bonding vs porcelain veneers — what looks better long term" aria-label="Play cosmetic dentistry story: bonding vs veneers">
            <div class="story-photo">
              <Image src={veneerBonding} alt="Cosmetic dentistry patient with natural smile" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>Bonding or veneers?</h4>
              <p>Composite bonding or porcelain veneers — which holds up better? Dr. Richardson breaks down the trade-offs in looks, durability, and how long each one lasts.</p>
              <span class="label">Bonding vs Veneers</span>
            </div>
          </button>

          <button type="button" class="story-card" data-video-id="YpYD7_40HRc" data-video-short="true" data-video-title="Anne Marie's porcelain veneer story" aria-label="Play Anne Marie's porcelain veneer story">
            <div class="story-photo">
              <Image src={veneerAnneMarie} alt="Anne Marie — porcelain veneers patient story" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>Anne Marie</h4>
              <p>Anne Marie's porcelain veneer story — the before, the design conversation, and the moment she saw her finished smile for the first time.</p>
              <span class="label">Porcelain Veneers</span>
            </div>
          </button>

          <button type="button" class="story-card" data-video-id="7GDoh2uKt-s" data-video-short="true" data-video-title="No prep vs minimal prep veneers — do they shave your teeth" aria-label="Play porcelain veneers story: no-prep vs minimal-prep">
            <div class="story-photo">
              <Image src={veneerPrep} alt="Cosmetic dentistry patient laughing in studio" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>No-prep or minimal-prep?</h4>
              <p>The truth about how much tooth structure veneers actually remove. When no-prep wins, when minimal-prep wins, and what fits each smile.</p>
              <span class="label">Veneer Prep</span>
            </div>
          </button>
        </div>
      </div>
    </section>

    {/* ---------- PATIENT STORIES (video grid) ---------- */}
    <section class="stories" id="stories">
      <div class="wrap">
        <div class="stories-head" data-vs-reveal-batch>
          <span class="eyebrow">Some happy smiles</span>
          <h2>Patient success <em>stories</em></h2>
          <p>
            From full-mouth dental implant makeovers to life-changing reconstructive work, our patients
            share their experiences in their own words.
          </p>
        </div>

        <div class="stories-grid" data-vs-reveal-batch>
          <button type="button" class="story-card" data-video-id="x7cG4E6xAsQ" data-video-title="James — All-On-X patient story" aria-label="Play James's patient story video">
            <div class="story-photo">
              <Image src={storyJames} alt="James — patient story" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>James</h4>
              <p>After years of struggling with temporary fixes, James opted for the All-On-X dental implant procedure, restoring not just his teeth, but his confidence at the job site.</p>
              <span class="label">All-On-X · Full Arch</span>
            </div>
          </button>
          <button type="button" class="story-card" data-video-id="PGhz9GHqY-I" data-video-title="Chanel — All-On-X patient story" aria-label="Play Chanel's patient story video">
            <div class="story-photo">
              <Image src={storyChanel} alt="Chanel — patient story" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>Chanel</h4>
              <p>Tired of battling severe tooth decay and hiding behind uncomfortable clip-on veneers, Chanel chose a complete Upper &amp; Lower All-On-X transformation.</p>
              <span class="label">All-On-X · Upper &amp; Lower</span>
            </div>
          </button>
          <button type="button" class="story-card" data-video-id="xsW129a1VfA" data-video-title="Josh — All-On-X patient story" aria-label="Play Josh's patient story video">
            <div class="story-photo">
              <Image src={storyJosh} alt="Josh — patient story" widths={[400, 800]} sizes="(max-width: 780px) 100vw, 33vw" />
              <span class="play-btn" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            </div>
            <div class="story-body">
              <h4>Josh</h4>
              <p>Failing teeth had slowly chipped away at Josh's quality of life. An Upper All-On-X procedure gave him back the freedom to eat, smile, and live without hesitation.</p>
              <span class="label">All-On-X · Upper Arch</span>
            </div>
          </button>
        </div>
      </div>

      <dialog class="story-video-modal" id="story-video-modal" aria-label="Patient story video">
        <button type="button" class="story-video-close" data-video-close aria-label="Close video">
          <svg viewBox="0 0 24 24" focusable="false" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <div class="story-video-frame" data-video-frame></div>
      </dialog>

      <script is:inline>
        // Wrap in DOMContentLoaded so the selector picks up [data-video-id]
        // elements that appear AFTER this script in the DOM (e.g. the
        // featured Wayne video card in the next section).
        const initStoryVideoModal = () => {
          const modal = document.getElementById("story-video-modal");
          if (!modal) return;
          const frame = modal.querySelector("[data-video-frame]");
          const closeBtn = modal.querySelector("[data-video-close]");
          // Any element with data-video-id opens the modal — the 3 story cards
          // above + the featured Wayne video card below.
          const cards = document.querySelectorAll("[data-video-id]");

          const openVideo = (id, title, isShort) => {
            if (!id) return;
            const iframe = document.createElement("iframe");
            iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
            iframe.title = title || "Patient story video";
            iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
            iframe.allowFullscreen = true;
            iframe.loading = "lazy";
            frame.replaceChildren(iframe);
            modal.classList.toggle("is-short", !!isShort);
            if (typeof modal.showModal === "function") modal.showModal();
            else modal.setAttribute("open", "");
            document.body.style.overflow = "hidden";
          };

          const closeVideo = () => {
            frame.replaceChildren();
            modal.classList.remove("is-short");
            if (typeof modal.close === "function" && modal.open) modal.close();
            else modal.removeAttribute("open");
            document.body.style.overflow = "";
          };

          cards.forEach((card) => {
            card.addEventListener("click", () => {
              openVideo(card.dataset.videoId, card.dataset.videoTitle, card.dataset.videoShort === "true");
            });
          });

          closeBtn?.addEventListener("click", closeVideo);
          modal.addEventListener("click", (e) => {
            if (e.target === modal) closeVideo();
          });
          modal.addEventListener("close", closeVideo);
          modal.addEventListener("cancel", (e) => {
            e.preventDefault();
            closeVideo();
          });
        };
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initStoryVideoModal);
        } else {
          initStoryVideoModal();
        }
      </script>
    </section>

    {/* ---------- FEATURED STORY — Wayne ---------- */}
    <section class="featured" id="featured-story" aria-labelledby="featured-heading">
      <div class="wrap">
        <div class="featured-grid">
          <button
            type="button"
            class="featured-video"
            data-video-id="zB7sZjzktjA"
            data-video-title="Wayne — All-On-X patient story"
            aria-label="Play Wayne's patient story video"
            data-vs-reveal
          >
            <Image
              src={featuredImg}
              alt="Full-arch restoration on a dental model, held in a gloved hand"
              widths={[600, 900, 1300]}
              sizes="(max-width: 991px) 100vw, 50vw"
            />
            <span class="featured-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
            </span>
            <span class="featured-runtime" aria-hidden="true">Watch Wayne's story</span>
          </button>
          <div class="featured-copy" data-vs-reveal-batch>
            <span class="eyebrow">Featured story</span>
            <h2 id="featured-heading">Wayne's remarkable <em>transformation.</em></h2>
            <p class="featured-quote">
              "Hear how Wayne's journey to a healthier, more confident smile with
              an All-On-X upper arch has already changed his life."
            </p>
            <p>
              Press play to hear Wayne's story in his own words — what life looked like before
              his All-On-X upper arch, and what changed after. Then explore the protocol Dr.
              Richardson uses for full-arch implant cases at Vivid Smiles.
            </p>
            <div class="featured-actions">
              <Button variant="sage" href="/implant-dentistry/all-on-4-single-arch/" hoverLabel="Learn More">Explore All-On-X</Button>
              <Button variant="ghost" href="/smile-gallery/" hoverLabel="See Results">View More Cases</Button>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- SAGE DIVIDER STRIP — band rhythm fix + social proof ---------- */}
    <aside class="divider-strip" aria-label="Practice trust signals">
      <div class="wrap">
        <div class="divider-inner" data-vs-reveal>
          <span class="divider-stars" aria-hidden="true">★★★★★</span>
          <span class="divider-text">Trusted by patients locally and from out of state · 5.0 on Google · 300+ reviews</span>
        </div>
      </div>
    </aside>

    {/* ---------- TESTIMONIALS (marquee) ---------- */}
    <section class="testi" id="reviews">
      <div class="wrap">
        <div class="testi-head" data-vs-reveal-batch>
          <span class="eyebrow">Testimonials</span>
          <h2>5-Star <em>Smiles</em></h2>
          <div class="stars">★★★★★</div>
          <p>Hear from some of our happy patients. Vivid Smiles Dentistry is the only dentist with a 5-star rating in Parker, CO.</p>
        </div>
        <div class="testi-actions" data-vs-reveal>
          <Button variant="sage" href="https://share.google/CletN4Tfk51TpK4It" hoverLabel="See Reviews">Read More on Google</Button>
        </div>
      </div>
      <ReviewMarquee reviews={reviews} ariaLabel="Patient testimonials" />
    </section>

    {/* ---------- LOCAL TRUST ---------- */}
    <LocalTrust
      id="visit"
      eyebrow="Visit the studio"
      heading="Where every"
      headingItalic="story starts."
      intro="Every patient on this page began with one conversation at our Parker studio. Stop by, take a tour, and meet the team."
      body="We're an independently owned cosmetic and implant practice in Parker, Colorado. Patients come to us locally and from out of state for full-arch implant work, smile makeovers, and complex cosmetic cases."
      ctas={[
        { label: "Book Online", href: bookNowHref, variant: "sage", hoverLabel: "Book Now" },
        { label: "Call the Office", href: phoneHref, variant: "ghost", hoverLabel: "Tap to Call" },
      ]}
    />

    {/* ---------- VIRTUAL CONSULT — closing conversion ---------- */}
    <VirtualConsult id="consult" eyebrow="Free virtual consultation">
      <Fragment slot="headline">Ready to write <em>your story?</em></Fragment>
      <Fragment slot="body">
        Every transformation on this page started the same way — a few photos, a few
        questions, and a custom video back from Dr. Richardson. Skip the office visit
        for the first conversation and see what's possible for your smile.
      </Fragment>
    </VirtualConsult>

    </main>

    {/* ---------- JSON-LD: BreadcrumbList ---------- */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",                  "item": new URL("/", Astro.site).href },
        { "@type": "ListItem", "position": 2, "name": "About Us",              "item": new URL("/about-us/", Astro.site).href },
        { "@type": "ListItem", "position": 3, "name": "Patient Testimonials",  "item": new URL("/patient-testimonials/", Astro.site).href }
      ]
    })} />

  </div>
</BaseLayout>
