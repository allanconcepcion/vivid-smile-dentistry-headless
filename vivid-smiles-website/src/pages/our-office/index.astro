---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import ImageFrame from "../../components/ImageFrame.astro";
import VirtualConsult from "../../components/VirtualConsult.astro";
import {
  phoneHref,
  phoneLabel,
  phoneE164,
  bookNowHref,
  directionsHref,
  addressStreet,
  addressCity,
  addressState,
  addressZip,
  addressLine,
  emailAddress,
  emailHref,
} from "../../data/contact";
import { officeHours, openingHoursSpecification } from "../../data/hours";
import "../../styles/pages/our-office.css";


// The two portrait cells are intentionally placed in 1×2 vertical cells
// in the bento grid so they crop cleanly instead of squashing.

import { getPageContent } from '../../lib/page-content';
// faqs is edited in WordPress (Pages -> Our Office in Parker, CO).
// The shapes are unchanged from the arrays that used to live here, so the
// markup below is untouched.
const { faqs, section, image, seo } = await getPageContent(Astro.url.pathname);



// `output=embed` avoids needing a Google Maps API key.
const mapEmbedSrc = `https://maps.google.com/maps?q=${encodeURIComponent(addressLine)}&output=embed`;

const expectTiles = [
  {
    icon: "fa-solid fa-square-parking",
    title: "Free on-site parking",
    body: "Directly in front of the building. Accessible spaces nearest the entrance.",
  },
  {
    icon: "fa-solid fa-door-open",
    title: "Ground-floor entrance",
    body: "Single-suite practice on the ground floor — no stairs to navigate.",
  },
  {
    icon: "fa-solid fa-spa",
    title: "Calm, modern interior",
    body: "Designed to feel more like a wellness studio than a dental clinic.",
  },
  {
    icon: "fa-solid fa-star",
    title: "300+ five-star reviews",
    body: "From patients across Parker and beyond — locally and from out of state.",
  },
];

const description =
  "Tour our Parker, CO dental office. Free on-site parking, ground-floor entrance, a calm modern interior, and Yomi robotic-assisted implant surgery. 300+ five-star reviews.";

---

<BaseLayout
  title={seo.title || "Our Office in Parker, CO | Vivid Smiles Dentistry"}
  description={description}
 noindex={seo.noindex}>
  <div class="vs-office">

    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/about-us/">About Us</a>
        <span class="sep">/</span>
        <span class="here">Our Office</span>
      </div>
    </nav>

    <main id="main">

    {/* ---------- HERO (paper) — copy + ImageFrame (neon sign + entry doors) ---------- */}
    <header class="hero" data-vs-reveal-batch>
      <div class="wrap hero-inner">

        <div class="hero-copy">
          <span class="eyebrow">Our Office · Parker, CO</span>
          <h1 data-vs-reveal-lines>
            Step inside our <em>Parker office.</em>
          </h1>
          <p class="hero-sub">
            Our practice is on Cedar Gulch Parkway in Parker — a calm, modern interior
            designed to feel more like a wellness studio than a dental clinic, with
            free parking right out front and a ground-floor entrance.
          </p>
          <div class="hero-actions">
            <Button variant="sage" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button>
            <Button variant="ghost" href={directionsHref} hoverLabel="Open Map">Get Directions</Button>
            <div class="ratings">
              <span class="stars" aria-hidden="true">★★★★★</span>
              <span>5.0 · 300+ reviews</span>
            </div>
          </div>
        </div>

        <ImageFrame
          primary={{ src: image("heroPrimary").url, width: image("heroPrimary").width, height: image("heroPrimary").height, alt: "Waiting room lounge at Vivid Smiles Dentistry in Parker, CO" }}
          inset={{ src: image("heroInset").url, width: image("heroInset").width, height: image("heroInset").height, alt: "Entry doors with Vivid Smiles Dentistry logo at our Parker, CO office" }}
        />

      </div>
    </header>

    {/* ---------- BENTO GALLERY (cream) — curated facility tour ---------- */}
    <section class="section alt" id="tour" data-vs-reveal-batch>
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow">{section("tour").eyebrow}</span>
          <h2><Fragment set:html={section("tour").heading} /></h2>
          <p>{section("tour").body}</p>
        </div>

        <div class="bento">
          <div class="bento-tile tile-a">
            <Image
              src={image("bentoA").url} width={image("bentoA").width} height={image("bentoA").height}
              alt="Reception desk and front office area at Vivid Smiles"
              widths={[480, 720, 960, 1280]}
              sizes="(max-width: 640px) 100vw, (max-width: 991px) 60vw, 50vw"
            />
          </div>
          <div class="bento-tile tile-b">
            <Image
              src={image("bentoB").url} width={image("bentoB").width} height={image("bentoB").height}
              alt="Operatory at Vivid Smiles Dentistry, Parker, CO"
              widths={[260, 420, 560]}
              sizes="(max-width: 640px) 100vw, 22vw"
            />
          </div>
          <div class="bento-tile tile-c">
            <Image
              src={image("bentoC").url} width={image("bentoC").width} height={image("bentoC").height}
              alt="Neon Vivid Smiles sign glowing softly in the waiting lounge"
              widths={[260, 420, 560]}
              sizes="(max-width: 640px) 100vw, 22vw"
            />
          </div>
          <div class="bento-tile tile-d">
            <Image
              src={image("bentoD").url} width={image("bentoD").width} height={image("bentoD").height}
              alt="Dr. Bryce Richardson and Dr. Annelise Westermeier in the Vivid Smiles hallway"
              widths={[480, 720, 960]}
              sizes="(max-width: 640px) 100vw, 50vw"
            />
          </div>
          <div class="bento-tile tile-e">
            <Image
              src={image("bentoE").url} width={image("bentoE").width} height={image("bentoE").height}
              alt="A patient being welcomed at the reception desk"
              widths={[480, 720, 960]}
              sizes="(max-width: 640px) 100vw, 50vw"
            />
          </div>
        </div>
      </div>
    </section>

    {/* ---------- TECH + EQUIPMENT (sage) — Yomi + intra-oral scanning ---------- */}
    <section class="section dark" id="technology" data-vs-reveal-batch>
      <div class="wrap">
        <div class="tech-grid">
          <div class="tech-copy">
            <span class="eyebrow light">Technology in the Room</span>
            <h2><Fragment set:html={section("technology").heading} /></h2>
            <p class="lede">{section("technology").body}</p>

            <ul class="tech-list">
              <li>
                <span class="tech-pill">Yomi Robotic Surgery</span>
                <p>Robot-assisted implant placement with sub-millimeter precision.</p>
              </li>
              <li>
                <span class="tech-pill">Intra-Oral Scanning</span>
                <p>Digital 3D scans replace traditional dental impressions — fast and comfortable.</p>
              </li>
              <li>
                <span class="tech-pill">Digital Smile Design</span>
                <p>Preview your smile transformation on-screen before any work begins.</p>
              </li>
              <li>
                <span class="tech-pill">Same-Day Crowns</span>
                <p>Design, mill, and place a porcelain crown in a single visit.</p>
              </li>
            </ul>

            <div class="tech-actions">
              <Button variant="light" href="/cosmetic-dentistry/" hoverLabel="See How">Cosmetic Dentistry</Button>
              <Button variant="outline-light" href="/implant-dentistry/" hoverLabel="See How">Implant Dentistry</Button>
            </div>
          </div>

          <ImageFrame
            primary={{ src: image("techPrimary").url, width: image("techPrimary").width, height: image("techPrimary").height, alt: "Dr. Bryce Richardson placing a dental implant with the Yomi robotic arm at Vivid Smiles Dentistry" }}
            inset={{ src: image("techInset").url, width: image("techInset").width, height: image("techInset").height, alt: "Hygienist polishing a patient's teeth chairside" }}
          />
        </div>
      </div>
    </section>

    {/* ---------- WHAT TO EXPECT (paper) — 4-tile arrival-experience strip ---------- */}
    <section class="section" id="expect" data-vs-reveal-batch>
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow">{section("expect").eyebrow}</span>
          <h2><Fragment set:html={section("expect").heading} /></h2>
        </div>

        <div class="expect-grid">
          {expectTiles.map((t) => (
            <div class="expect-tile">
              <span class="expect-ic" aria-hidden="true"><i class={t.icon}></i></span>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- LOCATION + HOURS + MAP (cream) ----------
         Mirrors the /contact/ band — two-column: location card (address,
         phone, email, hours table) + iframe map. Re-themed for the cream
         background; same data sources. */}
    <section class="section alt" id="visit" aria-label="Visit our office">
      <div class="wrap">
        <div class="location-grid">
          <div class="location-copy" data-vs-reveal-batch>
            <span class="eyebrow">{section("visit").eyebrow}</span>
            <h2><Fragment set:html={section("visit").heading} /></h2>
            <p class="lede">{section("visit").body}</p>

            <div class="location-card">
              <div class="row">
                <span class="ic" aria-hidden="true"><i class="fa-solid fa-location-dot"></i></span>
                <div>
                  <span class="label">Address</span>
                  <span class="val">{addressStreet}<br>{addressCity}, {addressState} {addressZip}</span>
                </div>
              </div>

              <div class="row">
                <span class="ic" aria-hidden="true"><i class="fa-solid fa-phone"></i></span>
                <div>
                  <span class="label">Phone</span>
                  <a href={phoneHref}>{phoneLabel}</a>
                </div>
              </div>

              <div class="row">
                <span class="ic" aria-hidden="true"><i class="fa-solid fa-envelope"></i></span>
                <div>
                  <span class="label">Email</span>
                  <a href={emailHref}>{emailAddress}</a>
                </div>
              </div>

              <div class="row">
                <span class="ic" aria-hidden="true"><i class="fa-solid fa-clock"></i></span>
                <div>
                  <span class="label">Hours</span>
                  <div class="hours-table">
                    {officeHours.map((r) => (
                      <div class:list={["day-row", !r.opens && "closed"]}>
                        <span class="day">{r.label}</span>
                        <span class="hrs">{r.hoursLong}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <div class="location-actions">
              <Button variant="light" href={directionsHref} hoverLabel="Open Map">Get Directions</Button>
              <Button variant="ghost-light" href={phoneHref} hoverLabel="Tap to Dial">Call {phoneLabel}</Button>
            </div>
          </div>

          <div class="location-map-wrap" data-vs-reveal>
            <iframe
              class="location-map"
              src={mapEmbedSrc}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Map showing Vivid Smiles Dentistry at ${addressLine}`}
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    {/* ---------- FAQ (sage dark) — native details/summary ---------- */}
    <section class="section dark" id="faq" data-vs-reveal-batch>
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow light">Office FAQ</span>
          <h2><Fragment set:html={section("faq").heading} /></h2>
        </div>

        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq" open={f.open}>
              <summary><h3>{f.q}</h3><span class="icon" aria-hidden="true">+</span></summary>
              <div class="answer" set:html={f.a} />
            </details>
          ))}
        </div>
      </div>
    </section>

    {/* ---------- CLOSING — VirtualConsult (cream default) ---------- */}
    <VirtualConsult id="consult" eyebrow="Plan your first visit">
      <Fragment slot="headline">Plan your <em>first visit.</em></Fragment>
      <Fragment slot="body">
        Book online, give us a call, or send a quick virtual consult with a photo
        or two — whatever's easiest. Our team will take it from there.
      </Fragment>
    </VirtualConsult>

    </main>

    {/* JSON-LD — Dentist (LocalBusiness subtype), BreadcrumbList, FAQPage.
        Pattern matches /contact/ for consistency; openingHoursSpecification +
        address pull from src/data/hours.ts and src/data/contact.ts. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Dentist",
      "name": "Vivid Smiles Dentistry",
      "image": new URL("/apple-touch-icon.png", Astro.site).href,
      "url": new URL("/our-office/", Astro.site).href,
      "telephone": phoneE164,
      "email": emailAddress,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": addressStreet,
        "addressLocality": addressCity,
        "addressRegion": addressState,
        "postalCode": addressZip,
        "addressCountry": "US"
      },
      "openingHoursSpecification": openingHoursSpecification,
      "priceRange": "$$",
      "areaServed": ["Parker, CO", "Castle Rock, CO", "Lone Tree, CO"]
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",       "item": new URL("/", Astro.site).href },
        { "@type": "ListItem", "position": 2, "name": "About Us",   "item": new URL("/about-us/", Astro.site).href },
        { "@type": "ListItem", "position": 3, "name": "Our Office", "item": new URL("/our-office/", Astro.site).href }
      ]
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": f.a.replace(/<[^>]+>/g, "")
        }
      }))
    })} />

  </div>
</BaseLayout>
