---
/**
 * Copy + program policies are ported verbatim from the live WordPress page
 * at https://vividsmilesdentistry.com/referral-program/. Do not edit the
 * reward amount, eligibility rules, household cap, or FAQ answers without
 * front-desk authority — they describe a real practice promise.
 */
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import FinalBand from "../../components/FinalBand.astro";
import { phoneHref, phoneLabel } from "../../data/contact";
import "../../styles/pages/referral-program.css";

import { getPageContent } from '../../lib/page-content';
import PageBlocks from '../../blocks/PageBlocks.astro';
// faqs is edited in WordPress (Pages -> Referral Program).
// The shapes are unchanged from the arrays that used to live here, so the
// markup below is untouched.
const { blocks, hasBlocks, faqs, section, image, seo } = await getPageContent(Astro.url.pathname);

/**
 * THE MIGRATION SWITCH (docs/PAGE-BLOCKS.md 2.3), documented here and nowhere
 * in the markup below.
 *
 * `hasBlocks` means "this build can draw this page from its blocks", not
 * "WordPress sent rows" (src/lib/page-content.ts). True: PageBlocks draws the
 * two block bands at the position `#how-it-works` used to start. False — every
 * build until this route is back-filled, and again the moment an editor empties
 * the field — every band renders exactly as it always has.
 *
 * TWO BANDS ARE BLOCKS, each with exactly one row in
 * cms/import/routes/referral-program.json: #how-it-works (process_steps) and
 * #faq (faq). Everything else stays unguarded, in two senses:
 *
 *   `.crumbs`, `.hero` and <FinalBand> are CHROME — never blocks
 *   (docs/PAGE-BLOCKS.md 7, "Not a block, even though it is a band").
 *
 *   `#program` is page copy no registered layout expresses: `.story-grid` plus
 *   the bespoke `aside.reward-card` ($50 + $50 stack, `.reward-meta`, jump
 *   link). `pricing_tiers` draws plan cards with name/price/features and this
 *   is neither. It stays unguarded, which is ORDER-SAFE only because it LEADS —
 *   it sits above #how-it-works, the first block, so the block run starting
 *   there leaves it exactly where it was. Put a block before it and this
 *   becomes the LocalTrust fault. Its `sections[program]` row keeps feeding the
 *   template and is listed under `exempt.sections` on the route.
 *
 * A band guarded with no row VANISHES on backfill; a band with a row and no
 * guard renders TWICE at the bottom carrying a duplicate id. Both have happened
 * on this project. There is no third outcome.
 *
 * NO RAIL ON THIS PAGE. `tocLinks` is null on the live endpoint and the
 * template draws no `.toc` nav, so there is no derived-TOC loop here — carrying
 * one would be a loop feeding nothing.
 *
 * THE GUARDS CARRY NO COMMENT EXPRESSIONS. Astro preserves whitespace between
 * expressions, so a comment on its own line leaves newline-and-indent TEXT
 * NODES either side of itself on BOTH branches. Every guard below is written
 * flush where its `<section>` sat: `hasBlocks ? … : <section` on the opening
 * line, `</section>}` on the closing one.
 */

/**
 * The FAQPage entities, taken from whatever actually renders.
 *
 * Structured data lives on the page, not in the band. Left reading the legacy
 * `faqs` repeater it would keep describing the pre-migration content the moment
 * an editor edits the block's rows in wp-admin — a rich result that disagrees
 * with the page. The two sources are identical today by construction: the
 * block's `items` are MOVED from this same repeater, so the false branch below
 * serialises byte-for-byte what it always has.
 */
const faqEntities = (
  hasBlocks
    ? (
        (blocks.find((b) => b.__typename === 'PageFieldsBlocksFaqLayout')?.items ?? []) as {
          question?: string | null;
          answer?: string | null;
        }[]
      ).map((i) => ({ q: i.question ?? '', a: i.answer ?? '' }))
    : faqs.map((f) => ({ q: f.q, a: f.a }))
);


const steps = [
  {
    tag: "Step One",
    num: "01",
    title: "Your friend mentions your name",
    body: "When your friend or family member books their first visit, they just need to mention your name at check-in — or hand the front desk a referral card.",
  },
  {
    tag: "Step Two",
    num: "02",
    title: "We credit both of your accounts",
    body: "After their first appointment is complete, we'll add a $50 credit to both of your accounts. No paperwork, no claim forms, no hassle.",
  },
  {
    tag: "Step Three",
    num: "03",
    title: "Use it on a future visit",
    body: "Referral cards are available at the front desk if you'd like one, but they're not required to participate. Use your credit toward any future dental service with us.",
  },
];

const description =
  "Refer a friend to Vivid Smiles Dentistry in Parker, CO and you both get $50 credit toward future dental care. No paperwork, no hassle — just say thank you for the trust.";

---

<BaseLayout
  title={seo.title || "Referral Program — Vivid Smiles Dentistry"}
  description={description}
 noindex={seo.noindex}>
  <div class="rp">

    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/new-patients/">Patient Resources</a>
        <span class="sep">/</span>
        <span class="here">Referral Program</span>
      </div>
    </nav>

    <main id="main">

    {/* ---------- HERO (paper) ---------- */}
    <header class="hero" data-vs-reveal-batch>
      <div class="wrap hero-inner">

        <div class="hero-copy">
          <span class="eyebrow">Referral Program · Vivid Smiles</span>
          <h1 data-vs-reveal-lines>
            Refer a friend, <em>share a smile.</em>
          </h1>
          <p class="hero-sub">
            The best compliment you can give us is a referral. When you share your
            positive experience at Vivid Smiles Dentistry, you're helping your
            friends and family receive the same exceptional care — and as a thank
            you, both you and your referral will earn a <b>$50 credit</b> toward
            your next dental visit.
          </p>
          <div class="hero-actions">
            <Button variant="sage" href="#how-it-works" hoverLabel="See How">How It Works</Button>
            <Button variant="ghost" href={phoneHref} hoverLabel="Tap to Dial">Call {phoneLabel}</Button>
            <div class="ratings">
              <span class="stars" aria-hidden="true">★★★★★</span>
              <span>5.0 · 300+ reviews</span>
            </div>
          </div>
        </div>

        <div class="hero-frame" data-vs-reveal>
          <Image
            src={image("heroPrimary").url} width={image("heroPrimary").width} height={image("heroPrimary").height}
            alt="A patient checking in at the Vivid Smiles Dentistry front desk in Parker, CO"
            widths={[480, 720, 1080]}
            sizes="(max-width: 991px) 90vw, 540px"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </header>

    {/* ---------- WHY (cream) — story + sticky $50 + $50 reward card ---------- */}
    <section class="section alt" id="program" data-vs-reveal-batch>
      <div class="wrap story-grid">

        <div class="story-copy">
          <span class="eyebrow eyebrow-lined">— Our Patient Referral Program</span>
          <h2><Fragment set:html={section("program").heading} /></h2>
          <p>{section("program").body}</p>
          <p>
            Our referral program is a simple, rewarding way to say thank you for
            spreading the word. When your friend comes in for their first
            appointment, both of you receive a $50 credit toward future dental
            services — applied automatically, no paperwork required.
          </p>
        </div>

        <aside class="reward-card" aria-label="Referral reward at a glance">
          <span class="reward-card__label">— At a glance</span>
          <h3>Refer &amp; <em>both win</em></h3>

          <div class="reward-stack">
            <div class="reward-row">
              <div class="reward-row__price">
                <span class="dollar">$</span>50
              </div>
              <div class="reward-row__who">
                <span class="reward-row__lead">You</span>
                <span class="reward-row__note">credit for sharing</span>
              </div>
            </div>
            <div class="reward-plus" aria-hidden="true">+</div>
            <div class="reward-row">
              <div class="reward-row__price">
                <span class="dollar">$</span>50
              </div>
              <div class="reward-row__who">
                <span class="reward-row__lead">Your friend</span>
                <span class="reward-row__note">credit on their first visit</span>
              </div>
            </div>
          </div>

          <ul class="reward-meta">
            <li>Applied after their first appointment</li>
            <li>One credit per household</li>
            <li>Use toward future dental services</li>
          </ul>

          <a class="reward-jump" href="#how-it-works">
            <span>See how it works</span>
            <span class="arrow-mini" aria-hidden="true">→</span>
          </a>
        </aside>

      </div>
    </section>

    {/* ---------- HOW IT WORKS — sage (dark) — 3 .process-card ---------- */}
    {hasBlocks ? <PageBlocks blocks={blocks} /> : <section class="section dark" id="how-it-works" data-vs-reveal-batch>
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow light">How It Works</span>
          <h2><Fragment set:html={section("how-it-works").heading} /></h2>
          <p>{section("how-it-works").body}</p>
        </div>

        <div class="process-grid">
          {steps.map((s) => (
            <div class="process-card">
              <span class="step-tag">{s.tag}</span>
              <div class="num">{s.num}</div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          ))}
        </div>

        <p class="process-foot">
          Referral cards are available at the front desk — call us at
          <a class="vs-link" href={phoneHref}>{phoneLabel}</a> to grab a few on
          your next visit.
        </p>
      </div>
    </section>}

    {/* ---------- FAQ (paper) ---------- */}
    {hasBlocks ? null : <section class="section" id="faq" data-vs-reveal-batch>
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow">{section("faq").eyebrow}</span>
          <h2><Fragment set:html={section("faq").heading} /></h2>
        </div>

        <div class="faq-list">
          {faqs.map((f) => (
            <details class="faq" open={f.open}>
              <summary>
                <h3>{f.q}</h3>
                <span class="icon" aria-hidden="true">+</span>
              </summary>
              <div class="answer"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>}

    {/* ---------- FINAL BAND ---------- */}
    <FinalBand eyebrow="Ready to refer?" background="cream-warm">
      <p>
        Sharing a smile has never been easier. If you'd like to refer a friend or
        have a question about the program, give us a call at
        <a class="vs-link" href={phoneHref}>{phoneLabel}</a> — we'll take it from there.
      </p>
    </FinalBand>

    </main>

    {/* ---------- JSON-LD ---------- */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",              "item": new URL("/", Astro.site).href },
        { "@type": "ListItem", "position": 2, "name": "Patient Resources", "item": new URL("/new-patients/", Astro.site).href },
        { "@type": "ListItem", "position": 3, "name": "Referral Program",  "item": new URL("/referral-program/", Astro.site).href },
      ],
    })} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqEntities.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    })} />

  </div>
</BaseLayout>
