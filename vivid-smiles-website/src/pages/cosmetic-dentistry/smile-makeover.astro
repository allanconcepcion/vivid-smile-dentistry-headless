---
/**
 * Smile Makeover — Vivid Smiles Dentistry, Parker CO.
 *
 * Built from SEO-locked markdown copy (no prototype) using porcelain-veneers
 * as the structural template. Section order
 * mirrors veneers 1:1 with four documented adaptations:
 *
 *   1. KEYS — at-a-glance stats are tagline-derived from the body copy
 *      (custom plans / 600+ hrs / digital preview / 300+ reviews), not
 *      verbatim — same precedent as veneers, FMR.
 *   2. #issues — new 5-up `.issues-grid` + `.issues-card` pattern carrying
 *      the source MD's "Common Issues a Smile Makeover Can Address" five
 *      bullets verbatim. Page-local; lift to a shared component if a third
 *      page adopts it (the .why-3up + the .why-4up follow
 *      the same convention).
 *   3. #process — uses veneers' `.natural-grid` (text + image + pull-quote)
 *      on a sage `.section.dark` band, with the gum-contouring repaint
 *      (cream-on-sage natural-quote with translucent borders) applied. The
 *      pull-quote is lifted verbatim from the source MD.
 *   4. The smile-gallery marquee is **embedded inside the #results
 *      section** (cream band) rather than living on its own sage `#gallery`
 *      band — the #results heading is what points patients at real cases, so
 *      the photos live where the heading promises them. The marquee pulls the
 *      shared finished-smile set from `src/assets/images/smiles/`, which is
 *      generic to the practice rather than makeover-specific; drop
 *      smile-makeover photography into that folder to swap it. One
 *      structural consequence: this page has only one sage band (#process)
 *      where veneers has two (#process, #gallery).
 *
 * Page-scoped styles: src/styles/pages/smile-makeover.css
 * Buttons + scroll reveals wired by src/scripts/animations.js (data-vs-arrow / data-vs-reveal*).
 *
 * Global <Nav /> + <Footer /> are mounted by BaseLayout — this page renders
 * only its own content, starting with an inline breadcrumb under the global nav.
 *
 * MIGRATED TO BLOCKS (docs/PAGE-BLOCKS.md 2.3). Eight top-level bands — what,
 * issues, process, options, why-us, cost, results, faq — each guarded with
 * `hasBlocks ? null : …` and each carrying a row in cms/import/block-map.json
 * under /cosmetic-dentistry/smile-makeover/. Eight `sections` rows, eight
 * `toc_links` rows, eight blocks, one anchor apiece: no code_section, because
 * this page has no <LocalTrust> band and nothing else on it stays in code.
 *
 * THE FOUR COMMENTS ABOVE THAT NAME A BAND COLOUR WERE WRONG AND ARE CORRECTED
 * BELOW. This page was cloned from porcelain-veneers.css, INCLUDING its band
 * vocabulary, so `.section.alt` is CHARCOAL (smile-makeover.css:258 ->
 * var(--vs-charcoal-green)) and `.section.dark` is SAGE-PALE
 * (smile-makeover.css:267 -> var(--vs-sage-pale)). The header note at the top
 * of this file calls #issues/#why-us/#results "cream" and #process "sage";
 * neither is what the sheet paints, and copying those words into the map would
 * have repainted four of the eight bands the moment the backfill ran. Every
 * `band` value in the map is read off the rule, not off the class name or off
 * a comment.
 *
 * FOUR BANDS COME BACK CHANGED, AND EVERY ONE OF THEM IS A RECORDED GAP IN THE
 * MAP RATHER THAN A NEW FIELD OR A NEW LAYOUT: #issues loses its page-local
 * `.issues-grid` 5-up, #process loses its `.process-sub` <h3> and its
 * `.inline-cta.dark`, #options loses the featured card's `.prep-list` and its
 * three stretched links, #results loses the two-button `.cta-row` inside its
 * section-head. See `known_gaps` on each block in
 * cms/import/routes/smile-makeover.json for what would close each one.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FinalBand from '../../components/FinalBand.astro';
import VirtualConsult from '../../components/VirtualConsult.astro';
import {
  phoneHref,
  phoneLabel,
  phoneE164,
  bookNowHref,
  addressStreet,
  addressCity,
  addressState,
  addressZip,
} from '../../data/contact';
import '../../styles/pages/smile-makeover.css';

// "What is a smile makeover" — finished-smile macro, three-quarter angle.
// "The process" — editorial finished-smile macro.

// Gallery pulls dynamically from the central smiles/ folder.
import { getSmiles } from '../../lib/smiles';
import { getPageContent, type TocLink } from '../../lib/page-content';
import PageBlocks from '../../blocks/PageBlocks.astro';
// tocLinks, faqs are edited in WordPress (Pages -> Smile Makeover in Parker, CO).
// The shapes are unchanged from the arrays that used to live here, so the
// markup below is untouched.
const { hero, closing, blocks, hasBlocks, tocLinks, faqs, section, image, seo } = await getPageContent(
  Astro.url.pathname,
);

const galleryTiles = getSmiles();
const galleryTrack = [...galleryTiles, ...galleryTiles];

// Five bullets, and they are ALSO five live `cards` rows in the CMS under the
// group `issuesList` — title filled, body and meta null, verified against
// /graphql for this route. So the map MOVES those rows into the block's `cards`
// repeater rather than transcribing this array, and this copy is only what the
// un-migrated else branch below still draws. The two must not drift: edit the
// CMS rows, not this array.
const issuesList = [
  'Severe staining that no longer responds to whitening',
  'Chipped, cracked, or worn-down teeth',
  'Uneven tooth length, shape, or spacing',
  'Gaps or minor crowding',
  'Disproportionate tooth-to-gum ratio (gummy smile)',
];

/**
 * The "On this page" rail, derived from the blocks themselves (docs/PAGE-BLOCKS.md 1.2).
 *
 * Used only when this page renders from `blocks`. The `toc_links` repeater is
 * eight rows that restate the order of the eight bands below it, so a reorder
 * in wp-admin moves a band and leaves its rail entry pointing at the old
 * neighbour — the single largest way a reorder breaks a link. Reading the
 * anchors off the blocks makes that unrepresentable: there is one ordering and
 * the rail is a projection of it.
 *
 * Three rules, in the order they bite:
 *
 * 1. A blank anchor is skipped. Not tidiness — src/scripts/toc-spy.ts:24 feeds
 *    each rendered href straight to document.querySelector(), and
 *    querySelector("") throws a SyntaxError that kills the whole spy, not just
 *    the one entry. PageBlocks.astro emits no id at all for a blank anchor
 *    (`id={anchor || undefined}`), so there is nothing to link to either.
 * 2. An anchor that is not a valid id selector is skipped for the same reason —
 *    "#3-reasons" is legal HTML and an illegal CSS selector. Dropping one rail
 *    entry costs one link; letting it through costs every link on the page,
 *    plus the mobile pill auto-centering.
 * 3. Duplicate anchors follow PageBlocks.astro's dedup exactly, second
 *    occurrence onward suffixed `-2`, `-3`. The counter has to advance on every
 *    non-blank anchor, including blocks with no nav_label, or the rail's idea
 *    of "the second #faq" drifts from the id the renderer actually emitted.
 *
 * A blank nav_label means "leave this block out of the rail" (1.2), which is
 * how a band that should not be navigable opts out. No band on this page opts
 * out: all eight anchors have a toc_links row, so the derived rail is the same
 * eight entries in the same order the repeater holds them.
 */
const ANCHOR_IS_ID_SELECTOR = /^[A-Za-z_][A-Za-z0-9_-]*$/;

const anchorsSeen = new Map<string, number>();
// Typed as TocLink[] rather than an equivalent inline shape so the ternary in
// the rail below collapses to one type instead of a union of two array types,
// which TypeScript will not let you call .map() on.
const derivedTocLinks: TocLink[] = [];

for (const block of blocks) {
  // A nested block is drawn INSIDE the band above it, not as a band of its own,
  // so it has no id to link to. Without this the rail emits an entry pointing at
  // an anchor nothing renders — a dead link in the "On this page" list.
  if (block?.nested) continue;

  const anchor = typeof block.anchor === 'string' ? block.anchor.trim() : '';
  if (anchor === '') continue;

  const nth = (anchorsSeen.get(anchor) ?? 0) + 1;
  anchorsSeen.set(anchor, nth);

  const label = typeof block.navLabel === 'string' ? block.navLabel.trim() : '';
  if (label === '') continue;

  if (!ANCHOR_IS_ID_SELECTOR.test(anchor)) {
    console.warn(
      `[blocks] anchor "${anchor}" on ${Astro.url.pathname} cannot be used as a selector — ` +
        `omitting "${label}" from the On this page rail so toc-spy keeps working`,
    );
    continue;
  }

  derivedTocLinks.push({ href: `#${nth > 1 ? `${anchor}-${nth}` : anchor}`, label });
}

---

<BaseLayout
  title={seo.title || "Smile Makeover in Parker, CO | Vivid Smiles Dentistry"}
  description={seo.description || "Custom smile makeovers in Parker, CO with Dr. Bryce Richardson. Combine porcelain veneers, Invisalign, and whitening with digital smile design to preview your results before any treatment begins."}
 noindex={seo.noindex}>
  <div class="smilemakeover">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/services/">Services</a>
        <span class="sep">/</span>
        <a href="/cosmetic-dentistry/">Cosmetic Dentistry</a>
        <span class="sep">/</span>
        <span class="here">Smile Makeover</span>
      </div>
    </nav>

    <main id="main">
      {/* ---------- HERO ---------- */}
      <header class="hero" data-vs-reveal-batch>
        <div class="wrap hero-inner">
          <div class="hero-copy">
            {hero.eyebrow ? <span class="eyebrow">{hero.eyebrow}</span> : <span class="eyebrow">Cosmetic Dentistry · Parker, CO</span>}
            {hero.h1 ? <h1 data-vs-reveal-lines set:html={hero.h1} /> : <h1 data-vs-reveal-lines>
              Transform Your Smile with a <em>Custom Smile Makeover in Parker, CO</em>
            </h1>}
            {hero.sub ? <p class="hero-sub">{hero.sub}</p> : <p class="hero-sub">
              A smile makeover combines two or more cosmetic treatments into one coordinated plan,
              designed to address your specific aesthetic concerns all at once rather than one
              procedure at a time. Unlike a single-service approach, it starts with the outcome you
              want and works backward to build the right treatment path. Here is what that process
              looks like at Vivid Smiles Dentistry, and what separates results that look natural
              from results that look obvious.
            </p>}
            <div class="hero-actions">
              <Button variant="light" href={hero.cta(0) ? hero.cta(0)!.href : bookNowHref} hoverLabel="Let's Talk">{hero.cta(0) ? hero.cta(0)!.label : "Book Online"}</Button
              >
              <Button variant="ghost-light" href={hero.cta(1) ? hero.cta(1)!.href : "#consult"} hoverLabel="Get a Video"
                >{hero.cta(1) ? hero.cta(1)!.label : "Free Virtual Consult"}</Button
              >
              {hero.showRatings && <div class="ratings">
                <span class="stars" aria-hidden="true">★★★★★</span>
                <span>5.0 · 300+ reviews</span>
              </div>}
            </div>
          </div>
          <div class="hero-img" data-vs-parallax data-parallax="-30">
            <Image
              src={image("heroImg").url} width={image("heroImg").width} height={image("heroImg").height}
              alt="Smiling woman photographed against a dark studio background"
              widths={[600, 900, 1400]}
              sizes="(max-width: 991px) 100vw, 50vw"
            />
          </div>
        </div>
      </header>

      {/* ---------- KEYS — at-a-glance ---------- */}
      <section class="keys" id="keys" aria-label="Smile makeovers at a glance" data-vs-reveal-batch>
        <div class="keys-grid">
          <div class="keys-label">At a glance</div>
          <div class="keys-item">
            <div class="k">Custom</div><div class="v">Treatment Plans</div>
          </div>
          <div class="keys-item">
            <div class="k">600+ hrs</div><div class="v">Esthetic Training</div>
          </div>
          <div class="keys-item">
            <div class="k">Digital Preview</div><div class="v">Before You Commit</div>
          </div>
          <div class="keys-item">
            <div class="k">300+</div><div class="v">Five-Star Reviews</div>
          </div>
        </div>
      </section>

      {
        /* ---------- ON-THIS-PAGE TOC ----------
         The rail itself is never a block (spec 7: "Not a block, even though it
         is a band") — only its contents move. Derived from the blocks when
         they are drawing the page, read from the `toc_links` repeater when the
         template is. Same markup either way, which is what lets
         src/scripts/toc-spy.ts go on reading its section list off the rendered
         links without knowing which source produced them. */
      }
      <nav class="toc" id="toc" aria-label="On this page">
        <div class="toc-inner">
          <span class="toc-label">On this page</span>
          <div class="toc-scroll">
            <div class="toc-list">
              {(hasBlocks ? derivedTocLinks : tocLinks).map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          </div>
        </div>
      </nav>

      {
        /* ---------- WHAT (paper) ----------

         THE MIGRATION SWITCH (docs/PAGE-BLOCKS.md 2.3) starts here. `hasBlocks`
         means "this build can draw this page from its blocks" — not "WordPress
         sent rows" (src/lib/page-content.ts). When it is true PageBlocks draws
         the eight bands in the order an editor arranged them; when it is false —
         which is every build until the backfill has run, and again the moment
         an editor empties the field — every band below renders exactly as it
         always has.

         Written as one guard per band rather than one guard around all eight on
         purpose, and it is not a style choice. Astro's compressHTML pass treats
         an Astro comment expression differently inside a component slot than at
         element level: wrapping these bands in a Fragment silently drops one
         space at every comment boundary below, and scripts/vr-html.mjs compares
         exact bytes and calls that a difference. A guard sitting exactly where
         its section sat emits byte-identical HTML.

         EVERY top-level band between here and <VirtualConsult> is guarded, and
         every one of them has a row in cms/import/block-map.json. Those two
         facts have to move together: a band that is neither blocked nor guarded
         renders in ADDITION to the block run and lands at the bottom of the
         page, and a band that is guarded with no map row disappears on backfill
         with nothing in the log. There is no third outcome. The bands ABOVE
         this line — the breadcrumb, the hero, `.keys` and the rail — are not
         blocks by spec 7 and are deliberately unguarded, as are <VirtualConsult>
         and <FinalBand> below the run.

         `.section` with no modifier is paper: smile-makeover.css:257 sets
         padding: 110px 0 and nothing else, so the body paper shows through. */
      }
      {hasBlocks ? <PageBlocks blocks={blocks} /> : <section class="section" id="what" data-vs-reveal-batch>
        <div class="wrap">
          <div class="what-grid">
            <div class="what-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("whatImg").url} width={image("whatImg").width} height={image("whatImg").height}
                alt="Close-up of a smile at a three-quarter angle against black"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
            <div class="what-text">
              <span class="eyebrow">{section("what").eyebrow}</span>
              <h2><Fragment set:html={section("what").heading} /></h2>
              <div class="prose">
                <p>{section("what").body}</p>
              </div>
              <div class="cta-row left">
                <div class="cta-buttons">
                  <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                    >Free Virtual Consult</Button
                  >
                  <Button variant="ghost" href="#options" hoverLabel="See Options"
                    >Treatment Options</Button
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- ISSUES (charcoal) — `.section.alt` is
       var(--vs-charcoal-green) on THIS page (smile-makeover.css:258), not the
       cream the section comment used to claim and not the cream the same class
       name means on teeth-whitening.css:237. The band value in the map is read
       off that rule, not off the class. ---------- */}
      {hasBlocks ? null : <section class="section alt" id="issues" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Common Issues</span>
            <h2><Fragment set:html={section("issues").heading} /></h2>
            <p>{section("issues").body}</p>
          </div>

          <div class="issues-grid">
            {
              issuesList.map((label, i) => (
                <article class="issues-card">
                  <div class="num">{String(i + 1).padStart(2, '0')}</div>
                  <div class="label">{label}</div>
                </article>
              ))
            }
          </div>
        </div>
      </section>}

      {
        /* ---------- PROCESS (sage-pale) — natural-grid pattern on a
         `.section.dark` band, with the cream-on-sage repaint of
         .natural-quote.

         `.smilemakeover .section.dark` is var(--vs-sage-pale)
         (smile-makeover.css:267), with h2 var(--vs-ink) at :271. PALE, despite
         the class name and despite the comment that used to sit here calling it
         "sage". `sage` and `sage-pale` are two separate BLOCK_BANDS choices
         painting two different tokens, so the map says sage-pale.

         THIS BAND IS THE LOSSIEST ON THE PAGE. It is a media_split — a
         `.natural-grid` of text and photo with a pull quote — but it also
         carries a `.process-sub` <h3> between its two prose paragraphs and an
         `.inline-cta.dark` after the grid, and media_split has a field for
         neither. Both are recorded as known_gaps on this block in the map. They
         are NOT smuggled through `body_2`: that field renders inside a single
         <p>, so an <h3> in it would nest a heading inside a paragraph, and the
         inline CTA is a sibling of the grid rather than anything inside the
         text column. */
      }
      {hasBlocks ? null : <section class="section dark" id="process" data-vs-reveal-batch>
        <div class="wrap">
          <div class="natural-grid">
            <div class="natural-text">
              <span class="eyebrow light">The Process</span>
              <h2><Fragment set:html={section("process").heading} /></h2>
              <div class="natural-quote">
                You should see exactly what your results will look like before any treatment begins.
              </div>
              <div class="prose">
                <p>{section("process").body}</p>
                <h3 class="process-sub">Preview Your New Smile Before You Commit</h3>
                <p>
                  Digital smile design at Vivid Smiles maps your new smile onto your actual face
                  using advanced imaging software, giving you a realistic, personalized preview
                  before any work starts. This is not a generic approximation: it is a treatment
                  roadmap built from your facial dimensions, tooth proportions, and cosmetic goals.
                  You and Dr. Richardson refine the design together until the preview reflects
                  exactly what you want, removing the guesswork that has historically been the
                  biggest barrier to investing in cosmetic dentistry.
                </p>
              </div>
            </div>
            <div class="natural-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("editorialImg").url} width={image("editorialImg").width} height={image("editorialImg").height}
                alt="Editorial close-up of a smile with berry lipstick"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
          </div>

          <div class="inline-cta dark">
            <div class="ic-text">
              Ready to see your preview? <em>Book online and we'll take it from here.</em>
            </div>
            <div class="ic-buttons">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>}

      {
        /* ---------- OPTIONS (paper) — featured Veneers (full-width row 1) +
         two secondary options (row 2). Each card is a whole-clickable link
         to its service page via the stretched-link pattern.

         `.section` with no modifier, so paper (smile-makeover.css:257 sets
         padding only).

         comparison_cards carries the three cards, the ribbon and the featured
         flag, and it draws the closing `.cta-row` itself — the same two buttons
         and the same note this template ships. What it cannot carry is recorded
         as known_gaps on this block: the featured card's `<ul class="prep-list">`
         and its second paragraph, and the three `.compare-card__stretch` links.
         `tiers.bullets` DOES exist on the deployed layout, and it is
         deliberately not used: it is absent from src/blocks/manifest.ts, and
         ComparisonCardsBlock draws it as a bare <ul> of plain <li> with neither
         the `prep-list` class the page styles nor the <strong> labels inside
         each line, so it would move the words into markup the sheet does not
         paint. */
      }
      {hasBlocks ? null : <section class="section" id="options" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Treatment Options</span>
            <h2><Fragment set:html={section("options").heading} /></h2>
            <p>{section("options").body}</p>
          </div>

          <div class="compare">
            <article class="compare-card featured">
              <a
                class="compare-card__stretch"
                href="/cosmetic-dentistry/porcelain-veneers/"
                aria-label="Learn more about Porcelain Veneers"></a>
              <span class="ribbon">Centerpiece</span>
              <span class="tag">Most Common Foundation</span>
              <h3>Porcelain Veneers</h3>
              <p>
                Porcelain veneers (thin custom shells bonded to the front of teeth) are Dr.
                Richardson's specialty and the most common centerpiece of a smile makeover plan.
                Vivid Smiles offers three prep levels:
              </p>
              <ul class="prep-list">
                <li>
                  <strong>Traditional veneers:</strong> Minimal enamel removal; considered permanent;
                  20+ year lifespan
                </li>
                <li>
                  <strong>Minimal-prep veneers:</strong> Less enamel reduction while preserving more natural
                  tooth structure
                </li>
                <li>
                  <strong>No-prep veneers:</strong> No enamel removal; reversible when candidacy allows
                </li>
              </ul>
              <p>
                Color, shape, and translucency are customized to your facial features, skin tone,
                and preferences. The goal is results that enhance your existing smile, not overwrite
                it.
              </p>
            </article>
            <article class="compare-card">
              <a
                class="compare-card__stretch"
                href="/cosmetic-dentistry/clear-aligners/"
                aria-label="Learn more about Invisalign and clear aligners"></a>
              <span class="tag">Alignment</span>
              <h3>Invisalign and Orthodontic Alignment</h3>
              <p>
                Correcting tooth position before placing veneers typically produces cleaner,
                longer-lasting results. Vivid Smiles offers Invisalign either as a preparatory step
                or as a standalone cosmetic solution for patients whose primary concern is
                alignment.
              </p>
            </article>
            <article class="compare-card">
              <a
                class="compare-card__stretch"
                href="/cosmetic-dentistry/teeth-whitening/"
                aria-label="Learn more about Teeth Whitening"></a>
              <span class="tag">Brightening</span>
              <h3>Teeth Whitening</h3>
              <p>
                Professional KOR whitening reaches shades not achievable with at-home products and
                can serve as a standalone solution or a prep step before veneers, delivering results
                that hold for years rather than weeks.
              </p>
            </article>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <Button variant="ghost" href="#faq" hoverLabel="See Answers">Read FAQ</Button>
            </div>
            <span class="cta-note">No commitment · Personal video reply</span>
          </div>
        </div>
      </section>}

      {/* ---------- WHY-US (charcoal) — 2-card why-grid. Same
       `.smilemakeover .section.alt { background: var(--vs-charcoal-green) }`
       rule as `issues` above, smile-makeover.css:258. ---------- */}
      {hasBlocks ? null : <section class="section alt" id="why-us" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("why-us").eyebrow}</span>
            <h2><Fragment set:html={section("why-us").heading} /></h2>
            <p>{section("why-us").body}</p>
          </div>

          <div class="why-grid">
            <article class="why-card">
              <div class="num">01</div>
              <h3>Dr. Bryce Richardson's Cosmetic Dentistry Expertise</h3>
              <p>
                Dr. Richardson earned his DDS from Indiana University School of Dentistry, graduated
                at the top of his class clinically, and has completed 600+ hours of specialized
                esthetic and surgical training. He served on staff at Implant Pathway, one of the
                country's most respected implant training facilities, and is a Parker resident and
                active community member. His approach is consistent across every case: enhance your
                natural features rather than replace them, working toward Vivid Smiles' goal of
                becoming Colorado's leading cosmetic dental destination.
              </p>
            </article>

            <article class="why-card">
              <div class="num">02</div>
              <h3>Advanced Technology for Predictable Results</h3>
              <p>
                Digital scanning eliminates traditional impressions, and in-house milling units and
                3D printers reduce wait time on custom restorations. CBCT 3D imaging provides a
                complete diagnostic picture before treatment begins, and digital smile design
                connects the full technology stack to a preview you can see and refine. Every tool
                at Vivid Smiles is selected for what it does for the patient: less time waiting,
                more confidence in the outcome.
              </p>
            </article>
          </div>
        </div>
      </section>}

      {/* ---------- COST (paper) — lasting-card with timeline stat + cost prose.
       `.section` with no modifier, body paper (smile-makeover.css:257).

       NOT a `pricing_tiers` band, despite the id. This page has no
       <PricingTiers> and no plan table at all — it is the `.lasting-card` shell
       that porcelain-veneers uses for #lasting, which is what `stat_callout`
       serves. The section-head here carries NO paragraph, so the map writes the
       preamble's `body` as an empty literal and moves sections.cost.body into
       `intro`, the first paragraph INSIDE the card. Writing it to `body` would
       print it twice. ---------- */}
      {hasBlocks ? null : <section class="section" id="cost" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Investment</span>
            <h2><Fragment set:html={section("cost").heading} /></h2>
          </div>

          <div class="lasting-card">
            <div class="lasting-stat">
              <div class="big">2 visits<em>– 12 mo</em></div>
              <div class="label">Custom timeline based on your plan</div>
            </div>
            <div class="lasting-body">
              <p>{section("cost").body}</p>
              <p>
                For investment, cost reflects the scope of your plan. Vivid Smiles provides
                transparent pricing and discusses financing options at the consultation, so there
                are no surprises after you commit. Patients who are uninsured or looking for
                additional cost flexibility may benefit from the practice's in-house dental
                membership plan. Most cosmetic procedures are considered elective and are not
                covered by dental insurance, though treatments that address both cosmetic and
                functional concerns may qualify for partial coverage.
              </p>
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- RESULTS (charcoal) — the marquee lives INSIDE this band on
       this page rather than on its own #gallery band, which is the one
       structural difference from porcelain-veneers. That is exactly the shape
       `gallery_marquee` draws: section-head, then the strip, both inside one
       <section>. Third use of the same
       `.smilemakeover .section.alt { background: var(--vs-charcoal-green) }`
       rule, smile-makeover.css:258.

       Two differences come back with the block and both are recorded as
       known_gaps: the `.cta-row` inside this section-head (View the Smile
       Gallery / Patient Stories) has no field on a preamble-only layout, and
       GalleryMarqueeBlock hard-codes `class="eyebrow light"` where this
       template ships a plain `class="eyebrow"`. ---------- */}
      {hasBlocks ? null : <section class="section alt" id="results">
        <div class="wrap">
          <div class="section-head" data-vs-reveal>
            <span class="eyebrow">{section("results").eyebrow}</span>
            <h2><Fragment set:html={section("results").heading} /></h2>
            <p>{section("results").body}</p>
            <div class="cta-row">
              <div class="cta-buttons">
                <Button variant="light" href="/smile-gallery/" hoverLabel="Open Gallery"
                  >View the Smile Gallery</Button
                >
                <Button
                  variant="ghost-light"
                  href="/patient-testimonials/"
                  hoverLabel="Read Stories">Patient Stories</Button
                >
              </div>
            </div>
          </div>
        </div>

        <div class="gallery-marquee" data-vs-marquee aria-label="Vivid Smiles smile gallery">
          <div class="gallery-track" data-vs-marquee-track>
            {
              galleryTrack.map((t, i) => {
                const isClone = i >= galleryTiles.length;
                return (
                  <div
                    class="smile-tile"
                    aria-hidden={isClone || undefined}
                    inert={isClone || undefined}
                  >
                    <Image src={t.src} width={t.width} height={t.height} alt={t.alt} widths={[420, 640, 840]} sizes="420px" />
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>}

      {/* ---------- FAQ (paper) — native details/summary, zero JS.
       `.section` with no modifier, body paper (smile-makeover.css:257).
       sections.faq.body goes to `pull`, not to the preamble's `body`: the
       section-head here has no paragraph and the copy belongs in the `.pull`
       aside beside the questions. ---------- */}
      {hasBlocks ? null : <section class="section" id="faq" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("faq").eyebrow}</span>
            <h2><Fragment set:html={section("faq").heading} /></h2>
          </div>

          <div class="faq-list">
            {
              faqs.map((f) => (
                <details class="faq" open={f.open}>
                  <summary>
                    <>
                      <h3>{f.q}</h3>
                      <span class="icon" aria-hidden="true">
                        +
                      </span>
                    </>
                  </summary>
                  <div class="answer" set:html={f.a} />
                </details>
              ))
            }
          </div>

          <div class="pull">
            <p>{section("faq").body}</p>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Still Have Questions? Free Virtual Consult</Button
              >
              <Button variant="ghost" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>}

      {
        /* ---------- VIRTUAL CONSULT — body slot carries the source MD's
         italicized closing lead-in paragraph verbatim.

         NOT a block and deliberately unguarded, like the breadcrumb, hero,
         `.keys` strip and the rail above: it renders on both sides of the
         switch and has no row in the map. It sits after the block run in
         template order and PageBlocks draws at the `what` position, so the
         closing pair still comes last. */
      }
      <VirtualConsult id="consult" eyebrow={closing.consultEyebrow || "Free smile makeover consultation"}>
        <Fragment slot="headline">{closing.consultHeadline ? <Fragment set:html={closing.consultHeadline} /> : <>Free smile makeover <em>consultation.</em></>}</Fragment>
        <Fragment slot="body">{closing.consultBody ? closing.consultBody : <>
          If you have spent years wanting to fix your smile, the next step is a consultation, not a
          commitment. At Vivid Smiles Dentistry, Dr. Richardson starts every smile makeover with a
          comprehensive analysis and a digital preview so you can see exactly what your results will
          look like before any treatment begins.
        </>}</Fragment>
      </VirtualConsult>

      {/* ---------- CLOSING BAND ---------- */}
      <FinalBand>
        <p>{closing.note ? closing.note : <>
          Vivid Smiles is located in Parker, CO and has earned 300+ five-star Google reviews from
          patients who wanted natural, lasting results and got them.
        </>}</p>
      </FinalBand>
    </main>

    <script>
      import { initTocSpy } from '../../scripts/toc-spy';
      initTocSpy('.smilemakeover');
    </script>

    {/* JSON-LD structured data — service-page trio matching veneers / FMR. */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'MedicalProcedure',
        name: 'Smile Makeover',
        alternateName: [
          'Cosmetic Smile Design',
          'Custom Smile Makeover',
          'Cosmetic Dentistry Plan',
        ],
        procedureType: 'https://schema.org/SurgicalProcedure',
        bodyLocation: 'Teeth',
        preparation:
          'Comprehensive cosmetic analysis and a digital smile design preview before any treatment begins; specific preparation depends on the combination of procedures (veneers, Invisalign, whitening, bonding) included in the plan.',
        howPerformed:
          'Two or more cosmetic dental treatments are sequenced into a single coordinated plan. Most plans include porcelain veneers as the centerpiece and may add Invisalign alignment, professional whitening, and dental bonding as needed. Color, shape, and translucency are customized using digital smile design and refined with the patient before fabrication and placement.',
        followup:
          'Routine brushing, flossing, and dental visits; a nightguard is recommended for bruxism patients to protect veneers and other restorations.',
        performer: {
          '@type': 'Dentist',
          name: 'Dr. Bryce Richardson',
          worksFor: {
            '@type': 'Dentist',
            name: 'Vivid Smiles Dentistry',
            address: {
              '@type': 'PostalAddress',
              streetAddress: addressStreet,
              addressLocality: addressCity,
              addressRegion: addressState,
              postalCode: addressZip,
              addressCountry: 'US',
            },
            telephone: phoneE164,
          },
        },
      })}
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })}
    />

    {
      /* Breadcrumb URLs source the host from astro.config.mjs `site` and use
        real site routes (matching the visible breadcrumb above). Trailing
        slashes required because the site is configured `trailingSlash: 'always'`. */
    }
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Services',
            item: new URL('/services/', Astro.site).href,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: 'Cosmetic Dentistry',
            item: new URL('/cosmetic-dentistry/', Astro.site).href,
          },
          {
            '@type': 'ListItem',
            position: 4,
            name: 'Smile Makeover',
            item: new URL('/cosmetic-dentistry/smile-makeover/', Astro.site).href,
          },
        ],
      })}
    />
  </div>
</BaseLayout>
