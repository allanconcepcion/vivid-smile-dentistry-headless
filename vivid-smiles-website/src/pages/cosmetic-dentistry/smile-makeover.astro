---
/**
 * Smile Makeover — Vivid Smiles Dentistry, Parker CO.
 *
 * Built from SEO-locked markdown copy (no prototype) using porcelain-veneers
 * as the structural template. Section order
 * mirrors veneers 1:1 with four documented adaptations:
 *
 *   1. KEYS — at-a-glance stats are tagline-derived from the body copy
 *      (custom plans / 600+ hrs / digital preview / 300+ reviews), not
 *      verbatim — same precedent as veneers, FMR.
 *   2. #issues — new 5-up `.issues-grid` + `.issues-card` pattern carrying
 *      the source MD's "Common Issues a Smile Makeover Can Address" five
 *      bullets verbatim. Page-local; lift to a shared component if a third
 *      page adopts it (the .why-3up + the .why-4up follow
 *      the same convention).
 *   3. #process — uses veneers' `.natural-grid` (text + image + pull-quote)
 *      on a sage `.section.dark` band, with the gum-contouring repaint
 *      (cream-on-sage natural-quote with translucent borders) applied. The
 *      pull-quote is lifted verbatim from the source MD.
 *   4. The smile-gallery marquee is **embedded inside the #results
 *      section** (cream band) rather than living on its own sage `#gallery`
 *      band — the #results heading is what points patients at real cases, so
 *      the photos live where the heading promises them. The marquee pulls the
 *      shared finished-smile set from `src/assets/images/smiles/`, which is
 *      generic to the practice rather than makeover-specific; drop
 *      smile-makeover photography into that folder to swap it. One
 *      structural consequence: this page has only one sage band (#process)
 *      where veneers has two (#process, #gallery).
 *
 * Page-scoped styles: src/styles/pages/smile-makeover.css
 * Buttons + scroll reveals wired by src/scripts/animations.js (data-vs-arrow / data-vs-reveal*).
 *
 * Global <Nav /> + <Footer /> are mounted by BaseLayout — this page renders
 * only its own content, starting with an inline breadcrumb under the global nav.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FinalBand from '../../components/FinalBand.astro';
import VirtualConsult from '../../components/VirtualConsult.astro';
import {
  phoneHref,
  phoneLabel,
  phoneE164,
  bookNowHref,
  addressStreet,
  addressCity,
  addressState,
  addressZip,
} from '../../data/contact';
import '../../styles/pages/smile-makeover.css';

// "What is a smile makeover" — finished-smile macro, three-quarter angle.
// "The process" — editorial finished-smile macro.

// Gallery pulls dynamically from the central smiles/ folder.
import { getSmiles } from '../../lib/smiles';
import { getPageContent } from '../../lib/page-content';
// tocLinks, faqs are edited in WordPress (Pages -> Smile Makeover in Parker, CO).
// The shapes are unchanged from the arrays that used to live here, so the
// markup below is untouched.
const { tocLinks, faqs, section, image, seo } = await getPageContent(Astro.url.pathname);

const galleryTiles = getSmiles();
const galleryTrack = [...galleryTiles, ...galleryTiles];

const issuesList = [
  'Severe staining that no longer responds to whitening',
  'Chipped, cracked, or worn-down teeth',
  'Uneven tooth length, shape, or spacing',
  'Gaps or minor crowding',
  'Disproportionate tooth-to-gum ratio (gummy smile)',
];


---

<BaseLayout
  title={seo.title || "Smile Makeover in Parker, CO | Vivid Smiles Dentistry"}
  description={seo.description || "Custom smile makeovers in Parker, CO with Dr. Bryce Richardson. Combine porcelain veneers, Invisalign, and whitening with digital smile design to preview your results before any treatment begins."}
 noindex={seo.noindex}>
  <div class="smilemakeover">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/services/">Services</a>
        <span class="sep">/</span>
        <a href="/cosmetic-dentistry/">Cosmetic Dentistry</a>
        <span class="sep">/</span>
        <span class="here">Smile Makeover</span>
      </div>
    </nav>

    <main id="main">
      {/* ---------- HERO ---------- */}
      <header class="hero" data-vs-reveal-batch>
        <div class="wrap hero-inner">
          <div class="hero-copy">
            <span class="eyebrow">Cosmetic Dentistry · Parker, CO</span>
            <h1 data-vs-reveal-lines>
              Transform Your Smile with a <em>Custom Smile Makeover in Parker, CO</em>
            </h1>
            <p class="hero-sub">
              A smile makeover combines two or more cosmetic treatments into one coordinated plan,
              designed to address your specific aesthetic concerns all at once rather than one
              procedure at a time. Unlike a single-service approach, it starts with the outcome you
              want and works backward to build the right treatment path. Here is what that process
              looks like at Vivid Smiles Dentistry, and what separates results that look natural
              from results that look obvious.
            </p>
            <div class="hero-actions">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <div class="ratings">
                <span class="stars" aria-hidden="true">★★★★★</span>
                <span>5.0 · 300+ reviews</span>
              </div>
            </div>
          </div>
          <div class="hero-img" data-vs-parallax data-parallax="-30">
            <Image
              src={image("heroImg").url} width={image("heroImg").width} height={image("heroImg").height}
              alt="Smiling woman photographed against a dark studio background"
              widths={[600, 900, 1400]}
              sizes="(max-width: 991px) 100vw, 50vw"
            />
          </div>
        </div>
      </header>

      {/* ---------- KEYS — at-a-glance ---------- */}
      <section class="keys" id="keys" aria-label="Smile makeovers at a glance" data-vs-reveal-batch>
        <div class="keys-grid">
          <div class="keys-label">At a glance</div>
          <div class="keys-item">
            <div class="k">Custom</div><div class="v">Treatment Plans</div>
          </div>
          <div class="keys-item">
            <div class="k">600+ hrs</div><div class="v">Esthetic Training</div>
          </div>
          <div class="keys-item">
            <div class="k">Digital Preview</div><div class="v">Before You Commit</div>
          </div>
          <div class="keys-item">
            <div class="k">300+</div><div class="v">Five-Star Reviews</div>
          </div>
        </div>
      </section>

      {/* ---------- ON-THIS-PAGE TOC ---------- */}
      <nav class="toc" id="toc" aria-label="On this page">
        <div class="toc-inner">
          <span class="toc-label">On this page</span>
          <div class="toc-scroll">
            <div class="toc-list">
              {tocLinks.map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          </div>
        </div>
      </nav>

      {/* ---------- WHAT (paper) ---------- */}
      <section class="section" id="what" data-vs-reveal-batch>
        <div class="wrap">
          <div class="what-grid">
            <div class="what-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("whatImg").url} width={image("whatImg").width} height={image("whatImg").height}
                alt="Close-up of a smile at a three-quarter angle against black"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
            <div class="what-text">
              <span class="eyebrow">{section("what").eyebrow}</span>
              <h2><Fragment set:html={section("what").heading} /></h2>
              <div class="prose">
                <p>{section("what").body}</p>
              </div>
              <div class="cta-row left">
                <div class="cta-buttons">
                  <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                    >Free Virtual Consult</Button
                  >
                  <Button variant="ghost" href="#options" hoverLabel="See Options"
                    >Treatment Options</Button
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ---------- ISSUES (cream) ---------- */}
      <section class="section alt" id="issues" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Common Issues</span>
            <h2><Fragment set:html={section("issues").heading} /></h2>
            <p>{section("issues").body}</p>
          </div>

          <div class="issues-grid">
            {
              issuesList.map((label, i) => (
                <article class="issues-card">
                  <div class="num">{String(i + 1).padStart(2, '0')}</div>
                  <div class="label">{label}</div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      {
        /* ---------- PROCESS (sage) — natural-grid pattern on a dark band,
         with the gum-contouring cream-on-sage repaint of .natural-quote. */
      }
      <section class="section dark" id="process" data-vs-reveal-batch>
        <div class="wrap">
          <div class="natural-grid">
            <div class="natural-text">
              <span class="eyebrow light">The Process</span>
              <h2><Fragment set:html={section("process").heading} /></h2>
              <div class="natural-quote">
                You should see exactly what your results will look like before any treatment begins.
              </div>
              <div class="prose">
                <p>{section("process").body}</p>
                <h3 class="process-sub">Preview Your New Smile Before You Commit</h3>
                <p>
                  Digital smile design at Vivid Smiles maps your new smile onto your actual face
                  using advanced imaging software, giving you a realistic, personalized preview
                  before any work starts. This is not a generic approximation: it is a treatment
                  roadmap built from your facial dimensions, tooth proportions, and cosmetic goals.
                  You and Dr. Richardson refine the design together until the preview reflects
                  exactly what you want, removing the guesswork that has historically been the
                  biggest barrier to investing in cosmetic dentistry.
                </p>
              </div>
            </div>
            <div class="natural-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("editorialImg").url} width={image("editorialImg").width} height={image("editorialImg").height}
                alt="Editorial close-up of a smile with berry lipstick"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
          </div>

          <div class="inline-cta dark">
            <div class="ic-text">
              Ready to see your preview? <em>Book online and we'll take it from here.</em>
            </div>
            <div class="ic-buttons">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>

      {
        /* ---------- OPTIONS (paper) — featured Veneers (full-width row 1) +
         three secondary options (row 2). Each card is a whole-clickable link
         to its service page via the stretched-link pattern. */
      }
      <section class="section" id="options" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Treatment Options</span>
            <h2><Fragment set:html={section("options").heading} /></h2>
            <p>{section("options").body}</p>
          </div>

          <div class="compare">
            <article class="compare-card featured">
              <a
                class="compare-card__stretch"
                href="/cosmetic-dentistry/porcelain-veneers/"
                aria-label="Learn more about Porcelain Veneers"></a>
              <span class="ribbon">Centerpiece</span>
              <span class="tag">Most Common Foundation</span>
              <h3>Porcelain Veneers</h3>
              <p>
                Porcelain veneers (thin custom shells bonded to the front of teeth) are Dr.
                Richardson's specialty and the most common centerpiece of a smile makeover plan.
                Vivid Smiles offers three prep levels:
              </p>
              <ul class="prep-list">
                <li>
                  <strong>Traditional veneers:</strong> Minimal enamel removal; considered permanent;
                  20+ year lifespan
                </li>
                <li>
                  <strong>Minimal-prep veneers:</strong> Less enamel reduction while preserving more natural
                  tooth structure
                </li>
                <li>
                  <strong>No-prep veneers:</strong> No enamel removal; reversible when candidacy allows
                </li>
              </ul>
              <p>
                Color, shape, and translucency are customized to your facial features, skin tone,
                and preferences. The goal is results that enhance your existing smile, not overwrite
                it.
              </p>
            </article>
            <article class="compare-card">
              <a
                class="compare-card__stretch"
                href="/cosmetic-dentistry/clear-aligners/"
                aria-label="Learn more about Invisalign and clear aligners"></a>
              <span class="tag">Alignment</span>
              <h3>Invisalign and Orthodontic Alignment</h3>
              <p>
                Correcting tooth position before placing veneers typically produces cleaner,
                longer-lasting results. Vivid Smiles offers Invisalign either as a preparatory step
                or as a standalone cosmetic solution for patients whose primary concern is
                alignment.
              </p>
            </article>
            <article class="compare-card">
              <a
                class="compare-card__stretch"
                href="/cosmetic-dentistry/teeth-whitening/"
                aria-label="Learn more about Teeth Whitening"></a>
              <span class="tag">Brightening</span>
              <h3>Teeth Whitening</h3>
              <p>
                Professional KOR whitening reaches shades not achievable with at-home products and
                can serve as a standalone solution or a prep step before veneers, delivering results
                that hold for years rather than weeks.
              </p>
            </article>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <Button variant="ghost" href="#faq" hoverLabel="See Answers">Read FAQ</Button>
            </div>
            <span class="cta-note">No commitment · Personal video reply</span>
          </div>
        </div>
      </section>

      {/* ---------- WHY-US (cream) — 2-card why-grid */}
      <section class="section alt" id="why-us" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("why-us").eyebrow}</span>
            <h2><Fragment set:html={section("why-us").heading} /></h2>
            <p>{section("why-us").body}</p>
          </div>

          <div class="why-grid">
            <article class="why-card">
              <div class="num">01</div>
              <h3>Dr. Bryce Richardson's Cosmetic Dentistry Expertise</h3>
              <p>
                Dr. Richardson earned his DDS from Indiana University School of Dentistry, graduated
                at the top of his class clinically, and has completed 600+ hours of specialized
                esthetic and surgical training. He served on staff at Implant Pathway, one of the
                country's most respected implant training facilities, and is a Parker resident and
                active community member. His approach is consistent across every case: enhance your
                natural features rather than replace them, working toward Vivid Smiles' goal of
                becoming Colorado's leading cosmetic dental destination.
              </p>
            </article>

            <article class="why-card">
              <div class="num">02</div>
              <h3>Advanced Technology for Predictable Results</h3>
              <p>
                Digital scanning eliminates traditional impressions, and in-house milling units and
                3D printers reduce wait time on custom restorations. CBCT 3D imaging provides a
                complete diagnostic picture before treatment begins, and digital smile design
                connects the full technology stack to a preview you can see and refine. Every tool
                at Vivid Smiles is selected for what it does for the patient: less time waiting,
                more confidence in the outcome.
              </p>
            </article>
          </div>
        </div>
      </section>

      {/* ---------- COST (paper) — lasting-card with timeline stat + cost prose */}
      <section class="section" id="cost" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">Investment</span>
            <h2><Fragment set:html={section("cost").heading} /></h2>
          </div>

          <div class="lasting-card">
            <div class="lasting-stat">
              <div class="big">2 visits<em>– 12 mo</em></div>
              <div class="label">Custom timeline based on your plan</div>
            </div>
            <div class="lasting-body">
              <p>{section("cost").body}</p>
              <p>
                For investment, cost reflects the scope of your plan. Vivid Smiles provides
                transparent pricing and discusses financing options at the consultation, so there
                are no surprises after you commit. Patients who are uninsured or looking for
                additional cost flexibility may benefit from the practice's in-house dental
                membership plan. Most cosmetic procedures are considered elective and are not
                covered by dental insurance, though treatments that address both cosmetic and
                functional concerns may qualify for partial coverage.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* ---------- RESULTS (cream) ---------- */}
      <section class="section alt" id="results">
        <div class="wrap">
          <div class="section-head" data-vs-reveal>
            <span class="eyebrow">{section("results").eyebrow}</span>
            <h2><Fragment set:html={section("results").heading} /></h2>
            <p>{section("results").body}</p>
            <div class="cta-row">
              <div class="cta-buttons">
                <Button variant="light" href="/smile-gallery/" hoverLabel="Open Gallery"
                  >View the Smile Gallery</Button
                >
                <Button
                  variant="ghost-light"
                  href="/patient-testimonials/"
                  hoverLabel="Read Stories">Patient Stories</Button
                >
              </div>
            </div>
          </div>
        </div>

        <div class="gallery-marquee" data-vs-marquee aria-label="Vivid Smiles smile gallery">
          <div class="gallery-track" data-vs-marquee-track>
            {
              galleryTrack.map((t, i) => {
                const isClone = i >= galleryTiles.length;
                return (
                  <div
                    class="smile-tile"
                    aria-hidden={isClone || undefined}
                    inert={isClone || undefined}
                  >
                    <Image src={t.src} alt={t.alt} widths={[420, 640, 840]} sizes="420px" />
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      {/* ---------- FAQ (paper) — native details/summary, zero JS ---------- */}
      <section class="section" id="faq" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("faq").eyebrow}</span>
            <h2><Fragment set:html={section("faq").heading} /></h2>
          </div>

          <div class="faq-list">
            {
              faqs.map((f) => (
                <details class="faq" open={f.open}>
                  <summary>
                    <>
                      <h3>{f.q}</h3>
                      <span class="icon" aria-hidden="true">
                        +
                      </span>
                    </>
                  </summary>
                  <div class="answer" set:html={f.a} />
                </details>
              ))
            }
          </div>

          <div class="pull">
            <p>{section("faq").body}</p>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Still Have Questions? Free Virtual Consult</Button
              >
              <Button variant="ghost" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>

      {
        /* ---------- VIRTUAL CONSULT — body slot carries the source MD's
         italicized closing lead-in paragraph verbatim. */
      }
      <VirtualConsult id="consult" eyebrow="Free smile makeover consultation">
        <Fragment slot="headline">Free smile makeover <em>consultation.</em></Fragment>
        <Fragment slot="body">
          If you have spent years wanting to fix your smile, the next step is a consultation, not a
          commitment. At Vivid Smiles Dentistry, Dr. Richardson starts every smile makeover with a
          comprehensive analysis and a digital preview so you can see exactly what your results will
          look like before any treatment begins.
        </Fragment>
      </VirtualConsult>

      {/* ---------- CLOSING BAND ---------- */}
      <FinalBand>
        <p>
          Vivid Smiles is located in Parker, CO and has earned 300+ five-star Google reviews from
          patients who wanted natural, lasting results and got them.
        </p>
      </FinalBand>
    </main>

    <script>
      import { initTocSpy } from '../../scripts/toc-spy';
      initTocSpy('.smilemakeover');
    </script>

    {/* JSON-LD structured data — service-page trio matching veneers / FMR. */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'MedicalProcedure',
        name: 'Smile Makeover',
        alternateName: [
          'Cosmetic Smile Design',
          'Custom Smile Makeover',
          'Cosmetic Dentistry Plan',
        ],
        procedureType: 'https://schema.org/SurgicalProcedure',
        bodyLocation: 'Teeth',
        preparation:
          'Comprehensive cosmetic analysis and a digital smile design preview before any treatment begins; specific preparation depends on the combination of procedures (veneers, Invisalign, whitening, bonding) included in the plan.',
        howPerformed:
          'Two or more cosmetic dental treatments are sequenced into a single coordinated plan. Most plans include porcelain veneers as the centerpiece and may add Invisalign alignment, professional whitening, and dental bonding as needed. Color, shape, and translucency are customized using digital smile design and refined with the patient before fabrication and placement.',
        followup:
          'Routine brushing, flossing, and dental visits; a nightguard is recommended for bruxism patients to protect veneers and other restorations.',
        performer: {
          '@type': 'Dentist',
          name: 'Dr. Bryce Richardson',
          worksFor: {
            '@type': 'Dentist',
            name: 'Vivid Smiles Dentistry',
            address: {
              '@type': 'PostalAddress',
              streetAddress: addressStreet,
              addressLocality: addressCity,
              addressRegion: addressState,
              postalCode: addressZip,
              addressCountry: 'US',
            },
            telephone: phoneE164,
          },
        },
      })}
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      })}
    />

    {
      /* Breadcrumb URLs source the host from astro.config.mjs `site` and use
        real site routes (matching the visible breadcrumb above). Trailing
        slashes required because the site is configured `trailingSlash: 'always'`. */
    }
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Services',
            item: new URL('/services/', Astro.site).href,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: 'Cosmetic Dentistry',
            item: new URL('/cosmetic-dentistry/', Astro.site).href,
          },
          {
            '@type': 'ListItem',
            position: 4,
            name: 'Smile Makeover',
            item: new URL('/cosmetic-dentistry/smile-makeover/', Astro.site).href,
          },
        ],
      })}
    />
  </div>
</BaseLayout>
