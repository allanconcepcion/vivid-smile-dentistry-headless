---
/**
 * Porcelain Veneers — Vivid Smiles Dentistry, Parker CO.
 *
 * Recovered template (post-bundler decode): /tmp/porcelain-veneers-template.html
 * Page-scoped styles: src/styles/pages/porcelain-veneers.css
 * Buttons + scroll reveals wired by src/scripts/animations.js (data-vs-arrow / data-vs-reveal*).
 *
 * Global <Nav /> + <Footer /> are mounted by BaseLayout — this page renders
 * only its own content, starting with an inline breadcrumb under the global nav.
 *
 * MIGRATED TO BLOCKS (docs/PAGE-BLOCKS.md 2.3). Ten top-level bands — why,
 * what, process, compare, natural, lasting, local, cost, gallery, faq — each
 * guarded with `hasBlocks ? null : …` and each carrying a row in
 * cms/import/block-map.json under /cosmetic-dentistry/porcelain-veneers/.
 * `cost` is the tenth and the reason this page waited: it is a standalone
 * <section> around a one-tier <PricingTiers>, which is the shape the
 * `pricing_tiers` layout serves.
 *
 * Two things this page owns that the pilot does not:
 *   1. `process` is FIVE steps in a five-column grid (porcelain-veneers.css:341
 *      is repeat(5, 1fr)) and the layout's Columns select stops at 4. The
 *      backfilled band draws four across with the fifth wrapping. Recorded as a
 *      known_gap on that block in the map — closing it is a `5` choice in the
 *      PHP select plus a `.process-grid.cols-5` rule in ProcessStepsBlock.
 *   2. The LocalTrust band's key is `porcelain_veneers_local`, registered in
 *      BOTH cms/mu-plugins/vs-content-model.php (BLOCK_CODE_BANDS) and
 *      src/blocks/CodeSectionBlock.astro (BANDS). Keys are per PAGE because the
 *      props below are page content.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import FinalBand from '../../components/FinalBand.astro';
import VirtualConsult from '../../components/VirtualConsult.astro';
import LocalTrust from '../../components/LocalTrust.astro';
import PricingTiers from '../../components/PricingTiers.astro';
import { phoneHref, phoneLabel, bookNowHref } from '../../data/contact';
import { getSmiles } from '../../lib/smiles';
import { getPageContent, type TocLink } from '../../lib/page-content';
import PageBlocks from '../../blocks/PageBlocks.astro';
import '../../styles/pages/porcelain-veneers.css';

// Hero — a patient portrait. replaced a full-face portrait here that
// turned out to be the PRE-treatment frame of that patient's before/after
// pair, so the veneers page was led by a photo of someone before she got
// veneers. Two mouth-macro replacements were tried and both read as an
// intraoral exam next to the headline — the macro sources are tight enough
// that no crop includes eyes. This subject appears nowhere in
// src/assets/images/smiles/, so she cannot collide with the marquee below.
// "What are veneers" — the actual porcelain shells on a model, which shows what
// a veneer physically is better than any in-mouth shot can.
// "Natural results" — the in-mouth result. Lab shells read opaque and
// artificial, which is the opposite of what this section argues.
// Auto-loaded from src/assets/images/smiles/ — every photo in the folder is a
// real Dr. Richardson patient case and appropriate for this page.
// Table of contents, process steps and FAQs are edited in WordPress
// (Pages -> Porcelain Veneers). The shapes are identical to the arrays that
// used to live here, so the markup below is unchanged.
const { blocks, hasBlocks, tocLinks, processSteps, faqs, section, image, seo } =
  await getPageContent(Astro.url.pathname);



const galleryTiles = getSmiles();
const galleryTrack = [...galleryTiles, ...galleryTiles];

/**
 * The "On this page" rail, derived from the blocks themselves (docs/PAGE-BLOCKS.md 1.2).
 *
 * Used only when this page renders from `blocks`. The `toc_links` repeater is
 * nine rows that restate the order of the ten bands below it, so a reorder in
 * wp-admin moves a band and leaves its rail entry pointing at the old
 * neighbour — the single largest way a reorder breaks a link. Reading the
 * anchors off the blocks makes that unrepresentable: there is one ordering and
 * the rail is a projection of it.
 *
 * Three rules, in the order they bite:
 *
 * 1. A blank anchor is skipped. Not tidiness — src/scripts/toc-spy.ts:24 feeds
 *    each rendered href straight to document.querySelector(), and
 *    querySelector("") throws a SyntaxError that kills the whole spy, not just
 *    the one entry. PageBlocks.astro emits no id at all for a blank anchor
 *    (`id={anchor || undefined}`), so there is nothing to link to either.
 * 2. An anchor that is not a valid id selector is skipped for the same reason —
 *    "#3-reasons" is legal HTML and an illegal CSS selector. Dropping one rail
 *    entry costs one link; letting it through costs every link on the page,
 *    plus the mobile pill auto-centering.
 * 3. Duplicate anchors follow PageBlocks.astro's dedup exactly, second
 *    occurrence onward suffixed `-2`, `-3`. The counter has to advance on every
 *    non-blank anchor, including blocks with no nav_label, or the rail's idea
 *    of "the second #faq" drifts from the id the renderer actually emitted.
 *
 * A blank nav_label means "leave this block out of the rail" (1.2), which is
 * how a band that should not be navigable opts out — `gallery` on this page,
 * which has no toc_links row and never appeared in the rail.
 */
const ANCHOR_IS_ID_SELECTOR = /^[A-Za-z_][A-Za-z0-9_-]*$/;

const anchorsSeen = new Map<string, number>();
// Typed as TocLink[] rather than an equivalent inline shape so the ternary in
// the rail below collapses to one type instead of a union of two array types,
// which TypeScript will not let you call .map() on.
const derivedTocLinks: TocLink[] = [];

for (const block of blocks) {
  // A nested block is drawn INSIDE the band above it, not as a band of its own,
  // so it has no id to link to. Without this the rail emits an entry pointing at
  // an anchor nothing renders — a dead link in the "On this page" list.
  if (block?.nested) continue;

  const anchor = typeof block.anchor === 'string' ? block.anchor.trim() : '';
  if (anchor === '') continue;

  const nth = (anchorsSeen.get(anchor) ?? 0) + 1;
  anchorsSeen.set(anchor, nth);

  const label = typeof block.navLabel === 'string' ? block.navLabel.trim() : '';
  if (label === '') continue;

  if (!ANCHOR_IS_ID_SELECTOR.test(anchor)) {
    console.warn(
      `[blocks] anchor "${anchor}" on ${Astro.url.pathname} cannot be used as a selector — ` +
        `omitting "${label}" from the On this page rail so toc-spy keeps working`,
    );
    continue;
  }

  derivedTocLinks.push({ href: `#${nth > 1 ? `${anchor}-${nth}` : anchor}`, label });
}

---

<BaseLayout
  title={seo.title || "Porcelain Veneers in Parker, CO | Vivid Smiles Dentistry"}
  description={seo.description || "No-prep & minimal-prep porcelain veneers in Parker, CO with Dr. Bryce Richardson. Preview your smile with Digital Smile Design before any treatment begins."}
 noindex={seo.noindex}>
  <div class="pveneers">
    {/* ---------- BREADCRUMB ---------- */}
    <nav class="crumbs" aria-label="Breadcrumb">
      <div class="crumbs-inner">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href="/services/">Services</a>
        <span class="sep">/</span>
        <a href="/cosmetic-dentistry/">Cosmetic Dentistry</a>
        <span class="sep">/</span>
        <span class="here">Porcelain Veneers</span>
      </div>
    </nav>

    <main id="main">
      {/* ---------- HERO ---------- */}
      <header class="hero" data-vs-reveal-batch>
        <div class="wrap hero-inner">
          <div class="hero-copy">
            <span class="eyebrow">Cosmetic Dentistry · Parker, CO</span>
            <h1 data-vs-reveal-lines>Porcelain Veneers <em>in Parker, CO</em></h1>
            <p class="hero-sub">
              Porcelain veneers are thin shells of dental porcelain bonded to the front of your
              teeth to correct discoloration, chips, gaps, and worn enamel. At Vivid Smiles
              Dentistry, Dr. Bryce Richardson specializes in no-prep and minimal-prep veneers that
              transform smiles while preserving natural tooth structure. Here is what the process
              looks like, how digital technology lets patients preview results first, and what sets
              this Parker practice apart.
            </p>
            <div class="hero-actions">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <div class="ratings">
                <span class="stars" aria-hidden="true">★★★★★</span>
                <span>5.0 · 300+ reviews</span>
              </div>
            </div>
          </div>
          <div class="hero-img" data-vs-parallax data-parallax="-30">
            <Image
              src={image("heroImg").url} width={image("heroImg").width} height={image("heroImg").height}
              alt="Vivid Smiles patient smiling in front of the practice neon sign"
              widths={[500, 750, 1000]}
              sizes="(max-width: 991px) 100vw, 50vw"
            />
          </div>
        </div>
      </header>

      {/* ---------- KEYS — at-a-glance ---------- */}
      <section class="keys" id="keys" aria-label="Veneers at a glance" data-vs-reveal-batch>
        <div class="keys-grid">
          <div class="keys-label">At a glance</div>
          <div class="keys-item">
            <div class="k">No-prep</div><div class="v">&amp; Minimal-Prep Specialty</div>
          </div>
          <div class="keys-item">
            <div class="k">10–20 yrs</div><div class="v">Typical Lifespan</div>
          </div>
          <div class="keys-item">
            <div class="k">1–2 weeks</div><div class="v">Lab Fabrication</div>
          </div>
          <div class="keys-item">
            <div class="k">Preview First</div><div class="v">Digital Smile Design</div>
          </div>
        </div>
      </section>

      {
        /* ---------- ON-THIS-PAGE TOC ----------
         The rail itself is never a block (spec 7: "Not a block, even though it
         is a band") — only its contents move. Derived from the blocks when
         they are drawing the page, read from the `toc_links` repeater when the
         template is. Same markup either way, which is what lets
         src/scripts/toc-spy.ts go on reading its section list off the rendered
         links without knowing which source produced them. */
      }
      <nav class="toc" id="toc" aria-label="On this page">
        <div class="toc-inner">
          <span class="toc-label">On this page</span>
          <div class="toc-scroll">
            <div class="toc-list">
              {(hasBlocks ? derivedTocLinks : tocLinks).map((l) => <a href={l.href}>{l.label}</a>)}
            </div>
          </div>
        </div>
      </nav>

      {
        /* ---------- WHY (paper) ----------

         THE MIGRATION SWITCH (docs/PAGE-BLOCKS.md 2.3) starts here. `hasBlocks`
         means "this build can draw this page from its blocks" — not "WordPress
         sent rows" (src/lib/page-content.ts). When it is true PageBlocks draws
         the ten bands in the order an editor arranged them; when it is false —
         which is every build until the backfill has run, and again the moment
         an editor empties the field — every band below renders exactly as it
         always has.

         Written as one guard per band rather than one guard around all ten on
         purpose, and it is not a style choice. Astro's compressHTML pass treats
         an Astro comment expression differently inside a component slot than at
         element level: wrapping these bands in a Fragment silently drops one
         space at every comment boundary below, and scripts/vr-html.mjs compares
         exact bytes and calls that a difference. A guard sitting exactly where
         its section sat emits byte-identical HTML.

         EVERY top-level band between here and <VirtualConsult> is guarded, and
         every one of them has a row in cms/import/block-map.json. Those two
         facts have to move together: a band that is neither blocked nor guarded
         renders in ADDITION to the block run and lands at the bottom of the
         page, and a band that is guarded with no map row disappears on backfill
         with nothing in the log. There is no third outcome. The bands ABOVE
         this line — the breadcrumb, the hero, `.keys` and the rail — are not
         blocks by spec 7 and are deliberately unguarded, as are <VirtualConsult>
         and <FinalBand> below the run. */
      }
      {hasBlocks ? <PageBlocks blocks={blocks} /> : <section class="section" id="why" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("why").eyebrow}</span>
            <h2><Fragment set:html={section("why").heading} /></h2>
            <p>{section("why").body}</p>
          </div>

          <div class="why-grid">
            <article class="why-card">
              <div class="num">01</div>
              <h3>No-Prep and Minimal-Prep Veneer Expertise</h3>
              <p class="lead">
                No-prep and minimal-prep veneers deliver the same transformation as traditional
                veneers while preserving natural tooth structure.
              </p>
              <p>
                Traditional veneers require removing approximately 0.5mm to 1.0mm of enamel from the
                front of each tooth, a permanent change because enamel does not regenerate.
                Minimal-prep veneers remove 0.3mm or less; no-prep veneers require no enamel removal
                at all.
              </p>
              <p>
                That difference matters: a tooth with less preparation can still function without
                veneers if they ever need to be replaced, and more options remain available over the
                long term.
              </p>
            </article>

            <article class="why-card">
              <div class="num">02</div>
              <h3>Digital Smile Design: Preview Your Results First</h3>
              <p class="lead">
                Digital smile design lets you see your new smile on screen before any preparation or
                placement begins.
              </p>
              <p>
                Dr. Richardson generates a digital preview at your consultation, calibrated to your
                facial features and preferences. If anything looks wrong, you adjust it before
                committing. This directly answers what most patients don't say out loud: what if I
                don't like how they look?
              </p>
            </article>
          </div>
        </div>
      </section>}

      {/* ---------- WHAT (charcoal) — `.section.alt` is var(--vs-charcoal-green)
       on THIS page (porcelain-veneers.css:244), not the cream the same class
       name means on teeth-whitening.css:237. The band value in the map is read
       off that rule, not off the class. ---------- */}
      {hasBlocks ? null : <section class="section alt" id="what" data-vs-reveal-batch>
        <div class="wrap">
          <div class="what-grid">
            <div class="what-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("whatImg").url} width={image("whatImg").width} height={image("whatImg").height}
                alt="Porcelain veneer shells seated on a dental model at Vivid Smiles in Parker, CO"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
            <div class="what-text">
              <span class="eyebrow">{section("what").eyebrow}</span>
              <h2><Fragment set:html={section("what").heading} /></h2>
              <div class="prose">
                <p>{section("what").body}</p>
              </div>
              <div class="cta-row left">
                <div class="cta-buttons">
                  <Button variant="light" href="#consult" hoverLabel="Get a Video"
                    >Free Virtual Consult</Button
                  >
                  <Button variant="ghost-light" href="#process" hoverLabel="View Steps"
                    >How It Works</Button
                  >
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- PROCESS (sage-pale) — `.section.dark` is var(--vs-sage-pale)
       here (porcelain-veneers.css:253). `sage` and `sage-pale` are two separate
       BLOCK_BANDS choices painting two different tokens, so the map says
       sage-pale. ---------- */}
      {hasBlocks ? null : <section class="section dark" id="process" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow light">The Process</span>
            <h2><Fragment set:html={section("process").heading} /></h2>
            <p>{section("process").body}</p>
          </div>

          <div class="process-grid">
            {
              processSteps.map((s) => (
                <div class="process-card">
                  <span class="step-tag">{s.tag}</span>
                  <div class="num">{s.num}</div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              ))
            }
          </div>

          <div class="inline-cta dark">
            <div class="ic-text">
              Ready for the next step? <em>Book online and we'll take it from here.</em>
            </div>
            <div class="ic-buttons">
              <Button variant="light" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button
              >
              <Button variant="ghost-light" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- COMPARE (paper) ---------- */}
      {hasBlocks ? null : <section class="section" id="compare" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("compare").eyebrow}</span>
            <h2><Fragment set:html={section("compare").heading} /></h2>
            <p>{section("compare").body}</p>
          </div>

          <div class="compare">
            <article class="compare-card">
              <span class="tag">Resin</span>
              <h3>Dental bonding</h3>
              <p>
                Resin is shaped directly on the tooth. Affordable and reversible, but less durable
                and prone to staining. Best for minor corrections.
              </p>
            </article>
            <article class="compare-card">
              <span class="tag">Full-Coverage</span>
              <h3>Dental crowns</h3>
              <p>
                Cap the full tooth rather than just the front surface. More appropriate for
                significant structural damage; more invasive than veneers for cosmetic purposes.
              </p>
            </article>
            <article class="compare-card featured">
              <span class="ribbon">Our Specialty</span>
              <span class="tag">Porcelain</span>
              <h3>Porcelain veneers</h3>
              <p>
                Cover only the front surface with stain-resistant porcelain. The right choice when a
                lasting cosmetic correction is the goal and the tooth is structurally healthy.
              </p>
            </article>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Free Virtual Consult</Button
              >
              <Button variant="ghost" href="#faq" hoverLabel="See Answers">Read FAQ</Button>
            </div>
            <span class="cta-note">No commitment · Personal video reply</span>
          </div>
        </div>
      </section>}

      {/* ---------- NATURAL (charcoal) — same `.section.alt` rule as `what`
       above, porcelain-veneers.css:244. ---------- */}
      {hasBlocks ? null : <section class="section alt" id="natural" data-vs-reveal-batch>
        <div class="wrap">
          <div class="natural-grid">
            <div class="natural-text">
              <span class="eyebrow">{section("natural").eyebrow}</span>
              <h2><Fragment set:html={section("natural").heading} /></h2>
              <div class="natural-quote">
                Veneers that look artificial are a failure of the planning process.
              </div>
              <div class="prose">
                <p>{section("natural").body}</p>
              </div>
            </div>
            <div class="natural-img" data-vs-parallax data-parallax="-25">
              <Image
                src={image("naturalImg").url} width={image("naturalImg").width} height={image("naturalImg").height}
                alt="Macro close-up of finished porcelain veneers in place"
                widths={[500, 800, 1100]}
                sizes="(max-width: 991px) 100vw, 50vw"
              />
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- LASTING (paper) ---------- */}
      {hasBlocks ? null : <section class="section" id="lasting" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("lasting").eyebrow}</span>
            <h2><Fragment set:html={section("lasting").heading} /></h2>
            <p>{section("lasting").body}</p>
          </div>

          <div class="lasting-card">
            <div class="lasting-stat">
              <div class="big">20+<em>years</em></div>
              <div class="label">Typical lifespan with proper care</div>
            </div>
            <div class="lasting-body">
              <p>
                Protecting veneers from grinding (a nightguard is recommended for bruxism patients),
                regular brushing and flossing, and routine checkups all extend their lifespan.
              </p>
              <p>
                No-prep and minimal-prep veneers have an added advantage: if replacement is needed,
                more natural structure remains to support the new set.
              </p>
            </div>
          </div>
        </div>
      </section>}

      {/* ---------- LOCAL (cream) ----------
       Guarded like every other band on this page. When the page renders from
       blocks, this band comes back through a `code_section` row whose band_key
       is `porcelain_veneers_local` — this page's own key, not the pilot's
       `local_trust`, because the four props below are page CONTENT and a shared
       key would print "for Clear Aligners" under a veneers heading.

       Leaving it unguarded renders it TWICE: once mid-page from PageBlocks and
       once here, both carrying id="local", which is invalid and sends the "On
       this page" rail and every #local link to whichever the browser picks.

       The props stay here; CodeSectionBlock.astro reproduces them verbatim in
       its BANDS map rather than reading them, so the two copies must be changed
       together. The band draws LocalTrust's cream default — no `background` is
       passed on either side. */}
      {hasBlocks ? null : (
        <LocalTrust
          heading="Veneers Designed"
          headingItalic="in Parker, Colorado"
          intro="Dr. Richardson is a Parker resident who built Vivid Smiles Dentistry to bring high-level cosmetic care to patients locally and from across the country."
          body="Located on Cedar Gulch Parkway, the practice welcomes patients locally and from out of state — many travel in for their veneer treatment. With 300+ five-star reviews, it has a reputation for consistent results and genuine attention to every patient."
        />
      )}

      {
        /* ---------- COST (paper) — Investment + 1-tier PricingTiers.
         Placed between LocalTrust (cream) and Gallery (sage-pale) so the band
         rhythm stays cream → paper → sage-pale → paper for the closing run.

         This is the band that kept the page out of Phase 3. It is a STANDALONE
         <section> holding a section-head and a <PricingTiers> — exactly the
         shape the `pricing_tiers` layout was built for, and the same shape as
         the four implant pages. (teeth-whitening's price table is nested inside
         its #lasting band, which is why that one is still a recorded gap.)
         The tier's every value — the $2,250, the tagline, the "per tooth"
         suffix, the five bullets and the financing note — is transcribed into
         the map from the invocation below. */
      }
      {hasBlocks ? null : <section class="section" id="cost" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("cost").eyebrow}</span>
            <h2><Fragment set:html={section("cost").heading} /></h2>
            <p>{section("cost").body}</p>
          </div>

          <PricingTiers
            tiers={[
              {
                name: 'Porcelain Veneers',
                price: '$2,250',
                priceSuffix: 'per tooth',
                tagline: 'Custom hand-layered porcelain — one tooth at a time.',
                bullets: [
                  'Master ceramist hand-layered porcelain',
                  'Digital Smile Design preview before treatment',
                  'No-prep and minimal-prep techniques available',
                  'CBCT-planned bite check',
                  'Vivid Smiles touch-up policy',
                ],
                highlight: true,
              },
            ]}
            financingNote="Porcelain veneers are cosmetic and aren't covered by most dental insurance plans. Vivid Smiles offers in-house financing and a dental membership plan for uninsured patients — both reviewed during your consultation."
          />
        </div>
      </section>}

      {/* ---------- GALLERY (sage-pale) — marquee, doubled track.
       Out of the rail on both sides of the switch: this page has no `toc_links`
       row for #gallery, so the derived rail leaves it out exactly as the
       repeater does. ---------- */}
      {hasBlocks ? null : <section class="section dark" id="gallery">
        <div class="wrap">
          <div class="section-head" data-vs-reveal>
            <span class="eyebrow light">Smile Gallery</span>
            <h2><Fragment set:html={section("gallery").heading} /></h2>
            <p>{section("gallery").body}</p>
          </div>
        </div>

        <div class="gallery-marquee" data-vs-marquee aria-label="Vivid Smiles smile gallery">
          <div class="gallery-track" data-vs-marquee-track>
            {
              galleryTrack.map((t, i) => {
                const isClone = i >= galleryTiles.length;
                return (
                  <div
                    class="smile-tile"
                    aria-hidden={isClone || undefined}
                    inert={isClone || undefined}
                  >
                    <Image src={t.src} width={t.width} height={t.height} alt={t.alt} widths={[420, 640, 840]} sizes="420px" />
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>}

      {/* ---------- FAQ (paper) — native details/summary, zero JS ---------- */}
      {hasBlocks ? null : <section class="section" id="faq" data-vs-reveal-batch>
        <div class="wrap">
          <div class="section-head">
            <span class="eyebrow">{section("faq").eyebrow}</span>
            <h2><Fragment set:html={section("faq").heading} /></h2>
          </div>

          <div class="faq-list">
            {
              faqs.map((f) => (
                <details class="faq" open={f.open}>
                  <summary>
                    <>
                      <h3>{f.q}</h3>
                      <span class="icon" aria-hidden="true">
                        +
                      </span>
                    </>
                  </summary>
                  <div class="answer">{f.a}</div>
                </details>
              ))
            }
          </div>

          <div class="pull">
            <p>{section("faq").body}</p>
          </div>

          <div class="cta-row">
            <div class="cta-buttons">
              <Button variant="sage" href="#consult" hoverLabel="Get a Video"
                >Still Have Questions? Free Virtual Consult</Button
              >
              <Button variant="ghost" href={phoneHref} hoverLabel="Tap to Dial"
                >Call {phoneLabel}</Button
              >
            </div>
          </div>
        </div>
      </section>}

      {
        /* ---------- VIRTUAL CONSULT — primary closing conversion.
         NOT a block and deliberately unguarded, like the breadcrumb, hero,
         `.keys` strip and the rail above: it renders on both sides of the
         switch and has no row in the map. It sits after the block run in
         template order and PageBlocks draws at the `why` position, so the
         closing pair still comes last.
         Anchor #consult is the destination for every mid-page CTA on this
         page; the form delivers users directly to a Typeform that sends
         Dr. Richardson their photo + questions for a personalized video reply.
         Service-specific framing via slot. */
      }
      <VirtualConsult id="consult" eyebrow="Free veneers consultation">
        <Fragment slot="headline">Free veneers <em>consultation.</em></Fragment>
        <Fragment slot="body">
          Curious about your veneer options? Skip the office visit — Dr. Richardson personally
          records a custom video reviewing your smile, the changes you're imagining, and what's
          possible with no-prep or minimal-prep porcelain veneers, all from photos you submit below.
        </Fragment>
      </VirtualConsult>

      {/* ---------- CLOSING BAND ---------- */}
      <FinalBand>
        <p>Patients welcome locally and from out of state.</p>
      </FinalBand>
    </main>

    <script>
      import { initTocSpy } from '../../scripts/toc-spy';
      initTocSpy('.pveneers');
    </script>

