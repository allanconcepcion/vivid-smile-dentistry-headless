---
/**
 * About Us `#credentials` — the charcoal band of eight logo badges under a
 * centred SectionIntro: "Credentials & Recognition" / "The standards
 * we practice by." and the AACD … Vivid Smile Process cards.
 *
 * A code_section band, registered as `about_us_credentials` in
 * src/blocks/CodeSectionBlock.astro. The template hard-codes
 * `id="credentials"` (about-us/index.astro:701), so `id` defaults to that and
 * CodeSectionBlock overrides it with the row's deduped anchor.
 *
 * ── D1: a route-scoped band reads its own page ────────────────────────────
 * The intro is the `credentials-intro` Section-copy row and the eight logos
 * are Images-tab slots (aacdLogo … vsLogo), both edited in wp-admin under
 * Pages -> About Us, and a code band receives props only
 * (CodeSectionBlock.astro:607-611). Freezing them in the BANDS entry would make
 * one live row and eight live slots dead. So this component calls
 * `getPageContent(Astro.url.pathname)` itself — the same read the template
 * runs at about-us/index.astro:49 — guarded by the `route` prop: on any other
 * route it renders NOTHING and warns, because the row and the slots it asks
 * for exist only on the about-us page entry. Decision D1, 2026-09-08.
 *
 * ── What is live and what is literal ──────────────────────────────────────
 * Live: the intro's eyebrow/heading/lede through introFrom
 * (about-us/index.astro:353, page-content.ts:503-521 — the template's literals
 * are the per-box fallback, so the head is byte-identical until the row is
 * edited) and the eight logos (url/width/height per slot). Also live: the
 * Google badge's title, built from Practice Settings as
 * `${googleRating} · ${googleReviewCount} Reviews` (contact.ts:59-60 — the
 * defaults are "5.0" and "300+", so the string is byte-identical to the
 * template's literal "5.0 · 300+ Reviews" at about-us/index.astro:107 until
 * someone types a new figure). Literal: every badge's `alt`, `title`, `body`,
 * `year` and `meta` — the `credentials` array at about-us/index.astro:57-121,
 * frozen here by D8 (a shared Practice Settings repeater is a later round).
 * The slots' alts are null live, so the literal alts are what ship, as the
 * template shipped them.
 *
 * ── Markup ────────────────────────────────────────────────────────────────
 * Verbatim from about-us/index.astro:701-729: `section.section.alt[id]` >
 * `.wrap[data-vs-reveal-batch]` > <SectionIntro centered class="aus-section-head">
 * + `.creds-grid[data-vs-reveal-batch]` > eight <CredentialBadge>. Both
 * data-vs-reveal-batch attributes are kept (the wrap's AND the grid's). The
 * card markup and its `is:global` CSS travel with CredentialBadge.astro:51-137,
 * unchanged.
 *
 * ── CSS ───────────────────────────────────────────────────────────────────
 * about-us.css restated below, every rule cited by line: the band box
 * (:103, :107, :469), the `.section.alt` inversions (:108-116), `.wrap`
 * (:31, :466), `.aus-section-head` (:136), `.creds-grid` (:407-410, :451,
 * :473) and the h2/em/p primitives the intro sits on (:34-37, :39, :41, :44).
 * Astro scopes by attribute, so a bare `.creds-grid` would tie the page
 * sheet's `.aus .creds-grid` at (0,2,0) and leave bundle order to decide
 * (CodeSectionBlock.astro:437-439); everything below is rooted at
 * `.section.alt`, and the section rule itself is written `section.section.alt`
 * so it outranks `.aus .section.alt` (0,3,0) rather than tying it.
 *
 * Every element under the section except `.wrap` and `.creds-grid` belongs to
 * a child component (SectionIntro, Eyebrow, CredentialBadge) and carries no
 * scope attribute, so those descendants are written `:global(...)` — the
 * same idiom PaymentBand.astro uses for Button's markup and
 * HomeTechnologyBand.astro for its set:html <em>.
 *
 * ONE PRIMITIVE IS DELIBERATELY NOT RESTATED: `.aus h4` (:34-37, :43). The
 * only h4 in this band is the badge title, which CredentialBadge's own global
 * sheet styles at `.vs-cred-badge h4` (0,1,1) — the SAME specificity as
 * `.aus h4`, with different values (20px/1.25 vs 17px/1.1), decided by bundle
 * order today. Re-asserting the page's h4 at (0,3,2) would settle that tie
 * the page's way and could change the card. Left where the cascade already
 * decides it (the PaymentBand precedent for a rule that would CHANGE a band).
 * The same reasoning keeps `.section.alt p` at a specificity below the
 * white-card rescue at global.css:213-262 (0,5,1), so the badge text stays
 * ink on the paper card exactly as today.
 *
 * The page sheet's `.aus` aliases (`--sage`, `--ink`, `--line`, `--r-*`,
 * `--f-display`, about-us.css:10-29) each map 1:1 to a `--vs-*` token; the
 * `--vs-*` names are used here so the band owns its values whether or not the
 * alias block is in the cascade. Same computed values.
 */
import SectionIntro from "./SectionIntro.astro";
import CredentialBadge from "./cards/CredentialBadge.astro";
import { getPageContent, introFrom, type PageImage } from "../lib/page-content";
import { googleRating, googleReviewCount } from "../data/contact";

interface Props {
  /**
   * The route this band belongs to ("/about-us/"). It reads that page's
   * `credentials-intro` Section-copy row and eight image slots, so on any
   * other route it renders nothing and warns.
   */
  route: string;
  /** The DOM id. CodeSectionBlock overrides it with the row's deduped anchor. */
  id?: string;
}

const { route, id = "credentials" } = Astro.props;

// trailingSlash is 'always' (astro.config.mjs:21); normalise both sides anyway
// so "/about-us" and "/about-us/" name the same page, as page-content.ts does.
const withSlash = (p: string) => (p.endsWith("/") ? p : `${p}/`);
const here = Astro.url.pathname;
const onRoute = withSlash(here) === withSlash(route);

if (!onRoute) {
  console.warn(
    `[blocks] CredentialsBand is scoped to ${route} and was asked to render on ${here} — it reads that page's "credentials-intro" section and logo slots, so it renders nothing here`,
  );
}

type Credential = {
  logo: PageImage;
  alt: string;
  title: string;
  body: string;
  year: string;
  meta: string;
};

// about-us/index.astro:353 — the template's literals are the fallback.
let credentialsIntro = { eyebrow: "", heading: "", headingItalic: "", lede: "" };
// about-us/index.astro:57-121, with the Google badge's title built from
// Practice Settings.
let credentials: Credential[] = [];
if (onRoute) {
  // about-us/index.astro:49 — the same read the template runs, only on this route.
  const { section, image } = await getPageContent(here);
  credentialsIntro = introFrom(section("credentials-intro"), { eyebrow: "Credentials & Recognition", heading: "The standards", headingItalic: "we practice by.", lede: "A short list of the training, memberships, and recognition that inform how we practice every day." });
  credentials = [
    {
      logo: image("aacdLogo"),
      alt: 'American Academy of Cosmetic Dentistry',
      title: 'AACD',
      body: 'American Academy of Cosmetic Dentistry.',
      year: 'Member',
      meta: 'Cosmetic Dentistry',
    },
    {
      logo: image("aaidLogo"),
      alt: 'American Academy of Implant Dentistry',
      title: 'AAID',
      body: 'American Academy of Implant Dentistry.',
      year: 'Member',
      meta: 'Implant Dentistry',
    },
    {
      logo: image("famLogo"),
      alt: 'Full Arch Masters',
      title: 'Full Arch Masters',
      body: 'Clinical mentor for advanced surgical and full-arch curriculum.',
      year: 'Faculty',
      meta: 'Clinical Mentor',
    },
    {
      logo: image("iuLogo"),
      alt: 'Indiana University School of Dentistry',
      title: 'Indiana University',
      body: "School of Dentistry — Dr. Richardson's alma mater.",
      year: 'Alumni',
      meta: 'Doctorate',
    },
    {
      logo: image("yomiLogo"),
      alt: 'Yomi Robotics',
      title: 'Yomi Robotics',
      body: 'FDA-cleared robotic-guided implant surgery certification.',
      year: 'Certified',
      meta: 'Certified Surgeon',
    },
    {
      logo: image("adaLogo"),
      alt: 'American Dental Association',
      title: 'ADA',
      body: 'American Dental Association — ethical, evidence-based care.',
      year: 'Member',
      meta: 'Professional Standing',
    },
    {
      logo: image("googleLogo"),
      alt: 'Google Reviews',
      title: `${googleRating} · ${googleReviewCount} Reviews`,
      body: 'Google-verified patient reviews from across the Front Range.',
      year: '2026',
      meta: 'Patient Rated',
    },
    {
      logo: image("vsLogo"),
      alt: 'Vivid Smiles',
      title: 'Vivid Smile Process',
      body: 'Our signature, facially-driven cosmetic methodology.',
      year: 'In-house',
      meta: 'Proprietary Method',
    },
  ];
}
---

{
  onRoute && (
    <section class="section alt" id={id}>
      <div class="wrap" data-vs-reveal-batch>
        <SectionIntro
          eyebrow={credentialsIntro.eyebrow}
          heading={credentialsIntro.heading}
          headingItalic={credentialsIntro.headingItalic}
          lede={credentialsIntro.lede}
          centered
          class="aus-section-head"
        />

        <div class="creds-grid" data-vs-reveal-batch>
          {
            credentials.map((c) => (
              <CredentialBadge
                logoSrc={c.logo.url}
                logoWidth={c.logo.width}
                logoHeight={c.logo.height}
                logoAlt={c.alt}
                title={c.title}
                body={c.body}
                yearTag={c.year}
                metaTag={c.meta}
              />
            ))
          }
        </div>
      </div>
    </section>
  )
}

<style>
  /* ── The band box ────────────────────────────────────────────────────── */
  /* about-us.css:103 (padding) + :107 (background). `section.section.alt`
     rather than `.section.alt` so the scoped rule is (0,3,1) against the page
     sheet's `.aus .section.alt` (0,3,0) — a win, not a tie. Values are the
     same either way. */
  section.section.alt { padding: 110px 0; background: var(--vs-charcoal-green); }

  /* ── Page primitives the band sits on ────────────────────────────────── */
  /* about-us.css:31 */
  .section.alt .wrap { max-width: 1240px; margin: 0 auto; padding: 0 40px; }
  /* about-us.css:136 — the triad's box. The class rides on SectionIntro's
     root element, which carries no scope attribute, hence :global. */
  .section.alt :global(.aus-section-head) { margin: 0 auto 64px; max-width: 760px; }
  /* about-us.css:34-37 + :39, with the :108-110 white-on-charcoal colour
     folded in (it beats the :495 ink override at (0,1,1) on the page too).
     The h2 is SectionIntro's, unscoped. */
  section.section.alt :global(h1),
  section.section.alt :global(h3) { color: #fff; }
  section.section.alt :global(h2) {
    font-family: var(--vs-font-display); font-weight: 400; color: #fff;
    margin: 0; line-height: 1.1; letter-spacing: -0.022em;
    font-size: clamp(32px, 4.2vw, 54px);
  }
  /* about-us.css:41 + :45, with the :111-112 inversion folded in. */
  section.section.alt :global(h2 em),
  section.section.alt :global(em) { font-style: italic; color: var(--vs-eyebrow-on-sage); font-weight: 300; }
  /* about-us.css:44 + :113. Kept at (0,3,2), BELOW the white-card rescue at
     global.css:213-262 (0,5,1), so the badge paragraphs stay ink-soft on the
     paper card as they do today; the lede takes white-85. */
  section.section.alt :global(p) { margin: 0; color: rgba(255, 255, 255, 0.85); }
  /* about-us.css:114-116, restated for the whole box. Matches nothing in this
     band today — the eyebrow is Eyebrow.astro's `.vs-eyebrow.vs-center`
     (global.css:551-563, sage), not `.eyebrow` — exactly as on the page. */
  .section.alt :global(.eyebrow) { color: var(--vs-eyebrow-on-sage); }
  .section.alt :global(.eyebrow)::before,
  .section.alt :global(.eyebrow)::after { background: rgba(255, 255, 255, 0.6); }

  /* ── The grid (about-us.css:407-410) ─────────────────────────────────── */
  .section.alt .creds-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  /* about-us.css:451 — the 1100 block. */
  @media (max-width: 1100px) {
    .section.alt .creds-grid { grid-template-columns: repeat(2, 1fr); }
  }

  /* about-us.css:466 (wrap), :469 (padding), :473 (grid) — the 780 block. */
  @media (max-width: 780px) {
    .section.alt .wrap { padding: 0 22px; }
    section.section.alt { padding: 70px 0; }
    .section.alt .creds-grid { grid-template-columns: 1fr; }
  }
</style>
