---
/**
 * SmartImage — <Image> for a source that may be local OR remote.
 *
 * Astro's <Image> is overloaded: one signature takes an imported ImageMetadata
 * with optional width/height, the other takes a remote URL STRING where both
 * dimensions are required. A prop typed `ImageMetadata | string` with optional
 * dimensions matches neither overload, so TypeScript rejects it even though the
 * value is always valid at runtime.
 *
 * Branching here narrows the union once, in one place, instead of repeating the
 * same ternary in every component that can receive either kind.
 *
 * Needed because most imagery now comes from WordPress as URLs, while
 * design-system.astro still passes local imports — and both have to keep
 * working through the same components.
 *
 * Usage:
 *   <SmartImage src={img.url} width={img.width} height={img.height} alt="…" />
 *   <SmartImage src={localImport} alt="…" />
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src?: ImageMetadata | string;
  /** Required when src is a URL; ignored for a local import. */
  width?: number;
  height?: number;
  alt: string;
  [key: string]: unknown;
}

const { src, width, height, alt, ...rest } = Astro.props;
---

{
  typeof src === "string" ? (
    // Remote: dimensions are mandatory. If they are missing the image is
    // skipped rather than crashing the build on an unrelated page — the loaders
    // already fail loudly when WordPress returns an image without them.
    width && height ? (
      <Image src={src} width={width} height={height} alt={alt} {...rest} />
    ) : null
  ) : src ? (
    <Image src={src} alt={alt} {...rest} />
  ) : null
}
