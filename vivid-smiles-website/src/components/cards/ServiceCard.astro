---
/**
 * ServiceCard — dark cosmetic card with hover-revealed description and
 * an <ArrowBadge> (canonical knock-up + swap hover).
 *
 * Variants:
 *   - default: compact card, description hidden until hover
 *   - featured: taller, description always visible, prominent tag
 *
 * Usage:
 *   <ServiceCard
 *     title="Cosmetic & Veneers"
 *     description="No-prep and minimal-prep veneers…"
 *     tag="Our Signature Work"
 *     featured
 *     index="01"
 *     total="04"
 *     href="/services/cosmetic"
 *   />
 */
import ArrowBadge from "../ArrowBadge.astro";

interface Props {
  title: string;
  description?: string;
  tag?: string;
  featured?: boolean;
  index?: string;
  total?: string;
  href?: string;
  bgImageSrc?: string;
  bgImageAlt?: string;
  class?: string;
}

const {
  title,
  description,
  tag,
  featured = false,
  index,
  total,
  href = "#",
  bgImageSrc,
  bgImageAlt,
  class: extra,
} = Astro.props;

const cls = ["vs-svc-card", featured && "featured", extra].filter(Boolean).join(" ");
---

<a class={cls} href={href} data-vs-arrow>
  <div class="vs-svc-bg">
    {
      bgImageSrc ? (
        <img src={bgImageSrc} alt={bgImageAlt || ""} loading="lazy" />
      ) : (
        <div class="vs-img-placeholder dark">{title}</div>
      )
    }
  </div>

  {
    tag && (
      <span class={`vs-svc-tag${featured ? " featured" : ""}`}>
        {featured && "★ "}
        {tag}
      </span>
    )
  }
  {
    index && total && (
      <span class="vs-svc-num">
        {index} / {total}
      </span>
    )
  }

  <div class="vs-svc-body">
    <h3>{title}</h3>
    {description && <p class="vs-svc-desc">{description}</p>}
    <div class="vs-svc-row-bot">
      <span></span>
      <ArrowBadge size="xl" variant="ghost-light" />
    </div>
  </div>
</a>

<style is:global>
  .vs-svc-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--vs-r-lg);
    background: var(--vs-ink);
    text-decoration: none;
    color: #fff;
    display: flex;
    flex-direction: column;
    min-height: 380px;
    isolation: isolate;
    transition: transform 0.4s ease;
  }

  .vs-svc-card .vs-svc-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .vs-svc-card .vs-svc-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.55) 100%);
    z-index: 1;
  }
  .vs-svc-card .vs-svc-bg img,
  .vs-svc-card .vs-svc-bg .vs-img-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vs-svc-card .vs-img-placeholder.dark {
    background: repeating-linear-gradient(
      -45deg,
      #2c3025 0,
      #2c3025 2px,
      #353a2c 2px,
      #353a2c 12px
    );
    color: rgba(255, 255, 255, 0.4);
  }

  .vs-svc-tag {
    position: absolute;
    top: 22px;
    left: 22px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.28);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    backdrop-filter: blur(8px);
  }
  .vs-svc-tag.featured {
    background: var(--vs-sage);
    border-color: transparent;
  }

  .vs-svc-num {
    position: absolute;
    top: 26px;
    right: 26px;
    z-index: 2;
    font-family: var(--vs-font-display);
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.15em;
  }

  .vs-svc-body {
    position: relative;
    z-index: 2;
    margin-top: auto;
    padding: 24px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .vs-svc-card h3 {
    font-family: var(--vs-font-display);
    font-weight: 400;
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1.06;
    letter-spacing: -0.012em;
    color: #fff;
    margin: 0;
  }

  .vs-svc-desc {
    font-size: 13.5px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.78);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transform: translateY(6px);
    transition: max-height 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.55s cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 0.55s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .vs-svc-card:hover .vs-svc-desc,
  .vs-svc-card.featured .vs-svc-desc {
    max-height: 200px;
    opacity: 1;
    transform: translateY(0);
  }

  .vs-svc-row-bot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }
</style>
