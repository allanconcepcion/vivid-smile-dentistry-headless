---
/**
 * ReviewCard — schema-driven review card.
 * Renders directly from a content-collection entry (or matching shape).
 *
 * Schema fields used (per src/content.config.ts):
 *   reviewer, rating, source, date, tags, body
 *
 * Usage:
 *   <ReviewCard
 *     reviewer="Karen Burlage"
 *     rating={5}
 *     source="Google"
 *     date={new Date("2025-12-27")}
 *     tags={["New Patient", "Staff Experience"]}
 *   >
 *     This was my first visit and everyone on the staff was great…
 *   </ReviewCard>
 */
interface Props {
  reviewer: string;
  rating: number;
  source?: string;
  date?: Date | string;
  tags?: string[];
  class?: string;
}
const { reviewer, rating, source = "Google", date, tags = [], class: extra } = Astro.props;
const cls = ["vs-review-card", extra].filter(Boolean).join(" ");

const stars = "★".repeat(Math.max(0, Math.min(5, Math.round(rating))));

/**
 * WHETHER TO DRAW THE GOOGLE MARK, which until now was never asked.
 *
 * The multicolour "G" below used to render unconditionally, with `{source}`
 * printed next to it — so a Yelp review would have shown the GOOGLE logo
 * followed by the word "Yelp". vs-content-model.php:970-976 registers five
 * sources (Google, Yelp, Facebook, Healthgrades, In-office) and this component
 * only ever knew about one.
 *
 * LATENT, NOT LIVE, and worth saying precisely: all 199 review cards in the
 * current build render "Google", so nothing is wrong on the site today. It
 * fires the first time an editor adds a review from anywhere else — which is
 * exactly the everyday edit this CMS work exists to make safe.
 *
 * NO SUBSTITUTE MARKS ARE INVENTED. The obvious "fix" is four more brand SVGs,
 * and this file is the wrong place to guess at other companies' trademarks
 * from memory — a wrong-but-confident Yelp logo is a worse bug than none, and
 * it would ship into a client's site. A non-Google source therefore renders its
 * NAME alone, which is accurate for all five values. If the practice wants real
 * marks later, they should come from the brands' own asset kits.
 */
const isGoogle = String(source).trim().toLowerCase() === "google";

const dateString = date
  ? new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" })
  : null;
---

<div class={cls}>
  <div class="vs-review-header">
    <div class="vs-review-meta">
      <div class="vs-review-name">{reviewer}</div>
      <div class="vs-review-rating">
        <span class="vs-review-stars-inline">{stars}</span>
        <span class="vs-review-source">
          {isGoogle && (
          <svg class="g-icon" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 12.955 4 4 12.955 4 24s8.955 20 20 20 20-8.955 20-20c0-1.341-.138-2.65-.389-3.917z"/>
            <path fill="#FF3D00" d="m6.306 14.691 6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4 16.318 4 9.656 8.337 6.306 14.691z"/>
            <path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238A11.91 11.91 0 0 1 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
            <path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303a12.04 12.04 0 0 1-4.087 5.571l.003-.002 6.19 5.238C36.971 39.205 44 34 44 24c0-1.341-.138-2.65-.389-3.917z"/>
          </svg>
          )}
          {source}
        </span>
      </div>
      {dateString && <div class="vs-review-date">{dateString}</div>}
    </div>
  </div>

  <p class="vs-review-text"><slot /></p>

  {
    tags.length > 0 && (
      <div class="vs-review-tags">
        {tags.map((tag) => (
          <span class="vs-review-tag">{tag}</span>
        ))}
      </div>
    )
  }
</div>

<style is:global>
  .vs-review-card {
    background: var(--vs-paper);
    border: 1px solid var(--vs-line);
    border-radius: var(--vs-r-lg);
    padding: 28px 28px 24px;
    display: flex;
    flex-direction: column;
    transition: transform 240ms ease, box-shadow 240ms ease;
  }
  .vs-review-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--vs-shadow);
  }
  .vs-review-header {
    margin-bottom: 16px;
  }
  .vs-review-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .vs-review-name {
    font-family: var(--vs-font-display);
    font-size: 15px;
    font-weight: 500;
    color: var(--vs-ink);
    letter-spacing: -0.005em;
    line-height: 1.2;
  }
  .vs-review-rating {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .vs-review-stars-inline {
    color: var(--vs-sage);
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .vs-review-source {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    color: var(--vs-muted);
    letter-spacing: 0.04em;
  }
  .vs-review-source .g-icon {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    display: block;
  }
  .vs-review-date {
    font-size: 10.5px;
    color: var(--vs-muted);
    margin-top: 2px;
    letter-spacing: 0.02em;
  }
  .vs-review-text {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--vs-ink-soft);
    margin: 0 0 16px;
    flex: 1;
  }
  .vs-review-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .vs-review-tag {
    display: inline-flex;
    align-items: center;
    font-size: 10.5px;
    letter-spacing: 0.06em;
    background: var(--vs-cream);
    color: var(--vs-sage);
    border: 1px solid var(--vs-line);
    border-radius: 999px;
    padding: 4px 10px;
    font-weight: 500;
  }
</style>
