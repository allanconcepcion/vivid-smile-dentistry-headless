---
/**
 * CredentialBadge — logo-driven credential card.
 *
 * Logo image + title + short description + meta pill. Used for institutional
 * affiliations and recognition (AACD, AAID, ADA, alma maters, certifications).
 * Differs from CredentialRow (number-driven) — this one leads with the
 * organization mark, not a stat.
 *
 * Usage:
 *   <CredentialBadge
 *     logoSrc={aacdLogo}
 *     logoAlt="American Academy of Cosmetic Dentistry"
 *     title="AACD"
 *     body="American Academy of Cosmetic Dentistry."
 *     yearTag="Member"
 *     metaTag="Accredited"
 *   />
 */
import { Image } from "astro:assets";

interface Props {
  logoSrc: ImageMetadata;
  logoAlt: string;
  title: string;
  body: string;
  yearTag?: string;
  metaTag: string;
  class?: string;
}

const {
  logoSrc,
  logoAlt,
  title,
  body,
  yearTag,
  metaTag,
  class: extra,
} = Astro.props;

const cls = ["vs-cred-badge", extra].filter(Boolean).join(" ");
---

<article class={cls}>
  {yearTag && <span class="yr">{yearTag}</span>}
  <div class="logo-mark">
    <Image src={logoSrc} alt={logoAlt} widths={[160, 320]} sizes="160px" loading="lazy" />
  </div>
  <h4>{title}</h4>
  <p>{body}</p>
  <div class="meta">{metaTag}</div>
</article>

<style is:global>
  .vs-cred-badge {
    position: relative;
    background: var(--vs-paper);
    border: 1px solid var(--vs-line);
    border-radius: var(--vs-r-md);
    padding: 28px 26px 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 230px;
    transition: transform 280ms ease, box-shadow 280ms ease, border-color 280ms ease;
  }
  .vs-cred-badge:hover {
    transform: translateY(-2px);
    box-shadow: var(--vs-shadow);
    border-color: rgba(107, 122, 84, 0.32);
  }
  .vs-cred-badge .yr {
    position: absolute;
    top: 22px;
    right: 24px;
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--vs-muted);
    font-weight: 500;
  }
  .vs-cred-badge .logo-mark {
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  .vs-cred-badge .logo-mark img {
    max-height: 100%;
    max-width: 160px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .vs-cred-badge h4 {
    font-family: var(--vs-font-display);
    font-weight: 500;
    font-size: 20px;
    color: var(--vs-ink);
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.005em;
  }
  .vs-cred-badge p {
    font-size: 13.5px;
    color: var(--vs-ink);
    line-height: 1.6;
    margin: 0;
  }
  .vs-cred-badge .meta {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--vs-line);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--vs-sage);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .vs-cred-badge .meta::before {
    content: "";
    width: 16px;
    height: 1px;
    background: var(--vs-sage);
  }
</style>
