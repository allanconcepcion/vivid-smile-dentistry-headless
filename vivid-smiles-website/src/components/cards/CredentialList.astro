---
/**
 * CredentialList — wrapper for CredentialRow children. Edge-to-edge hover effect
 * works because CredentialList provides the hairline container; the rows use
 * negative-margin to extend background fill across.
 *
 * Usage:
 *   <CredentialList>
 *     <CredentialRow num="15+" label="Years in practice" title="Fifteen years of expertise">
 *       Dr. Richardson has been transforming smiles in Parker since 2010.
 *     </CredentialRow>
 *     ...
 *   </CredentialList>
 */
interface Props {
  class?: string;
}
const { class: extra } = Astro.props;
const cls = ["vs-cred-container", extra].filter(Boolean).join(" ");
---

<div class={cls}>
  <div class="vs-cred-list">
    <slot />
  </div>
</div>

<style is:global>
  .vs-cred-container {
    background: var(--vs-paper);
    border: 1px solid var(--vs-line);
    border-radius: var(--vs-r-lg);
    overflow: hidden;
    padding-inline: 40px;
  }
  .vs-cred-list {
    border-top: 1px solid var(--vs-line);
  }
  .vs-cred-list :first-child {
    border-top: 0;
  }
</style>
