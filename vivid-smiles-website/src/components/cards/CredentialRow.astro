---
/**
 * CredentialRow — large display number + label + title + body.
 * Use inside <CredentialList>. Hover bg extends edge-to-edge.
 *
 * Use `count` to enable the count-up effect (parses target from `num` prop).
 *
 * Usage:
 *   <CredentialRow num="15+" label="Years in practice" title="Fifteen years…" count>
 *     Body text…
 *   </CredentialRow>
 */
interface Props {
  num: string;
  label: string;
  title: string;
  count?: boolean;
  class?: string;
}
const { num, label, title, count = false, class: extra } = Astro.props;
const cls = ["vs-cred-row", extra].filter(Boolean).join(" ");

// Parse numeric target + suffix from the `num` prop (e.g. "15+" → 15 / "+")
const match = num.match(/^([0-9.]+)(.*)$/);
const target = match ? match[1] : null;
const suffix = match ? match[2] : "";
---

<div class={cls} data-vs-reveal>
  {
    count && target ? (
      <div
        class="vs-cred-num"
        data-vs-counter
        data-target={target}
        data-suffix={suffix}
      >
        {num}
      </div>
    ) : (
      <div class="vs-cred-num">{num}</div>
    )
  }
  <div class="vs-cred-info">
    <div class="vs-cred-label">{label}</div>
    <h3>{title}</h3>
    <p><slot /></p>
  </div>
</div>

<style is:global>
  .vs-cred-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 28px;
    align-items: start;
    padding: 28px 0;
    border-bottom: 1px solid var(--vs-line);
    margin: 0 -40px;
    padding-left: 40px;
    padding-right: 40px;
    transition: background 240ms ease;
  }
  .vs-cred-row:hover {
    background: var(--vs-cream);
  }
  .vs-cred-num {
    font-family: var(--vs-font-display);
    font-size: clamp(36px, 4.4vw, 52px);
    line-height: 1;
    color: var(--vs-sage);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .vs-cred-label {
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--vs-muted);
    margin-bottom: 6px;
  }
  .vs-cred-info h3 {
    font-family: var(--vs-font-display);
    font-weight: 500;
    font-size: 18px;
    color: var(--vs-ink);
    margin: 0;
  }
  .vs-cred-info p {
    font-size: 14px;
    line-height: 1.65;
    color: var(--vs-ink-soft);
    margin-top: 8px;
    max-width: 52ch;
  }
  .vs-cred-info p:empty {
    display: none;
  }
</style>
