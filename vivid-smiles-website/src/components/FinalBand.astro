---
/**
 * FinalBand — global pre-footer CTA band.
 *
 * Replaces the inline .final-band section that was duplicated across every
 * service detail page and the contact page. Two CTAs on the right column
 * (Book Online + Call) — the phone number is reachable via the Call button,
 * so no separate phone-text display is rendered. The eyebrow + body copy is
 * per-page (passed via slot).
 *
 * Usage:
 *   <FinalBand>
 *     <p>Page-specific closing sentence here.</p>
 *   </FinalBand>
 *
 *   <FinalBand eyebrow="Prefer to skip the form?" background="cream-warm">
 *     <p>…</p>
 *   </FinalBand>
 */
import Button from "./Button.astro";
import { phoneLabel, phoneHref, bookNowHref } from "../data/contact";

interface Props {
  eyebrow?: string;
  background?: "paper" | "cream-warm";
}

const {
  eyebrow = "Prefer to book directly?",
  background = "paper",
} = Astro.props;
---

<section class:list={["vs-final-band", `vs-final-band--${background}`]} data-vs-reveal>
  <div class="vs-final-band__wrap">
    <div class="vs-final-band__inner">
      <div class="vs-final-band__text">
        <span class="vs-final-band__eyebrow">{eyebrow}</span>
        <slot />
      </div>
      <div class="vs-final-band__actions">
        <Button variant="sage" href={bookNowHref} hoverLabel="Let's Talk">Book Online</Button>
        <Button variant="ghost" href={phoneHref} hoverLabel="Tap to Dial">Call {phoneLabel}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .vs-final-band {
    padding: 90px 40px;
    background: var(--vs-paper);
    border-top: 1px solid var(--vs-line);
  }
  .vs-final-band--cream-warm { background: var(--vs-cream-warm); }

  .vs-final-band__wrap {
    max-width: 1100px;
    margin: 0 auto;
  }

  .vs-final-band__inner {
    display: grid;
    grid-template-columns: 1.2fr auto;
    align-items: center;
    gap: 40px;
  }

  .vs-final-band__eyebrow {
    font-family: var(--vs-font-body);
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--vs-sage);
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .vs-final-band__eyebrow::before {
    content: "";
    width: 28px;
    height: 1px;
    background: var(--vs-sage);
  }

  .vs-final-band__text :global(p) {
    margin: 14px 0 0;
    font-size: 16px;
    color: var(--vs-ink-soft);
    max-width: 50ch;
  }
  .vs-final-band__text :global(a) {
    color: var(--vs-sage);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .vs-final-band__text :global(a:hover) { color: var(--vs-sage-deep); }

  .vs-final-band__actions {
    display: inline-flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 991px) {
    .vs-final-band__inner {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .vs-final-band__actions { justify-content: flex-start; }
  }

  @media (max-width: 780px) {
    .vs-final-band { padding: 60px 22px; }
    .vs-final-band__inner { text-align: left; }
  }
</style>
