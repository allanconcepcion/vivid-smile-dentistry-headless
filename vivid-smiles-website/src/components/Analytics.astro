---
// Sitewide third-party analytics for the document <head>.
// Mounted once per layout (BaseLayout + LandingLayout), as high in <head> as
// possible so Google Tag Manager loads before page content.
// Pair with <AnalyticsNoscript /> at the top of <body> for the GTM fallback.
// is:inline keeps Astro from bundling/transforming these third-party tags.
//
//   Google Tag Manager container: GTM-W5FBTHCQ
//   Microsoft Clarity project:    vkjzesavnp
//
// Ahrefs Web Analytics (key 8FEXSNF1PEBHArYCsPXwZQ) is intentionally NOT here —
// it's owned by the GTM container (GTM-W5FBTHCQ). It used to also be hardcoded
// below, which double-loaded analytics.js ("already initialized" warning); the
// hardcoded copy was removed so GTM is the single owner. Don't re-add it here.
---

<!-- Google Tag Manager -->
<script is:inline>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != "dataLayer" ? "&l=" + l : "";
    j.async = true;
    j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, "script", "dataLayer", "GTM-W5FBTHCQ");
</script>
<!-- End Google Tag Manager -->

<!-- Typeform submit → dataLayer (fires a `typeform_submit` GTM event on form completion) -->
<script is:inline>
  (function () {
    if (window.__typeformListenerAttached) return;
    window.__typeformListenerAttached = true;
    window.addEventListener(
      "message",
      function (e) {
        try {
          if (!e || !e.data) return;
          if ((e.origin || "").indexOf("typeform.com") === -1) return;
          var d = e.data;
          if (typeof d === "string") {
            try {
              d = JSON.parse(d);
            } catch (_) {
              return;
            }
          }
          if (!d || typeof d !== "object") return;
          var t = (d.type || d.event || d.eventName || "").toString();
          if (/^form[-_]?submit$/i.test(t)) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: "typeform_submit",
              typeform_form_id: d.formId || (d.payload && d.payload.formId) || null,
              typeform_response_id:
                d.responseId || (d.payload && d.payload.responseId) || null,
            });
          }
        } catch (_) {}
      },
      false
    );
  })();
</script>
<!-- End Typeform submit → dataLayer -->

