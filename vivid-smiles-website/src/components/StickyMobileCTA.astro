---
/**
 * StickyMobileCTA — bottom-of-viewport CTA bar for paid landing pages, ≤600px only.
 *
 * Shown once the visitor scrolls a hero's height past the top, hidden again
 * when the target (#consult by default) is in view.
 *
 * Slot in `<LandingLayout>`:
 *   <StickyMobileCTA slot="stickyCTA" />
 */
interface Props {
  label?: string;
  href?: string;
  /** Element id that, when intersecting, hides the sticky bar. */
  hideWhenVisible?: string;
  /**
   * When set, the bar opens a Typeform popup with this form id
   * (data-tf-popup) instead of being a pure jump link. Requires the
   * Typeform embed.js to be present on the page — VirtualConsult loads it.
   */
  typeformPopupId?: string;
}

const {
  label = "Request your free consult",
  href = "#consult",
  hideWhenVisible = "consult",
  typeformPopupId,
} = Astro.props;

const popupAttrs = typeformPopupId
  ? { "data-tf-popup": typeformPopupId, "data-tf-transitive-search-params": "utm_source,utm_medium,utm_campaign,utm_term,utm_content,utm_ad,utm_adset,gclid,fbclid" }
  : {};
---

<div class="vs-lp-sticky" data-vs-sticky-cta data-hide-target={hideWhenVisible}>
  <a class="vs-lp-sticky-btn" href={href} {...popupAttrs}>
    <span>{label}</span>
    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-vs-sticky-cta]");
  if (bar) {
    let pastHero = false;
    let targetVisible = false;
    const apply = () => bar.classList.toggle("is-shown", pastHero && !targetVisible);

    // 50vh sentinel: once it leaves the top of the viewport, we're "past hero".
    const sentinel = document.createElement("span");
    Object.assign(sentinel.style, {
      position: "absolute",
      top: "50vh",
      left: "0",
      width: "1px",
      height: "1px",
      pointerEvents: "none",
    });
    document.body.appendChild(sentinel);
    new IntersectionObserver(([entry]) => {
      pastHero = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      apply();
    }).observe(sentinel);

    const target = document.getElementById(bar.dataset.hideTarget || "consult");
    if (target) {
      new IntersectionObserver(
        ([entry]) => { targetVisible = entry.isIntersecting; apply(); },
        { rootMargin: "0px 0px -20% 0px", threshold: 0.05 },
      ).observe(target);
    }
  }
</script>

<style>
  .vs-lp-sticky {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: 12px;
    z-index: 90;
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition:
      opacity 280ms ease,
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .vs-lp-sticky.is-shown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .vs-lp-sticky-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 100%;
    padding: 16px 24px;
    background: var(--vs-sage);
    color: #fff;
    text-decoration: none;
    border-radius: 999px;
    font-family: var(--vs-font-body);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.02em;
    box-shadow:
      0 10px 28px rgba(74, 92, 56, 0.32),
      0 2px 4px rgba(0, 0, 0, 0.06);
  }
  .vs-lp-sticky-btn i {
    font-size: 12px;
  }

  /* Mobile-only. Above 600px the in-page CTAs do the work. */
  @media (min-width: 601px) {
    .vs-lp-sticky { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-lp-sticky { transition: opacity 200ms linear; }
  }
</style>
