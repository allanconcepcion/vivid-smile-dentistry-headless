---
/**
 * MegaServices — Services mega-menu panel.
 *
 * Two-section grid:
 *   - .svc-breakouts (2 cols of .svc-col): items whose panel layout is
 *     "column" — an icon header, their child links, and a "view all" link.
 *   - .svc-standalones: items whose layout is "standalone", rendered with
 *     <StandaloneCard /> (which owns its global styles).
 *
 * Used by Nav.astro inside the .mega-wrap when "Services" is open.
 *
 * Content comes from the WordPress primary menu (Appearance -> Menus), so this
 * and MobileMenu read the SAME source. They used to hold duplicate hardcoded
 * link lists that had to be edited together by hand.
 */

import StandaloneCard from "../cards/StandaloneCard.astro";
import { getMenuBranch } from "../../lib/menus";

const branch = await getMenuBranch("/services/");
const groups = branch?.children ?? [];

const columns = groups.filter((g) => g.layout === "column");
const standalones = groups.filter((g) => g.layout.startsWith("standalone"));
---

<div class="mega mega-services-panel" role="region" aria-label="Services menu">
  <div class="mega-head">Treatments</div>

  <div class="mega-services">
    <div class="svc-breakouts">
      {columns.map((col) => (
        <div class="svc-col">
          <div class="col-head">
            <span class="col-icon">
              <i class={`fa-solid ${col.icon}`} aria-hidden="true"></i>
            </span>
            <div>
              <div class="col-title">{col.label}</div>
              <div class="col-sub">{col.eyebrow}</div>
            </div>
          </div>
          <ul>
            {col.children.map((l) => (
              <li>
                <a href={l.href}>
                  <span>{l.label}</span>
                  <span class="chev">→</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="col-all" href={col.href}>View all {col.label.toLowerCase()}</a>
        </div>
      ))}
    </div>

    <div class="svc-standalones">
      {standalones.map((card) => (
        <StandaloneCard
          kicker={card.eyebrow}
          title={card.label}
          href={card.href}
          emergency={card.layout === "standalone_emergency"}
        >
          {card.body}
          <i class={`fa-solid ${card.icon}`} slot="icon" aria-hidden="true"></i>
        </StandaloneCard>
      ))}
    </div>
  </div>
</div>

<style is:global>
  .mega-services-panel .mega-services {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 28px;
  }

  .mega-services-panel .svc-breakouts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .mega-services-panel .svc-standalones {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-left: 28px;
    border-left: 1px solid var(--vs-line);
  }
  .mega-services-panel .svc-standalones > * { flex: 1; }

  .mega-services-panel .svc-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mega-services-panel .col-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--vs-line);
  }
  .mega-services-panel .col-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(107, 122, 84, 0.1);
    color: var(--vs-sage);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .mega-services-panel .col-icon i { font-size: 17px; line-height: 1; }
  .mega-services-panel .col-title {
    font-family: var(--vs-font-display);
    font-size: 16px;
    font-weight: 500;
    color: var(--vs-ink);
    line-height: 1.2;
  }
  .mega-services-panel .col-sub {
    font-family: var(--vs-font-body);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--vs-muted);
    margin-top: 3px;
  }
  .mega-services-panel .svc-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .mega-services-panel .svc-col li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    margin: 0 -10px;
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--vs-ink-soft);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .mega-services-panel .svc-col li a:hover {
    background: rgba(107, 122, 84, 0.08);
    color: var(--vs-sage);
  }
  .mega-services-panel .svc-col li a .chev {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    font-family: var(--vs-font-display);
    font-size: 13px;
    color: var(--vs-sage);
  }
  .mega-services-panel .svc-col li a:hover .chev {
    opacity: 1;
    transform: translateX(0);
  }
  .mega-services-panel .col-all {
    margin-top: 4px;
    font-family: var(--vs-font-body);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--vs-sage);
    text-decoration: none;
    align-self: flex-start;
    transition: color 0.2s ease;
  }
  .mega-services-panel .col-all::after {
    content: " →";
    font-family: var(--vs-font-display);
  }
  .mega-services-panel .col-all:hover { color: var(--vs-sage-deep); }

  @media (max-width: 1100px) {
    .mega-services-panel .mega-services {
      grid-template-columns: 1fr;
    }
    .mega-services-panel .svc-standalones {
      padding-left: 0;
      border-left: 0;
      padding-top: 24px;
      border-top: 1px solid var(--vs-line);
      flex-direction: row;
    }
  }
</style>
