---
/**
 * MegaServices — Services mega-menu panel.
 *
 * Two-section grid:
 *   - .svc-breakouts (2 cols of .svc-col): Cosmetic Dentistry + Implant Dentistry,
 *     each with an icon header, sub-links, and a "view all" link. Takes ~2/3 width.
 *   - .svc-standalones: General Dentistry + Emergency Dentistry, rendered with
 *     <StandaloneCard /> (which owns its global styles). Takes ~1/3 width.
 *
 * Used by Nav.astro inside the .mega-wrap when "Services" is open.
 *
 * Parity: the `cosmetic.links` + `implant.links` + standalone hub hrefs
 * below must mirror the "services" section in MobileMenu.astro. No shared
 * data source — change links here AND there in the same edit.
 */

import StandaloneCard from "../cards/StandaloneCard.astro";

const cosmetic = {
  title: "Cosmetic Dentistry",
  sub: "Smile design",
  href: "/cosmetic-dentistry/",
  icon: "fa-wand-magic-sparkles",
  links: [
    { label: "Smile Makeover", href: "/cosmetic-dentistry/smile-makeover/" },
    { label: "Porcelain Veneers", href: "/cosmetic-dentistry/porcelain-veneers/" },
    { label: "Clear Aligners", href: "/cosmetic-dentistry/clear-aligners/" },
    { label: "Teeth Whitening", href: "/cosmetic-dentistry/teeth-whitening/" },
    { label: "Gum Contouring", href: "/cosmetic-dentistry/gum-contouring/" },
    { label: "Full Mouth Rehabilitation", href: "/cosmetic-dentistry/full-mouth-rehabilitation/" },
  ],
};

const implant = {
  title: "Implant Dentistry",
  sub: "Replace missing teeth",
  href: "/implant-dentistry/",
  icon: "fa-tooth",
  links: [
    { label: "Single Tooth Dental Implants", href: "/implant-dentistry/single-tooth-dental-implants/" },
    { label: "Full Mouth Dental Implants", href: "/implant-dentistry/full-mouth-dental-implants/" },
    { label: "All-on-4 Single Arch", href: "/implant-dentistry/all-on-4-single-arch/" },
    { label: "Bone Grafting", href: "/implant-dentistry/bone-grafting/" },
    { label: "Sinus Lift", href: "/implant-dentistry/sinus-lift/" },
  ],
};
---

<div class="mega mega-services-panel" role="region" aria-label="Services menu">
  <div class="mega-head">Treatments</div>

  <div class="mega-services">
    <div class="svc-breakouts">
      {[cosmetic, implant].map((col) => (
        <div class="svc-col">
          <div class="col-head">
            <span class="col-icon">
              <i class={`fa-solid ${col.icon}`} aria-hidden="true"></i>
            </span>
            <div>
              <div class="col-title">{col.title}</div>
              <div class="col-sub">{col.sub}</div>
            </div>
          </div>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>
                  <span>{l.label}</span>
                  <span class="chev">→</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="col-all" href={col.href}>View all {col.title.toLowerCase()}</a>
        </div>
      ))}
    </div>

    <div class="svc-standalones">
      <StandaloneCard
        kicker="Everyday care"
        title="General Dentistry"
        href="/general-dentistry/"
      >
        Cleanings, fillings, crowns and preventive care for every member of the family.
        <i class="fa-solid fa-shield-heart" slot="icon" aria-hidden="true"></i>
      </StandaloneCard>
      <StandaloneCard
        kicker="Same-day"
        title="Emergency Dentistry"
        href="/emergency-dentistry/"
        emergency
      >
        Toothache, broken tooth, lost crown? Call now &mdash; we hold same-day spots open.
        <i class="fa-solid fa-truck-medical" slot="icon" aria-hidden="true"></i>
      </StandaloneCard>
    </div>
  </div>
</div>

<style is:global>
  .mega-services-panel .mega-services {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 28px;
  }

  .mega-services-panel .svc-breakouts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .mega-services-panel .svc-standalones {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-left: 28px;
    border-left: 1px solid var(--vs-line);
  }
  .mega-services-panel .svc-standalones > * { flex: 1; }

  .mega-services-panel .svc-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mega-services-panel .col-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--vs-line);
  }
  .mega-services-panel .col-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(107, 122, 84, 0.1);
    color: var(--vs-sage);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .mega-services-panel .col-icon i { font-size: 17px; line-height: 1; }
  .mega-services-panel .col-title {
    font-family: var(--vs-font-display);
    font-size: 16px;
    font-weight: 500;
    color: var(--vs-ink);
    line-height: 1.2;
  }
  .mega-services-panel .col-sub {
    font-family: var(--vs-font-body);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--vs-muted);
    margin-top: 3px;
  }
  .mega-services-panel .svc-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .mega-services-panel .svc-col li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    margin: 0 -10px;
    border-radius: 8px;
    font-size: 13.5px;
    color: var(--vs-ink-soft);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .mega-services-panel .svc-col li a:hover {
    background: rgba(107, 122, 84, 0.08);
    color: var(--vs-sage);
  }
  .mega-services-panel .svc-col li a .chev {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    font-family: var(--vs-font-display);
    font-size: 13px;
    color: var(--vs-sage);
  }
  .mega-services-panel .svc-col li a:hover .chev {
    opacity: 1;
    transform: translateX(0);
  }
  .mega-services-panel .col-all {
    margin-top: 4px;
    font-family: var(--vs-font-body);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--vs-sage);
    text-decoration: none;
    align-self: flex-start;
    transition: color 0.2s ease;
  }
  .mega-services-panel .col-all::after {
    content: " →";
    font-family: var(--vs-font-display);
  }
  .mega-services-panel .col-all:hover { color: var(--vs-sage-deep); }

  @media (max-width: 1100px) {
    .mega-services-panel .mega-services {
      grid-template-columns: 1fr;
    }
    .mega-services-panel .svc-standalones {
      padding-left: 0;
      border-left: 0;
      padding-top: 24px;
      border-top: 1px solid var(--vs-line);
      flex-direction: row;
    }
  }
</style>
