# WordPress GraphQL endpoint used at BUILD TIME to source content collections.
#
# Local development — start the bundled WordPress first:
#   cd ../cms && npm install && npm start
WP_GRAPHQL_ENDPOINT="http://localhost:8888/graphql"

# Production (set in the Vercel project's environment variables, not here):
# WP_GRAPHQL_ENDPOINT="https://cms.vividsmilesdentistry.com/graphql"
